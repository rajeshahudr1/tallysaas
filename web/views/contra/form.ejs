<%
/* ─────────────────────────────────────────────────────────────
 * views/contra/form.ejs — TRANSACTIONS · Create Contra Voucher.
 * Route: GET /contra/create.
 *
 * A Contra has NO items and NO totals panel — it is just a cash⇄bank
 * transfer, four fields: Date, From (Cr ledger), To (Dr ledger), Amount.
 * Borrows only the full-bleed header bar and the searchable-combobox
 * behaviour from the newer voucher screens (see delivery-notes/create.ejs) —
 * the heavy items-grid form is NOT the shape for this screen; journals/
 * form.ejs (a two-ledger Dr/Cr entry, no items) is the right shape.
 *
 * Expected locals (routes/web.js → res.render):
 *   ledgers [{id,name,parent}] — cash + bank ledgers only (both fields draw
 *            from this SAME list; the JS below stops the same ledger being
 *            picked on both sides).
 * ─────────────────────────────────────────────────────────── */
var _ledgers = (typeof ledgers !== 'undefined' && ledgers) ? ledgers : [];
var _hasLedgers = _ledgers.length > 0;
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) { return { id: l.id, name: l.name, parent: l.parent || '' }; }));
var _today = new Date().toISOString().slice(0, 10);

/* EDIT MODE — one form serves create and edit. */
var _edit    = (typeof editContra !== 'undefined' && editContra) ? editContra : null;
var _dateVal = _edit ? ymd(_edit.journal_date) : _today;
%>

<form id="contra-form" class="card mb-3 q-voucher" method="post" action="<%= _edit ? ('/contra/' + _edit.id + '/update') : '/contra' %>" autocomplete="off" novalidate>

    <div class="voucher-head">
        <a class="q-back" href="/contra" title="Back to Contra" aria-label="Back to Contra">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <span>Create Contra Voucher</span>
        <a class="q-list-btn" href="/contra">
            <i class="fa-solid fa-list-ul me-1"></i>View Contra
        </a>
    </div>

    <div class="inv-body">
        <% if (!_hasLedgers) { %>
        <div class="alert alert-warning" role="alert" style="margin-bottom:16px">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            No cash or bank ledgers synced yet — sync your Tally company's Cash/Bank ledgers before creating a Contra voucher.
        </div>
        <% } %>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label" for="ct-date">Date<span class="req">*</span></label>
                <input type="date" class="form-control" id="ct-date" name="journal_date" value="<%= _dateVal %>" required>
            </div>

            <div class="form-group">
                <label class="form-label" for="ct-from">From (Cr)<span class="req">*</span></label>
                <div class="li-prod-cell">
                    <input type="text" class="form-control li-product-search" id="ct-from" name="cr_ledger" value="<%= _edit ? (_edit.cr_ledger || '') : '' %>"
                           placeholder="<%= _hasLedgers ? 'Search cash/bank ledger…' : 'No cash or bank ledgers synced yet' %>"
                           autocomplete="off" required <%= _hasLedgers ? '' : 'disabled' %>>
                    <div class="li-prod-menu" id="ct-from-menu" hidden></div>
                </div>
                <div class="form-hint">Ledger the money leaves.</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="ct-to">To (Dr)<span class="req">*</span></label>
                <div class="li-prod-cell">
                    <input type="text" class="form-control li-product-search" id="ct-to" name="dr_ledger" value="<%= _edit ? (_edit.dr_ledger || '') : '' %>"
                           placeholder="<%= _hasLedgers ? 'Search cash/bank ledger…' : 'No cash or bank ledgers synced yet' %>"
                           autocomplete="off" required disabled>
                    <div class="li-prod-menu" id="ct-to-menu" hidden></div>
                </div>
                <div class="form-hint">Ledger the money lands in.</div>
            </div>

            <div class="form-group">
                <label class="form-label" for="ct-amount">Amount<span class="req">*</span></label>
                <input type="number" class="form-control" id="ct-amount" name="amount" min="0" step="0.01" placeholder="0.00" value="<%= _edit ? (_edit.amount || '') : '' %>" required<%= _edit ? '' : ' disabled' %>>
            </div>
        </div>

        <hr class="form-divider">
        <div class="row g-4">
            <div class="col-12">
                <label class="form-label" for="ct-narration">Narration</label>
                <textarea class="form-control" id="ct-narration" name="narration" rows="2" maxlength="300"
                          placeholder="Being…" data-counter="ct-narration-count"><%= _edit ? (_edit.narration || "") : "" %></textarea>
                <div class="char-counter"><span id="ct-narration-count">0/300</span></div>
            </div>
        </div>
    </div>

    <div class="form-card-footer">
        <a class="btn btn-light" href="/contra">Cancel</a>
        <button type="submit" class="btn btn-primary" id="ct-submit" <%= _hasLedgers ? '' : 'disabled' %>>
            <i class="fa-solid fa-cloud-arrow-up me-1"></i><%= _edit ? 'Update Voucher' : 'Create Voucher' %>
        </button>
    </div>
</form>

<script>
    window.CONTRA_LEDGERS = <%- _ledgersJson %>;
</script>
<script src="/js/contra.js"></script>

<style>
    /* Same searchable-combobox widget as the other voucher screens (see
       delivery-notes/create.ejs) — kept local to this page. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #E9EDF3); border-radius: 12px;
        box-shadow: 0 8px 24px rgba(16,24,40,.10); padding: 4px;
    }
    .li-prod-item { padding: 7px 10px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #EAF1FE; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; flex: 0 0 auto; text-align: right; }

    .q-back {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 6px; margin-right: 10px;
        color: #fff; background: rgba(255,255,255,.15); vertical-align: middle;
    }
    .q-back:hover { background: rgba(255,255,255,.28); color: #fff; }

    .q-voucher { overflow: visible; }
    .voucher-head {
        display: flex; align-items: center;
        margin: -24px -28px 16px;
        border-radius: 0;
    }
    .voucher-head span { flex: 0 0 auto; }
    @media (max-width: 767.98px) {
        .voucher-head { margin: -20px -16px 16px; }
    }

    .q-list-btn {
        margin-left: auto;
        display: inline-flex; align-items: center;
        padding: 6px 14px; border-radius: 6px;
        font-size: 12.5px; font-weight: 600;
        color: #fff; background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
    }
    .q-list-btn:hover { background: rgba(255,255,255,.28); color: #fff; }
</style>
