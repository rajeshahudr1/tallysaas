<%
/* ─────────────────────────────────────────────────────────────
 * views/settings/index.ejs — SETTINGS · Settings.
 * Route: GET /settings  ·  activeMenu: 'settings'.
 *
 * One tabbed form (reuses the FormCard tab nav) with 5 fully-built
 * panes: General, Tally Sync, Invoice & Tax, Notifications, Branding.
 * Values are pre-filled with the current (mock) configuration.
 *
 * Expected locals (routes/web.js → res.render):
 *   financialYears / gstRates / paymentTerms  — select option sources
 * ─────────────────────────────────────────────────────────── */

var _fy    = (typeof financialYears !== 'undefined' && financialYears) ? financialYears : [];
var _gst   = (typeof gstRates !== 'undefined' && gstRates) ? gstRates : [];
var _terms = (typeof paymentTerms !== 'undefined' && paymentTerms) ? paymentTerms : [];

/* Real data from GET /settings: company profile (companies row) + the
 * key/value settings bag. _co/_s drive the prefills; the form posts
 * company[...] → company profile, settings[...] → the bag. */
var _co = (typeof companyProfile  !== 'undefined' && companyProfile)  ? companyProfile  : {};
var _s  = (typeof companySettings !== 'undefined' && companySettings) ? companySettings : {};
function _cv(k) { return (_co[k] != null) ? _co[k] : ''; }
function _sv(k, d) { return (_s[k] != null && _s[k] !== '') ? _s[k] : (d != null ? d : ''); }
function _sChk(k, dflt) { var v = _s[k]; if (v === undefined) return dflt ? 'checked' : ''; return (v === true || v === 'true' || v === 'on' || v === '1') ? 'checked' : ''; }

/* License-scoped SYNC flags (auto_update / sync_push_enabled / sync_pull_enabled
 * / sync_enabled) — prefill the Tally Sync tab's Sync Settings switches. These do
 * NOT live in the settings bag; they ride inside settings[...] on submit and the
 * api routes them to the license. Default ON when absent. */
var _sync = (typeof syncFlags !== 'undefined' && syncFlags) ? syncFlags : {};
function _syncChk(k) { return _sync[k] !== false ? 'checked' : ''; }

/* Selective AUTO-sync modules: the catalog [{key,label}] + the currently-
 * selected push/pull key sets. When Auto push/pull is ON, ONLY these modules
 * move. Rendered as a checkbox popup (one per direction). Default = ALL. */
var _syncMods    = (typeof syncModules !== 'undefined' && Array.isArray(syncModules)) ? syncModules : [];
var _pushModsSel = (typeof syncPushModules !== 'undefined' && Array.isArray(syncPushModules)) ? syncPushModules : _syncMods.map(function (m) { return m.key; });
var _pullModsSel = (typeof syncPullModules !== 'undefined' && Array.isArray(syncPullModules)) ? syncPullModules : _syncMods.map(function (m) { return m.key; });
function _modsSummary(sel) {
    if (!_syncMods.length) return 'All modules';
    if (!sel || !sel.length) return 'None selected';
    if (sel.length === _syncMods.length) return 'All modules';
    return sel.length + ' of ' + _syncMods.length + ' modules';
}

function _optsSel(list, selected) {
    var html = '';
    (list || []).forEach(function (v) {
        html += '<option value="' + v + '"' + (v === selected ? ' selected' : '') + '>' + v + '</option>';
    });
    return html;
}

var settingsTabs = [
    { id: 'general', label: 'General',       icon: 'fa-sliders',           active: true },
    { id: 'tally',   label: 'Tally Sync',    icon: 'fa-rotate'                          },
    { id: 'invoice', label: 'Invoice & Tax', icon: 'fa-file-invoice'                    },
    { id: 'notify',  label: 'Notifications', icon: 'fa-bell'                            },
    { id: 'brand',   label: 'Branding',      icon: 'fa-palette'                         },
];

// A reusable notification toggle row (label + description + switch).
var _notifs = [
    { id: 'n-inv',   label: 'New invoice created',     desc: 'Email the customer when an invoice is generated.', on: true  },
    { id: 'n-pay',   label: 'Payment received',        desc: 'Notify the team when a receipt is recorded.',      on: true  },
    { id: 'n-sync',  label: 'Sync failure',            desc: 'Alert admins when a Tally sync fails.',            on: true  },
    { id: 'n-stock', label: 'Low stock alert',         desc: 'Warn when an item drops below its reorder level.', on: true  },
    { id: 'n-sms',   label: 'SMS on invoice',          desc: 'Send the customer an SMS with the invoice link.',  on: false },
    { id: 'n-daily', label: 'Daily summary email',     desc: 'A daily digest of sales, payments and sync.',      on: false },
];

// Super Admin has no company, so there is nothing to save here — drop the
// Save/Reset actions and (below) show a clean empty-state instead of the tabs.
var _isSuper = (typeof isSuperAdmin !== 'undefined') && isSuperAdmin;
var headActions = _isSuper ? '' :
    '<button type="reset" form="settings-form" class="btn btn-light">' +
        '<i class="fa-solid fa-rotate-left me-1"></i>Reset' +
    '</button>' +
    '<button type="submit" form="settings-form" class="btn btn-primary">' +
        '<i class="fa-solid fa-floppy-disk me-1"></i>Save Settings' +
    '</button>';
%>

<%- include('../partials/page-head', {
    title: 'Settings',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'Settings' },
    ],
    actions: headActions,
}) %>

<% if (_isSuper) { %>
<%# Super Admin — the company-only settings (profile, tax, sync, branding) don't
    apply to a platform operator, so show a clean empty-state, not blank tabs. %>
<div class="card" style="padding:44px 24px; text-align:center; color:#64748b">
    <i class="fa-solid fa-building-circle-xmark" style="font-size:36px; color:#94a3b8; display:block; margin-bottom:14px"></i>
    <h3 style="font-size:17px; color:#334155; margin:0 0 8px">No company settings here</h3>
    <p style="font-size:13.5px; max-width:560px; margin:0 auto; line-height:1.6">
        These settings (company profile, tax, sync, branding) belong to a tenant company —
        as the platform operator you don't own one. Manage
        <a href="/licenses">Licenses</a>, or per-license config in
        <a href="/gps-settings">GPS Tracking</a> and <a href="/einvoice-gsp">e-Invoice GSP</a>.
    </p>
</div>
<% } else { %>

<form id="settings-form" class="card form-card" method="post" action="/settings" autocomplete="off" novalidate>

    <%- include('../partials/form-card', { tabs: settingsTabs }) %>

    <div class="tab-content form-card-body">

        <!-- ════ GENERAL ════ -->
        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
            <h2 class="form-section-title">Company Profile</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="set-co-name">Company Name</label>
                    <input type="text" class="form-control" id="set-co-name" name="company[name]" value="<%= _cv('name') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-co-email">Email</label>
                    <input type="email" class="form-control" id="set-co-email" name="company[email]" value="<%= _cv('email') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-co-mobile">Mobile</label>
                    <input type="tel" class="form-control" id="set-co-mobile" name="company[mobile]" value="<%= _cv('mobile') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-co-gst">GST Number</label>
                    <input type="text" class="form-control text-uppercase" id="set-co-gst" name="company[gst_number]" value="<%= _cv('gst_number') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-co-pan">PAN Number</label>
                    <input type="text" class="form-control text-uppercase" id="set-co-pan" name="company[pan_number]" value="<%= _cv('pan_number') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-fy">Financial Year</label>
                    <select class="form-select" id="set-fy" name="company[financial_year]"><%- _optsSel(_fy, _cv('financial_year') || '2024-2025') %></select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-currency">Currency</label>
                    <% var _cur = _sv('currency', 'INR — Indian Rupee (₹)'); %>
                    <select class="form-select" id="set-currency" name="settings[currency]">
                        <option <%= _cur.indexOf('INR') === 0 ? 'selected' : '' %>>INR — Indian Rupee (₹)</option>
                        <option <%= _cur.indexOf('USD') === 0 ? 'selected' : '' %>>USD — US Dollar ($)</option>
                        <option <%= _cur.indexOf('AED') === 0 ? 'selected' : '' %>>AED — UAE Dirham (د.إ)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-tz">Timezone</label>
                    <% var _tz = _sv('timezone', 'Asia/Kolkata (IST)'); %>
                    <select class="form-select" id="set-tz" name="settings[timezone]">
                        <option <%= _tz.indexOf('Kolkata') > -1 ? 'selected' : '' %>>Asia/Kolkata (IST)</option>
                        <option <%= _tz.indexOf('Dubai') > -1 ? 'selected' : '' %>>Asia/Dubai (GST)</option>
                        <option <%= _tz === 'UTC' ? 'selected' : '' %>>UTC</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-dateformat">Date Format</label>
                    <% var _df = _sv('date_format', 'DD/MM/YYYY'); %>
                    <select class="form-select" id="set-dateformat" name="settings[date_format]">
                        <option <%= _df === 'DD/MM/YYYY' ? 'selected' : '' %>>DD/MM/YYYY</option>
                        <option <%= _df === 'MM/DD/YYYY' ? 'selected' : '' %>>MM/DD/YYYY</option>
                        <option <%= _df === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD</option>
                    </select>
                </div>
            </div>
            <hr class="form-divider">
            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label" for="set-address">Registered Address</label>
                    <textarea class="form-control" id="set-address" name="company[address]" rows="3" maxlength="300"
                              data-counter="set-address-count"><%= _cv('address') %></textarea>
                    <div class="char-counter"><span id="set-address-count">0/300</span></div>
                </div>
            </div>
        </div>

        <!-- ════ TALLY SYNC ════ -->
        <div class="tab-pane fade" id="tally" role="tabpanel" aria-labelledby="tally-tab">
            <div class="alert alert-light d-flex align-items-center justify-content-between" role="alert"
                 style="border:1px solid var(--border);border-radius:12px">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-info text-primary"></i>
                    <span style="font-size:13px">Live agent connection status (heartbeat, version, last sync) is on the Sync Dashboard.</span>
                </div>
                <a href="/sync-dashboard" class="btn btn-light btn-sm">
                    <i class="fa-solid fa-gauge-high me-1"></i>Open Sync Dashboard
                </a>
            </div>
            <h2 class="form-section-title">Sync Configuration</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="set-tally-url">Tally Server URL</label>
                    <input type="text" class="form-control" id="set-tally-url" name="settings[tally_url]" value="<%= _sv('tally_url', 'http://localhost:9000') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-tally-co">Tally Company Name</label>
                    <input type="text" class="form-control" id="set-tally-co" name="settings[tally_company]" value="<%= _sv('tally_company', '') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-retry">Retry Attempts</label>
                    <input type="number" class="form-control" id="set-retry" name="settings[retry_attempts]" value="<%= _sv('retry_attempts', '3') %>" min="0" max="10">
                </div>
            </div>

            <hr class="form-divider">

            <!-- ── Sync Settings (the LIVE per-license switches that drive the
                 agent). Each switch posts settings[...]; the api routes these
                 keys to the license row, NOT the settings bag. A hidden empty
                 companion before each checkbox makes an unchecked box submit a
                 falsy value (so turning a switch OFF actually persists OFF). -->
            <h2 class="form-section-title">Sync Settings</h2>
            <p class="form-hint mb-3">
                These control the local Sync Agent. The Sync Dashboard shows their status (read-only);
                change them here.
            </p>

            <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px solid var(--border)">
                <div>
                    <div style="font-weight:600;font-size:14px">Auto-sync (master)</div>
                    <div class="form-hint mb-0">When OFF, nothing syncs automatically until you trigger a manual sync. Push &amp; pull below only apply when this is ON.</div>
                </div>
                <div class="form-check form-switch mb-0">
                    <input type="hidden" name="settings[sync_enabled]" value="">
                    <input class="form-check-input" type="checkbox" role="switch" id="set-sync-enabled" name="settings[sync_enabled]" value="on" <%= _syncChk('sync_enabled') %>>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px solid var(--border)">
                <div>
                    <div style="font-weight:600;font-size:14px">Auto push (Cloud &rarr; Tally)</div>
                    <div class="form-hint mb-0">Automatically push cloud changes to Tally. Only applies while Auto-sync is ON.</div>
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#pushModulesModal">
                            <i class="fa-solid fa-list-check me-1"></i>Choose modules
                        </button>
                        <span class="form-hint mb-0" id="push-mods-summary"><%= _modsSummary(_pushModsSel) %></span>
                    </div>
                </div>
                <div class="form-check form-switch mb-0">
                    <input type="hidden" name="settings[sync_push_enabled]" value="">
                    <input class="form-check-input" type="checkbox" role="switch" id="set-sync-push" name="settings[sync_push_enabled]" value="on" <%= _syncChk('sync_push_enabled') %>>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px solid var(--border)">
                <div>
                    <div style="font-weight:600;font-size:14px">Auto pull (Tally &rarr; Cloud)</div>
                    <div class="form-hint mb-0">Automatically pull Tally changes into the cloud. Only applies while Auto-sync is ON.</div>
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#pullModulesModal">
                            <i class="fa-solid fa-list-check me-1"></i>Choose modules
                        </button>
                        <span class="form-hint mb-0" id="pull-mods-summary"><%= _modsSummary(_pullModsSel) %></span>
                    </div>
                </div>
                <div class="form-check form-switch mb-0">
                    <input type="hidden" name="settings[sync_pull_enabled]" value="">
                    <input class="form-check-input" type="checkbox" role="switch" id="set-sync-pull" name="settings[sync_pull_enabled]" value="on" <%= _syncChk('sync_pull_enabled') %>>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px solid var(--border)">
                <div>
                    <div style="font-weight:600;font-size:14px">Auto-update agent</div>
                    <div class="form-hint mb-0">Let the Sync Agent install new versions automatically. A mandatory update is applied even when this is OFF.</div>
                </div>
                <div class="form-check form-switch mb-0">
                    <input type="hidden" name="settings[auto_update]" value="">
                    <input class="form-check-input" type="checkbox" role="switch" id="set-auto-update" name="settings[auto_update]" value="on" <%= _syncChk('auto_update') %>>
                </div>
            </div>
        </div>

        <!-- ════ INVOICE & TAX ════ -->
        <div class="tab-pane fade" id="invoice" role="tabpanel" aria-labelledby="invoice-tab">
            <h2 class="form-section-title">Numbering & Tax Defaults</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="set-inv-prefix">Sales Invoice Prefix</label>
                    <input type="text" class="form-control" id="set-inv-prefix" name="settings[inv_prefix]" value="<%= _sv('inv_prefix', 'INV-2024-') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-inv-next">Next Invoice Number</label>
                    <input type="number" class="form-control" id="set-inv-next" name="settings[inv_next]" value="<%= _sv('inv_next', '157') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-pur-prefix">Purchase Bill Prefix</label>
                    <input type="text" class="form-control" id="set-pur-prefix" name="settings[pur_prefix]" value="<%= _sv('pur_prefix', 'PUR-2024-') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-default-gst">Default GST Rate</label>
                    <select class="form-select" id="set-default-gst" name="settings[default_gst]"><%- _optsSel(_gst, _sv('default_gst', '18%')) %></select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-default-terms">Default Payment Terms</label>
                    <select class="form-select" id="set-default-terms" name="settings[default_terms]"><%- _optsSel(_terms, _sv('default_terms', '30 Days')) %></select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-tax-type">Default Tax Type</label>
                    <% var _tt = _sv('tax_type', 'GST (CGST + SGST)'); %>
                    <select class="form-select" id="set-tax-type" name="settings[tax_type]">
                        <option <%= _tt.indexOf('GST (') === 0 ? 'selected' : '' %>>GST (CGST + SGST)</option>
                        <option <%= _tt.indexOf('IGST') === 0 ? 'selected' : '' %>>IGST (Inter-state)</option>
                    </select>
                </div>
            </div>
            <hr class="form-divider">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="set-roundoff" name="settings[round_off]" <%= _sChk('round_off', true) %>>
                <label class="form-check-label" for="set-roundoff">Auto round-off invoice totals</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="set-showhsn" name="settings[show_hsn]" <%= _sChk('show_hsn', true) %>>
                <label class="form-check-label" for="set-showhsn">Show HSN/SAC code on invoices</label>
            </div>
            <hr class="form-divider">
            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label" for="set-inv-terms">Invoice Terms &amp; Conditions</label>
                    <textarea class="form-control" id="set-inv-terms" name="settings[inv_terms]" rows="3" maxlength="500"
                              data-counter="set-terms-count"><%= _sv('inv_terms', 'Goods once sold will not be taken back. Subject to Ahmedabad jurisdiction.') %></textarea>
                    <div class="char-counter"><span id="set-terms-count">0/500</span></div>
                </div>
            </div>
        </div>

        <!-- ════ NOTIFICATIONS ════ -->
        <div class="tab-pane fade" id="notify" role="tabpanel" aria-labelledby="notify-tab">
            <h2 class="form-section-title">Email &amp; SMS Alerts</h2>
            <p class="form-hint mb-3">Your preferences are saved. Message delivery is coming soon.</p>
            <% _notifs.forEach(function (n) { %>
                <div class="d-flex align-items-center justify-content-between py-3" style="border-bottom:1px solid var(--border)">
                    <div>
                        <div style="font-weight:600;font-size:14px"><%= n.label %></div>
                        <div class="form-hint mb-0"><%= n.desc %></div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="<%= n.id %>" name="settings[<%= n.id %>]" <%= _sChk(n.id, n.on) %>>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- ════ BRANDING ════ -->
        <div class="tab-pane fade" id="brand" role="tabpanel" aria-labelledby="brand-tab">
            <h2 class="form-section-title">Branding</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="set-app-name">App Display Name</label>
                    <input type="text" class="form-control" id="set-app-name" name="settings[app_name]" value="<%= _sv('app_name', (typeof brand !== 'undefined' && brand) ? brand.name : 'Tally Cloud Sync') %>">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-logo">Logo</label>
                    <input type="file" class="form-control" id="set-logo" accept="image/*">
                    <div class="form-hint">Logo upload coming soon.</div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-primary">Primary Color</label>
                    <input type="color" class="form-control form-control-color" id="set-primary" name="settings[primary_color]" value="<%= _sv('primary_color', '#2563EB') %>" style="height:42px">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-accent">Accent Color</label>
                    <input type="color" class="form-control form-control-color" id="set-accent" name="settings[accent_color]" value="<%= _sv('accent_color', '#6D28D9') %>" style="height:42px">
                </div>
                <div class="form-group">
                    <label class="form-label" for="set-theme">Theme</label>
                    <% var _th = _sv('theme', 'Light'); %>
                    <select class="form-select" id="set-theme" name="settings[theme]">
                        <option <%= _th === 'Light' ? 'selected' : '' %>>Light</option>
                        <option <%= _th.indexOf('Dark') === 0 ? 'selected' : '' %>>Dark (coming soon)</option>
                    </select>
                </div>
            </div>
        </div>

    </div><!-- /.tab-content -->

    <div class="form-card-footer">
        <button type="reset" class="btn btn-light">Reset</button>
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk me-1"></i>Save Settings
        </button>
    </div>

</form>

<%# ── Selective auto-sync MODULE pickers. Live in Bootstrap modals OUTSIDE the
     settings <form> so their checkboxes never ride the profile save; they PATCH
     /sync-direction directly via fetch. One modal per direction. ── %>
<% function _modRows(idPrefix, sel) {
     var html = '';
     _syncMods.forEach(function (m) {
         var checked = (sel || []).indexOf(m.key) !== -1 ? ' checked' : '';
         html += '<label class="d-flex align-items-center gap-2 py-2" style="border-bottom:1px solid var(--border);cursor:pointer">'
              +  '<input class="form-check-input mt-0 ' + idPrefix + '-mod" type="checkbox" value="' + m.key + '"' + checked + '>'
              +  '<span style="font-size:14px">' + m.label + '</span></label>';
     });
     return html;
 } %>

<div class="modal fade" id="pushModulesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fa-solid fa-cloud-arrow-up me-2"></i>Auto push modules (Cloud &rarr; Tally)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="form-hint">When Auto push is ON, only the checked modules are pushed to Tally.</p>
        <div class="d-flex justify-content-between mb-2">
          <button type="button" class="btn btn-link btn-sm p-0" data-select-all="push">Select all</button>
          <button type="button" class="btn btn-link btn-sm p-0" data-select-none="push">Clear all</button>
        </div>
        <div id="push-mods-list"><%- _modRows('push', _pushModsSel) %></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="push-mods-save">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="pullModulesModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fa-solid fa-cloud-arrow-down me-2"></i>Auto pull modules (Tally &rarr; Cloud)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="form-hint">When Auto pull is ON, only the checked modules are pulled from Tally.</p>
        <div class="d-flex justify-content-between mb-2">
          <button type="button" class="btn btn-link btn-sm p-0" data-select-all="pull">Select all</button>
          <button type="button" class="btn btn-link btn-sm p-0" data-select-none="pull">Clear all</button>
        </div>
        <div id="pull-mods-list"><%- _modRows('pull', _pullModsSel) %></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="pull-mods-save">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
    var TOTAL = <%= _syncMods.length %>;
    function summarise(n) {
        if (!TOTAL) return 'All modules';
        if (n === 0) return 'None selected';
        if (n === TOTAL) return 'All modules';
        return n + ' of ' + TOTAL + ' modules';
    }
    // Self-contained mini-toast (no global helper exists in this layout).
    function notify(msg, ok) {
        var t = document.createElement('div');
        t.textContent = msg;
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:1080;padding:12px 18px;'
            + 'border-radius:8px;color:#fff;font-size:14px;box-shadow:0 6px 24px rgba(0,0,0,.25);'
            + 'background:' + (ok ? '#16a34a' : '#dc2626');
        document.body.appendChild(t);
        setTimeout(function () { t.style.transition = 'opacity .4s'; t.style.opacity = '0'; }, 2600);
        setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 3100);
    }
    function boxes(dir) { return Array.prototype.slice.call(document.querySelectorAll('.' + dir + '-mod')); }
    // Select all / clear all
    document.querySelectorAll('[data-select-all]').forEach(function (b) {
        b.addEventListener('click', function () { boxes(b.getAttribute('data-select-all')).forEach(function (c) { c.checked = true; }); });
    });
    document.querySelectorAll('[data-select-none]').forEach(function (b) {
        b.addEventListener('click', function () { boxes(b.getAttribute('data-select-none')).forEach(function (c) { c.checked = false; }); });
    });
    function wireSave(dir, field, summaryId, saveBtnId, modalId) {
        var btn = document.getElementById(saveBtnId);
        if (!btn) return;
        btn.addEventListener('click', function () {
            var keys = boxes(dir).filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
            btn.disabled = true;
            // urlencoded (the web BFF parses forms, not JSON). The /sync-direction
            // route splits a comma-joined value back into an array; an empty value
            // means "none selected".
            var body = new URLSearchParams();
            body.set(field, keys.join(','));
            fetch('/sync-direction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin',
                body: body.toString(),
            }).then(function (r) { return r.json(); }).then(function (res) {
                btn.disabled = false;
                var sm = document.getElementById(summaryId);
                if (sm) sm.textContent = summarise(keys.length);
                var m = window.bootstrap && bootstrap.Modal.getInstance(document.getElementById(modalId));
                if (m) m.hide();
                notify((res && res.msg) || 'Saved.', !!(res && res.ok));
            }).catch(function () {
                btn.disabled = false;
                notify('Could not reach the server.', false);
            });
        });
    }
    wireSave('push', 'push_modules', 'push-mods-summary', 'push-mods-save', 'pushModulesModal');
    wireSave('pull', 'pull_modules', 'pull-mods-summary', 'pull-mods-save', 'pullModulesModal');
})();
</script>
<% } %>
