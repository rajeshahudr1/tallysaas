<%
/* ─────────────────────────────────────────────────────────────
 * views/delivery-notes/create.ejs — TRANSACTIONS · Create Delivery Note Voucher.
 * Route: GET /delivery-notes/create  ·  activeMenu: 'dely-notes'.
 *
 * Own copy of views/sales-orders/create.ejs — same layout/behaviour (full-bleed
 * header, Party/Ledger/No row, Date row, items grid, two collapsible strips,
 * right-hand totals panel) with a `dn-` DOM-hook prefix instead of `so-`, and
 * a second header row of Date + Dispatch Date + Against Sales Order (optional,
 * searchable — open orders only). Task 4's /js/delivery-note.js binds to these
 * ids/classes verbatim.
 *
 * Expected locals (routes/web.js → res.render):
 *   customerOptions / locationOptions / salesPersonOptions — header selects
 *   invoiceProducts [{id,name,hsn,unit,rate,gst,stock}]    — line-item picker
 *   salesLedgerOptions / ledgerGroupOptions / gstRegistrationTypes
 *   salesOrderOptions [{id,order_no,customer}]                — Against Order
 *   nextDeliveryNoteNo string                                 — read-only no.
 * ─────────────────────────────────────────────────────────── */

var _custs    = (typeof customerOptions !== 'undefined' && customerOptions) ? customerOptions : [];
var _locs     = (typeof locationOptions !== 'undefined' && locationOptions) ? locationOptions : [];
// Tally's per-tier rate cards. Absent for a company that uses none, in
// which case the picker is not rendered at all rather than shown empty.
var _priceLevels = (typeof priceLevelOptions !== 'undefined' && priceLevelOptions) ? priceLevelOptions : [];
var _sps      = (typeof salesPersonOptions !== 'undefined' && salesPersonOptions) ? salesPersonOptions : [];
var _products = (typeof invoiceProducts !== 'undefined' && invoiceProducts) ? invoiceProducts : [];
var _ledgers  = (typeof salesLedgerOptions !== 'undefined' && salesLedgerOptions) ? salesLedgerOptions : [];
var _dnNo     = (typeof nextDeliveryNoteNo !== 'undefined' && nextDeliveryNoteNo) ? nextDeliveryNoteNo : '';
var _ncLedgerGroups = (typeof ledgerGroupOptions !== 'undefined' && ledgerGroupOptions) ? ledgerGroupOptions : [];
var _ncGstRegTypes  = (typeof gstRegistrationTypes !== 'undefined' && gstRegistrationTypes) ? gstRegistrationTypes : [];
var _orders   = (typeof salesOrderOptions !== 'undefined' && salesOrderOptions) ? salesOrderOptions : [];

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* Products as a JS array for the searchable line-item picker. */

/* The Tally GODOWNS among the locations — stock physically sits in one, and a
   voucher line needs it. When the company has exactly one (the common case,
   "Main Location"), every new line starts there rather than making the user
   pick the only option there is. */
var _godowns = _locs.filter(function (l) { return l.is_tally_godown; });
var _defaultGodown = _godowns.length === 1 ? _godowns[0].name : '';

/* The units actually in use on this company's items — suggestions for the
   editable Units box, so the common answers are one keystroke away. */
var _units = (function () {
    var seen = {};
    _products.forEach(function (p) { if (p.unit) seen[p.unit] = true; });
    return Object.keys(seen).sort();
})();

var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : null) };
}));

/* Party + sales-ledger options for the header comboboxes (auto-advance flow). */
var _partiesJson = JSON.stringify(_custs.map(function (c) {
    return {
        id: c.id, name: c.name,
        balance: (c.closing_balance == null ? null : c.closing_balance),
        gst_number: c.gst_number || '', gst_registration_type: c.gst_registration_type || '',
        billing_address: c.billing_address || c.address || '', country: c.country || '',
        state: c.state || '', pincode: c.pincode || '',
    };
}));
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) {
    return {
        id: l.id, name: l.name, parent: l.parent || '',
        tax_type: l.tax_type || '', tax_classification: l.tax_classification || '',
    };
}));

/* Open sales orders for the "Against Sales Order" searchable combobox. */
var _ordersJson = JSON.stringify(_orders.map(function (o) { return { id: o.id, order_no: o.order_no, customer: o.customer || '' }; }));

var _today = new Date().toISOString().slice(0, 10);

/* EDIT MODE — see quotations/create.ejs; one screen serves create and edit. */
var _edit      = (typeof editNote !== 'undefined' && editNote) ? editNote : null;
var _editItems = (typeof editItems !== 'undefined' && editItems) ? editItems : [];
var _formAction  = _edit ? ('/delivery-notes/' + _edit.id + '/update') : '/delivery-notes';
var _submitLabel = _edit ? 'Update Voucher' : 'Create Voucher';
var _dateVal     = _edit ? ymd(_edit.note_date) : _today;
var _dispatchVal = _edit ? ymd(_edit.dispatch_date) : '';
%>

<%# The SAME header every other create screen uses (partials/page-head),
    not a voucher-only bar. The buttons sit outside the <form> and reach it by
    the form="…" attribute, exactly as sales-invoices/create.ejs does. %>
<%- include('../partials/page-head', {
    title: (_edit ? 'Edit' : 'Create') + ' Delivery Note Voucher',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: "Delivery Notes", href: '/delivery-notes' },
        { label: _edit ? 'Edit Delivery Note' : 'Create Delivery Note' },
    ],
    actions:
        '<a class="btn btn-light" href="' + '/delivery-notes' + '"><i class="fa-solid fa-list-ul me-2"></i>' + 'View Delivery Notes' + '</a>' +
        '<button type="submit" form="delivery-note-form" id="dn-submit" class="btn btn-gradient"' + '' + '>' +
            '<i class="fa-solid fa-cloud-arrow-up me-2"></i>' + _submitLabel +
        '</button>',
}) %>

<form id="delivery-note-form" method="post" action="<%= _formAction %>" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/delivery-note.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

                <div class="q-total-row" id="dn-discount-row" hidden>
                    <span class="lbl">Discount</span><span class="val" id="dn-discount">− ₹0.00</span>
                </div>
<div class="q-total-row">
                    <span class="lbl">Sub Total</span><span class="val" id="dn-subtotal">₹0.00</span>
                </div>
                <div class="q-total-row">
                    <span class="lbl">Taxes</span><span class="val" id="dn-taxes">₹0.00</span>
                </div>
                <div class="q-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="dn-grand">₹0.00</span>
                </div>
            </div>
        </div>

        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="/delivery-notes">Cancel</a>
            <button type="submit" class="btn btn-primary" id="dn-submit">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i><%= _submitLabel %>
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/delivery-note.js) ─────────── -->
<template id="dn-row-tpl">
    <tr class="dn-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search dn-item-search" placeholder="Search item…" autocomplete="off">
            <input type="hidden" class="dn-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="number" class="dn-qty li-num" min="0" step="1" value="1"></td>
        <td><input type="number" class="dn-rate li-num" min="0" step="0.01" value="0"></td>
        <%# Units: fills from the item but stays EDITABLE. A read-only box could
            not be corrected when an item's unit is wrong or missing in Tally,
            which left the line with no unit at all on the print. Backed by a
            datalist of the units actually in use. %>
        <td><input type="text" class="dn-unit" placeholder="—" list="dn-unit-options"></td>
        <td><input type="number" class="dn-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><input type="text" class="dn-hsn" readonly placeholder="—"></td>
        <%# Godown is where the stock physically sits. Backed by a datalist of
            the company's Tally godowns, and prefilled when there is only one —
            picking the single available option by hand is not a decision. %>
        <td><input type="text" class="dn-godown" placeholder="Godown" list="dn-godown-options"
                   value="<%= _defaultGodown %>"></td>
        <td><input type="text" class="dn-desc" placeholder="Description"></td>
        <td><span class="dn-amount li-cell-calc">₹0.00</span></td>
        <td class="center"><input type="checkbox" class="dn-taxincl" title="Tax inclusive"></td>
        <td class="center">
            <button type="button" class="dn-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<%# Suggestion lists for the editable line fields. A datalist SUGGESTS without
    restricting, which is what these need: the company's real godowns and units
    are the common answers, but a one-off value must still be typeable. %>
<datalist id="dn-godown-options">
    <% _godowns.forEach(function (g) { %><option value="<%= g.name %>"></option><% }); %>
</datalist>
<datalist id="dn-unit-options">
    <% _units.forEach(function (u) { %><option value="<%= u %>"></option><% }); %>
</datalist>

<!-- ── "Create New Customer" modal — pinned row atop the Party list.
     Fields mirror what POST /delivery-notes/create/quick-customer forwards to
     the real customers API: name (required) + the obviously-useful optionals. -->
<div class="modal fade" id="dn-new-customer-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="q-nc-error alert alert-danger py-2 px-3" id="dn-nc-error" hidden></div>

                <fieldset class="q-nc-section">
                    <legend class="q-nc-section-title">Basic Details</legend>
                    <div class="form-grid form-grid--3col">
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-gst">GST Number</label>
                            <input type="text" class="form-control text-uppercase" id="dn-nc-gst" maxlength="30">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-name">Ledger Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="dn-nc-name" maxlength="191" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-ledger-group">Ledger Group</label>
                            <% if (_ncLedgerGroups.length) { %>
                            <input type="text" class="form-control" id="dn-nc-ledger-group" list="dn-nc-ledger-group-options" placeholder="Search a Tally group" maxlength="191" autocomplete="off">
                            <datalist id="dn-nc-ledger-group-options">
                                <% _ncLedgerGroups.forEach(function (g) { %><option value="<%= g %>"><% }); %>
                            </datalist>
                            <% } else { %>
                            <input type="text" class="form-control" id="dn-nc-ledger-group" placeholder="e.g. Sundry Debtors" maxlength="191">
                            <% } %>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-mobile">Mobile</label>
                            <input type="text" class="form-control" id="dn-nc-mobile" maxlength="30">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-email">Email</label>
                            <input type="email" class="form-control" id="dn-nc-email" maxlength="191">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-opening-balance">Opening Balance</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" class="form-control" id="dn-nc-opening-balance" placeholder="0" min="0" step="1">
                                <select class="form-select" id="dn-nc-opening-balance-type" style="max-width:90px;flex:0 0 auto;">
                                    <option value="Cr" selected>Cr</option>
                                    <option value="Dr">Dr</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="q-nc-section">
                    <legend class="q-nc-section-title">Other Details</legend>
                    <div class="form-grid form-grid--3col">
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-country">Country</label>
                            <select class="form-select" id="dn-nc-country" name="country"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-state">State</label>
                            <select class="form-select" id="dn-nc-state" name="state" disabled>
                                <option value="" selected>Select country first</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-city">City</label>
                            <select class="form-select" id="dn-nc-city" name="city" disabled>
                                <option value="" selected>Select state first</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-address">Postal Address</label>
                            <textarea class="form-control" id="dn-nc-address" rows="2" maxlength="2000"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-pincode">Postal Code</label>
                            <input type="text" class="form-control" id="dn-nc-pincode" maxlength="12">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="dn-nc-gst-reg-type">GST Registration Type</label>
                            <select class="form-select" id="dn-nc-gst-reg-type">
                                <option value="" selected>Select registration type</option>
                                <% _ncGstRegTypes.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }); %>
                            </select>
                        </div>
                        <div class="form-group form-grid-span-3">
                            <label class="form-label" for="dn-nc-narration">Narration</label>
                            <textarea class="form-control" id="dn-nc-narration" rows="2" maxlength="2000"></textarea>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="dn-nc-save">
                    <i class="fa-solid fa-check me-1"></i>Save Customer
                </button>
            </div>
        </div>
    </div>
</div>

<%# Products / parties / sales-ledgers for the searchable comboboxes. %>
<script>
    window.DELIVERY_NOTE_PRODUCTS = <%- _productsJson %>;
    window.DELIVERY_NOTE_PARTIES  = <%- _partiesJson %>;
    window.DELIVERY_NOTE_LEDGERS  = <%- _ledgersJson %>;
    window.DELIVERY_NOTE_ORDERS   = <%- _ordersJson %>;
    window.DELIVERY_NOTE_QUICK_CUSTOMER_URL = '/delivery-notes/create/quick-customer';
    // Edit mode: existing header + line items for delivery-note.js.
    window.DELIVERY_NOTE_EDIT = <%- _edit ? JSON.stringify({ id: _edit.id, customer_id: _edit.customer_id, customer_name: _edit.customer_name || '', ledger_name: _edit.ledger_name || '', note_no: _edit.note_no || '', items: _editItems }) : 'null' %>;
</script>

<style>
    /* Searchable item picker for delivery-note rows (same widget as the
       quotation/invoice line-item picker) — kept local to this page like
       sales-orders/create.ejs does, rather than growing theme.css. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    /* position: FIXED (not absolute) so the menu escapes the table's
       overflow-x:auto clip (which also clips overflow-y). delivery-note.js sets
       top/left/width from the search input's viewport rect. */
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #E9EDF3); border-radius: 12px;
        box-shadow: 0 8px 24px rgba(16,24,40,.10); padding: 4px;
    }
    .li-prod-item { padding: 9px 12px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 8px; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #EAF1FE; color: #1560E0; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }


    /* Party/Ledger clear (×) button — only shown once a value is picked;
       sits inside the combobox cell, to the left of the dropdown's own
       scrollbar gutter. */
    .li-prod-clear {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; border: 0; border-radius: 50%;
        background: transparent; color: #9ca3af; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
    }
    .li-prod-clear:hover { background: #f3f4f6; color: #374151; }
    .li-prod-cell:has(.li-prod-clear:not([hidden])) .li-product-search { padding-right: 26px; }

    /* Row sub-value (balance/parent) right-aligned opposite the label
       (party rows show outstanding balance on the right when available;
       ledger rows already used getSubLabel for the parent). */
    /* An option is two lines: the name, then what you check before picking it
       (HSN / stock for an item, the group and tax treatment for a ledger).
       Side by side in one row they fought for the same narrow width and both
       ended up clipped — "In sto…" told nobody anything. */
    .li-prod-item { display: block; white-space: normal; line-height: 1.35; }
    .li-prod-item > span:first-child { display: block; font-weight: 500; }
    /* The pinned "create new" row is still one line: icon beside label. */
    .li-prod-item.li-prod-create { display: flex; align-items: center; }
    .li-prod-item .li-prod-sub { display: block; text-align: left; margin-top: 1px; }

    /* "Create New Customer" pinned row. */
    .li-prod-item.li-prod-create {
        color: var(--primary); font-weight: 600; gap: 6px;
        border-bottom: 1px solid var(--border, #e5e7eb);
    }
    .li-prod-item.li-prod-create:hover { background: #EAF1FE; }
</style>
