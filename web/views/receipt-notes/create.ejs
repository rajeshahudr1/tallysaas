<%
/* ─────────────────────────────────────────────────────────────
 * views/receipt-notes/create.ejs — TRANSACTIONS · Create Receipt Note Voucher.
 * Route: GET /receipt-notes/create  ·  activeMenu: 'recpt-notes'.
 *
 * Own copy of views/delivery-notes/create.ejs — same layout/behaviour (full-bleed
 * header, Party/Ledger/No row, Date row, items grid, two collapsible strips,
 * right-hand totals panel) with an `rn-` DOM-hook prefix instead of `dn-`, and
 * a second header row of Date + Received On + Against Purchase Order (optional,
 * searchable — open orders only). Task 4's /js/receipt-note.js binds to these
 * ids/classes verbatim.
 *
 * Three deliberate differences from Delivery Note (mirroring Purchase Order):
 *   1. The first field is populated from SUPPLIERS (not customers).
 *   2. Ledger Type lists PURCHASE ledgers (Tally group "Purchase Accounts"),
 *      not sales ledgers — reuses the same endpoint the Purchase Order create
 *      screen already uses (fetchPurchaseLedgerOptions), no new one added.
 *   3. There is NO "Create New Supplier" modal here — creating a supplier
 *      mid-voucher is out of scope for this module (same call Purchase Order
 *      made); shipping a half-wired modal would be worse than leaving it out.
 *
 * Expected locals (routes/web.js → res.render):
 *   supplierOptions / locationOptions             — header selects
 *   invoiceProducts [{id,name,hsn,unit,rate,gst,stock}]    — line-item picker
 *   purchaseLedgerOptions                                   — ledger combobox
 *   purchaseOrderOptions [{id,order_no,supplier}]           — Against Order
 *   nextReceiptNoteNo string                                — read-only no.
 * ─────────────────────────────────────────────────────────── */

var _supps    = (typeof supplierOptions !== 'undefined' && supplierOptions) ? supplierOptions : [];
var _locs     = (typeof locationOptions !== 'undefined' && locationOptions) ? locationOptions : [];
var _products = (typeof invoiceProducts !== 'undefined' && invoiceProducts) ? invoiceProducts : [];
var _ledgers  = (typeof purchaseLedgerOptions !== 'undefined' && purchaseLedgerOptions) ? purchaseLedgerOptions : [];
var _rnNo     = (typeof nextReceiptNoteNo !== 'undefined' && nextReceiptNoteNo) ? nextReceiptNoteNo : '';
var _orders   = (typeof purchaseOrderOptions !== 'undefined' && purchaseOrderOptions) ? purchaseOrderOptions : [];

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* Products as a JS array for the searchable line-item picker. */
var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : 0) };
}));

/* Party + purchase-ledger options for the header comboboxes (auto-advance flow). */
var _partiesJson = JSON.stringify(_supps.map(function (c) { return { id: c.id, name: c.name }; }));
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) { return { id: l.id, name: l.name, parent: l.parent || '' }; }));

/* Open purchase orders for the "Against Purchase Order" searchable combobox. */
var _ordersJson = JSON.stringify(_orders.map(function (o) { return { id: o.id, order_no: o.order_no, supplier: o.supplier || '' }; }));

var _today = new Date().toISOString().slice(0, 10);
%>

<form id="receipt-note-form" method="post" action="/receipt-notes" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/receipt-note.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

        <div class="voucher-head">
            <a class="q-back" href="/receipt-notes" title="Back to receipt notes" aria-label="Back to receipt notes">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <span>Create Receipt Note Voucher</span>
            <a class="q-list-btn" href="/receipt-notes">
                <i class="fa-solid fa-list-ul me-1"></i>View Receipt Notes
            </a>
        </div>

        <div class="inv-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="rn-party">Supplier Name<span class="req">*</span></label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="rn-party"
                               placeholder="Search supplier…" autocomplete="off" required>
                        <input type="hidden" name="supplier_id" id="rn-party-id">
                        <button type="button" class="li-prod-clear" id="rn-party-clear" title="Clear supplier" aria-label="Clear supplier" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="li-prod-menu" id="rn-party-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rn-ledger">Ledger Type</label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="rn-ledger" name="ledger_name"
                               placeholder="<%= _ledgers.length ? 'Search ledger…' : 'No ledgers synced yet' %>"
                               autocomplete="off" disabled>
                        <div class="li-prod-menu" id="rn-ledger-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rn-no">Note No</label>
                    <div class="q-no-wrap">
                        <input type="text" class="form-control" id="rn-no" name="note_no"
                               value="" placeholder="<%= _esc(_rnNo || 'Auto-generated on save') %>" readonly>
                        <button type="button" class="q-no-edit" id="rn-no-edit" title="Edit note no" aria-label="Edit note no">
                            <i class="fa-solid fa-pen"></i>
                        </button>

                        <!-- ── Default/Custom note-no popup — same registerPopup()/
                             closeAllPopups() gate as every other dropdown on this page
                             (outside click / Esc close it too). -->
                        <div class="q-no-popup" id="rn-no-popup" hidden>
                            <div class="q-no-popup-radios">
                                <label class="q-no-radio">
                                    <input type="radio" name="rn-no-mode" id="rn-no-mode-default" value="default" checked>
                                    <span>Default</span>
                                </label>
                                <label class="q-no-radio">
                                    <input type="radio" name="rn-no-mode" id="rn-no-mode-custom" value="custom">
                                    <span>Custom</span>
                                </label>
                            </div>
                            <div class="q-no-popup-fields" id="rn-no-popup-fields" hidden>
                                <div class="q-no-field">
                                    <label for="rn-no-prefix">Prefix</label>
                                    <input type="text" class="form-control" id="rn-no-prefix" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="rn-no-number">Voucher no</label>
                                    <input type="text" class="form-control" id="rn-no-number" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="rn-no-suffix">Suffix</label>
                                    <input type="text" class="form-control" id="rn-no-suffix" maxlength="20" autocomplete="off">
                                </div>
                            </div>
                            <div class="q-no-popup-actions">
                                <button type="button" class="btn btn-light btn-sm" id="rn-no-cancel">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm" id="rn-no-save">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="rn-date">Date<span class="req">*</span></label>
                    <input type="date" class="form-control" id="rn-date" name="note_date" value="<%= _today %>" required disabled>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rn-received">Received On</label>
                    <input type="date" class="form-control" id="rn-received" name="received_date" disabled>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rn-order">Against Purchase Order</label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="rn-order"
                               placeholder="Search open purchase order…" autocomplete="off" disabled>
                        <input type="hidden" name="purchase_order_id" id="rn-order-id">
                        <button type="button" class="li-prod-clear" id="rn-order-clear" title="Clear order" aria-label="Clear order" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="li-prod-menu" id="rn-order-menu" hidden></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Items table ════ -->
        <div class="li-table-wrap">
            <table class="q-table">
                <thead>
                    <tr>
                        <th>Items</th>
                        <th class="num">Qty</th>
                        <th class="num">Rate</th>
                        <th>Units</th>
                        <th class="num">Disc %</th>
                        <th>HSN Code</th>
                        <th>Godown</th>
                        <th>Description</th>
                        <th class="num">Amount</th>
                        <th class="center">Tax Incl.</th>
                        <th class="center">
                            <button type="button" class="q-add-btn" id="rn-add-row" title="Add row" aria-label="Add row" disabled>
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <!-- Rows are injected by /js/receipt-note.js from the template below. -->
                <tbody id="rn-body"></tbody>
            </table>
        </div>

        <!-- ════ Collapsible strips ════ -->
        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#rn-narration" aria-expanded="false">
                <span>Narration</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="rn-narration">
                <div class="q-collapse-body">
                    <textarea class="form-control" id="rn-notes" name="notes" rows="3"
                              maxlength="2000" placeholder="Narration for this receipt note…"></textarea>
                </div>
            </div>
        </div>

        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#rn-advanced" aria-expanded="false">
                <span>Advanced Settings</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="rn-advanced">
                <div class="q-collapse-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="rn-location">Location</label>
                            <select class="form-select" id="rn-location" name="location_id">
                                <option value="" selected>Select location</option>
                                <% _locs.forEach(function (o) { %>
                                    <option value="<%= o.id %>"><%= _esc(o.name) %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Footer — right-hand totals panel + Create Voucher ════ -->
        <div class="inv-foot q-foot">
            <div></div>

            <div class="q-totals">
                <div class="q-total-row">
                    <span class="lbl">Sub Total</span><span class="val" id="rn-subtotal">₹0.00</span>
                </div>
                <div class="q-total-row">
                    <span class="lbl">Taxes</span><span class="val" id="rn-taxes">₹0.00</span>
                </div>
                <div class="q-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="rn-grand">₹0.00</span>
                </div>
            </div>
        </div>

        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="/receipt-notes">Cancel</a>
            <button type="submit" class="btn btn-primary" id="rn-submit">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Create Voucher
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/receipt-note.js) ─────────── -->
<template id="rn-row-tpl">
    <tr class="rn-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search rn-item-search" placeholder="Search item…" autocomplete="off" disabled>
            <input type="hidden" class="rn-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="number" class="rn-qty li-num" min="0" step="1" value="1" disabled></td>
        <td><input type="number" class="rn-rate li-num" min="0" step="0.01" value="0" disabled></td>
        <td><input type="text" class="rn-unit" readonly placeholder="—"></td>
        <td><input type="number" class="rn-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><input type="text" class="rn-hsn" readonly placeholder="—"></td>
        <td><input type="text" class="rn-godown" placeholder="Godown"></td>
        <td><input type="text" class="rn-desc" placeholder="Description"></td>
        <td><span class="rn-amount li-cell-calc">₹0.00</span></td>
        <td class="center"><input type="checkbox" class="rn-taxincl" title="Tax inclusive"></td>
        <td class="center">
            <button type="button" class="rn-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<%# Products / parties / purchase-ledgers / orders for the searchable comboboxes. %>
<script>
    window.RECEIPT_NOTE_PRODUCTS = <%- _productsJson %>;
    window.RECEIPT_NOTE_PARTIES  = <%- _partiesJson %>;
    window.RECEIPT_NOTE_LEDGERS  = <%- _ledgersJson %>;
    window.RECEIPT_NOTE_ORDERS   = <%- _ordersJson %>;
</script>

<style>
    /* Searchable item picker for receipt-note rows (same widget/markup as
       the sales-order/quotation/invoice/purchase-order line-item picker) —
       kept local to this page like delivery-notes/create.ejs does, rather
       than growing theme.css. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    /* position: FIXED (not absolute) so the menu escapes the table's
       overflow-x:auto clip (which also clips overflow-y). receipt-note.js
       sets top/left/width from the search input's viewport rect. */
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #d1d5db); border-radius: 6px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }
    .li-prod-item { padding: 7px 10px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #eef2ff; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }

    /* Single header bar — replaces the stacked page-head + voucher-head pair;
       a compact Back arrow instead of a second title. */
    .q-back {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 6px; margin-right: 10px;
        color: #fff; background: rgba(255,255,255,.15); vertical-align: middle;
    }
    .q-back:hover { background: rgba(255,255,255,.28); color: #fff; }

    /* Full-bleed header bar — LiveKeeping's header spans the ENTIRE content
       area, flush against the sidebar and the right edge, with nothing else
       above it. <main class="page"> pads 24px 28px (see theme.css), so pull
       the bar out by that exact amount and square its top corners; the rest
       of the card (below the bar) stays inset as normal. */
    .q-voucher { overflow: visible; }
    .voucher-head {
        display: flex; align-items: center;
        margin: -24px -28px 16px;
        border-radius: 0;
    }
    .voucher-head span { flex: 0 0 auto; }
    @media (max-width: 767.98px) {
        .voucher-head { margin: -20px -16px 16px; }
    }

    /* "View Receipt Notes" header button — sits after the title, pushed to
       the far right of the full-bleed bar. */
    .q-list-btn {
        margin-left: auto;
        display: inline-flex; align-items: center;
        padding: 6px 14px; border-radius: 6px;
        font-size: 12.5px; font-weight: 600;
        color: #fff; background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
    }
    .q-list-btn:hover { background: rgba(255,255,255,.28); color: #fff; }

    /* Party/Ledger/Order clear (×) button — only shown once a value is
       picked; sits inside the combobox cell, to the left of the dropdown's
       own scrollbar gutter. */
    .li-prod-clear {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; border: 0; border-radius: 50%;
        background: transparent; color: #9ca3af; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
    }
    .li-prod-clear:hover { background: #f3f4f6; color: #374151; }
    .li-prod-cell:has(.li-prod-clear:not([hidden])) .li-product-search { padding-right: 26px; }

    /* Row sub-value (balance/parent) right-aligned opposite the label
       (ledger/order rows use getSubLabel for the parent/supplier). */
    .li-prod-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .li-prod-item .li-prod-sub { flex: 0 0 auto; text-align: right; }
</style>
