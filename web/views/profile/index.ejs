<%
/* ─────────────────────────────────────────────────────────────
 * views/profile/index.ejs — MY PROFILE (every role).
 * Route: GET /profile · shows identity + a Change Password form.
 * ─────────────────────────────────────────────────────────── */
var _p = (typeof profile !== 'undefined' && profile) ? profile : {};
function _initials(name) {
    var parts = String(name || 'U').trim().split(/\s+/);
    return ((parts[0] || 'U').charAt(0) + (parts.length > 1 ? parts[parts.length - 1].charAt(0) : '')).toUpperCase();
}
%>

<%- include('../partials/page-head', {
    title: 'My Profile',
    breadcrumb: [{ label: 'My Profile' }],
}) %>

<div class="profile-grid">

    <!-- Identity card -->
    <div class="card profile-card">
        <div class="profile-id">
            <span class="profile-avatar"><%= _initials(_p.name) %></span>
            <div>
                <div class="profile-name"><%= _p.name %></div>
                <% if (_p.role) { %><span class="profile-role-chip"><%= _p.role %></span><% } %>
            </div>
        </div>
        <dl class="profile-detail">
            <div><dt>Email</dt><dd><%= _p.email || '—' %></dd></div>
            <div><dt>Mobile</dt><dd><%= _p.mobile || '—' %></dd></div>
            <div><dt>Role</dt><dd><%= _p.role || '—' %></dd></div>
            <% if (_p.status) { %><div><dt>Status</dt><dd><span class="pill-status pill-status--success"><%= _p.status %></span></dd></div><% } %>
        </dl>
    </div>

    <!-- Change password card -->
    <div class="card profile-card">
        <h2 class="profile-section-title"><i class="fa-solid fa-lock me-2 text-primary"></i>Change Password</h2>
        <p class="text-muted" style="font-size:13px;margin-bottom:16px">Enter your current password, then choose a new one (min 6 characters).</p>
        <form method="post" action="/profile/change-password" autocomplete="off" novalidate>
            <div class="mb-3">
                <label class="form-label">Current Password</label>
                <input type="password" name="current_password" class="form-control" required autocomplete="current-password">
            </div>
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="new_password" class="form-control" required minlength="6" autocomplete="new-password">
            </div>
            <div class="mb-4">
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="confirm_password" class="form-control" required minlength="6" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check me-1"></i>Update Password
            </button>
        </form>
    </div>

</div>

<style>
    .profile-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
    @media (max-width: 767.98px) { .profile-grid { grid-template-columns:1fr; } }
    .profile-card { padding:22px 24px; }
    .profile-id { display:flex; align-items:center; gap:16px; margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--border); }
    .profile-avatar { width:60px; height:60px; border-radius:50%; background:var(--primary); color:#fff;
        display:grid; place-items:center; font-size:22px; font-weight:800; flex-shrink:0; }
    .profile-name { font-size:18px; font-weight:700; color:var(--text); }
    .profile-role-chip { display:inline-block; margin-top:5px; padding:2px 10px; border-radius:999px;
        font-size:11.5px; font-weight:700; color:var(--primary); background:rgba(37,99,235,.12); }
    .profile-detail { margin:0; }
    .profile-detail > div { display:grid; grid-template-columns:38% 62%; gap:8px; padding:9px 0; border-bottom:1px solid var(--border); }
    .profile-detail > div:last-child { border-bottom:0; }
    .profile-detail dt { margin:0; color:var(--text-muted); font-weight:500; font-size:13px; }
    .profile-detail dd { margin:0; color:var(--text); font-weight:600; font-size:13.5px; }
    .profile-section-title { font-size:16px; font-weight:700; color:var(--text); margin:0 0 4px; }
</style>
