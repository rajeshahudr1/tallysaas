<%
/* ─────────────────────────────────────────────────────────────
 * views/purchase-orders/create.ejs — TRANSACTIONS · Create Purchase Order Voucher.
 * Route: GET /purchase-orders/create  ·  activeMenu: 'purch-orders'.
 *
 * Own copy of views/sales-orders/create.ejs — same layout/behaviour (full-bleed
 * header, Party/Ledger/No row, Date row, items grid, two collapsible strips,
 * right-hand totals panel) with a `po-` DOM-hook prefix instead of `so-`.
 * Task 4's /js/purchase-order.js binds to these ids/classes verbatim.
 *
 * Three deliberate differences from Sales Order:
 *   1. The first field is populated from SUPPLIERS (not customers).
 *   2. Ledger Type lists PURCHASE ledgers (Tally group "Purchase Accounts"),
 *      not sales ledgers.
 *   3. There is NO "Create New Customer" modal here — creating a supplier
 *      mid-voucher is out of scope for this module; shipping a half-wired
 *      modal would be worse than leaving it out.
 *
 * Expected locals (routes/web.js → res.render):
 *   supplierOptions / locationOptions            — header selects
 *   invoiceProducts [{id,name,hsn,unit,rate,gst,stock}]    — line-item picker
 *   purchaseLedgerOptions                                   — ledger combobox
 *   nextPurchaseOrderNo string                              — read-only no.
 * ─────────────────────────────────────────────────────────── */

var _supps    = (typeof supplierOptions !== 'undefined' && supplierOptions) ? supplierOptions : [];
var _locs     = (typeof locationOptions !== 'undefined' && locationOptions) ? locationOptions : [];
// Tally's per-tier rate cards. Absent for a company that uses none, in
// which case the picker is not rendered at all rather than shown empty.
var _priceLevels = (typeof priceLevelOptions !== 'undefined' && priceLevelOptions) ? priceLevelOptions : [];
var _ncGstRegTypes  = (typeof gstRegistrationTypes !== 'undefined' && gstRegistrationTypes) ? gstRegistrationTypes : [];
var _products = (typeof invoiceProducts !== 'undefined' && invoiceProducts) ? invoiceProducts : [];
var _ledgers  = (typeof purchaseLedgerOptions !== 'undefined' && purchaseLedgerOptions) ? purchaseLedgerOptions : [];
var _poNo     = (typeof nextPurchaseOrderNo !== 'undefined' && nextPurchaseOrderNo) ? nextPurchaseOrderNo : '';

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* Products as a JS array for the searchable line-item picker. */

/* The Tally GODOWNS among the locations — stock physically sits in one, and a
   voucher line needs it. When the company has exactly one (the common case,
   "Main Location"), every new line starts there rather than making the user
   pick the only option there is. */
var _godowns = _locs.filter(function (l) { return l.is_tally_godown; });
var _defaultGodown = _godowns.length === 1 ? _godowns[0].name : '';

/* The units actually in use on this company's items — suggestions for the
   editable Units box, so the common answers are one keystroke away. */
var _units = (function () {
    var seen = {};
    _products.forEach(function (p) { if (p.unit) seen[p.unit] = true; });
    return Object.keys(seen).sort();
})();

var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : null) };
}));

/* Party + purchase-ledger options for the header comboboxes (auto-advance flow). */
var _partiesJson = JSON.stringify(_supps.map(function (c) {
    return {
        id: c.id, name: c.name,
        balance: (c.closing_balance == null ? null : c.closing_balance),
        gst_number: c.gst_number || '', gst_registration_type: c.gst_registration_type || '',
        billing_address: c.billing_address || c.address || '', country: c.country || '',
        state: c.state || '', pincode: c.pincode || '',
    };
}));
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) {
    return {
        id: l.id, name: l.name, parent: l.parent || '',
        tax_type: l.tax_type || '', tax_classification: l.tax_classification || '',
    };
}));

var _today = new Date().toISOString().slice(0, 10);

/* EDIT MODE — see quotations/create.ejs; one screen serves create and edit. */
var _edit      = (typeof editOrder !== 'undefined' && editOrder) ? editOrder : null;
var _editItems = (typeof editItems !== 'undefined' && editItems) ? editItems : [];
var _formAction  = _edit ? ('/purchase-orders/' + _edit.id + '/update') : '/purchase-orders';
var _submitLabel = _edit ? 'Update Voucher' : 'Create Voucher';
var _dateVal     = _edit ? ymd(_edit.order_date) : _today;
var _dueVal      = _edit ? ymd(_edit.due_on) : '';
%>

<%# The SAME header every other create screen uses (partials/page-head),
    not a voucher-only bar. The buttons sit outside the <form> and reach it by
    the form="…" attribute, exactly as sales-invoices/create.ejs does. %>
<%- include('../partials/page-head', {
    title: (_edit ? 'Edit' : 'Create') + ' Purchase Order Voucher',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: "Purchase Orders", href: '/purchase-orders' },
        { label: _edit ? 'Edit Purchase Order' : 'Create Purchase Order' },
    ],
    actions:
        '<a class="btn btn-light" href="' + '/purchase-orders' + '"><i class="fa-solid fa-list-ul me-2"></i>' + 'View Purchase Orders' + '</a>' +
        '<button type="submit" form="purchase-order-form" id="po-submit" class="btn btn-gradient"' + '' + '>' +
            '<i class="fa-solid fa-cloud-arrow-up me-2"></i>' + _submitLabel +
        '</button>',
}) %>

<form id="purchase-order-form" method="post" action="<%= _formAction %>" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/purchase-order.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

                <div class="q-total-row" id="po-discount-row" hidden>
                    <span class="lbl">Discount</span><span class="val" id="po-discount">− ₹0.00</span>
                </div>
<div class="q-total-row">
                    <span class="lbl">Sub Total</span><span class="val" id="po-subtotal">₹0.00</span>
                </div>
                <div class="q-total-row">
                    <span class="lbl">Taxes</span><span class="val" id="po-taxes">₹0.00</span>
                </div>
                <div class="q-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="po-grand">₹0.00</span>
                </div>
            </div>
        </div>

        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="/purchase-orders">Cancel</a>
            <button type="submit" class="btn btn-primary" id="po-submit">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i><%= _submitLabel %>
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/purchase-order.js) ─────────── -->
<template id="po-row-tpl">
    <tr class="po-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search po-item-search" placeholder="Search item…" autocomplete="off">
            <input type="hidden" class="po-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="number" class="po-qty li-num" min="0" step="1" value="1"></td>
        <td><input type="number" class="po-rate li-num" min="0" step="0.01" value="0"></td>
        <%# Units: fills from the item but stays EDITABLE. A read-only box could
            not be corrected when an item's unit is wrong or missing in Tally,
            which left the line with no unit at all on the print. Backed by a
            datalist of the units actually in use. %>
        <td><input type="text" class="po-unit" placeholder="—" list="po-unit-options"></td>
        <td><input type="number" class="po-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><input type="text" class="po-hsn" readonly placeholder="—"></td>
        <%# Godown is where the stock physically sits. Backed by a datalist of
            the company's Tally godowns, and prefilled when there is only one —
            picking the single available option by hand is not a decision. %>
        <td><input type="text" class="po-godown" placeholder="Godown" list="po-godown-options"
                   value="<%= _defaultGodown %>"></td>
        <td><input type="text" class="po-desc" placeholder="Description"></td>
        <td><span class="po-amount li-cell-calc">₹0.00</span></td>
        <td class="center"><input type="checkbox" class="po-taxincl" title="Tax inclusive"></td>
        <td class="center">
            <button type="button" class="po-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<%# Suggestion lists for the editable line fields. A datalist SUGGESTS without
    restricting, which is what these need: the company's real godowns and units
    are the common answers, but a one-off value must still be typeable. %>
<datalist id="po-godown-options">
    <% _godowns.forEach(function (g) { %><option value="<%= g.name %>"></option><% }); %>
</datalist>
<datalist id="po-unit-options">
    <% _units.forEach(function (u) { %><option value="<%= u %>"></option><% }); %>
</datalist>

<%# Products / parties / purchase-ledgers for the searchable comboboxes. %>
<script>
    window.PURCHASE_ORDER_PRODUCTS = <%- _productsJson %>;
    window.PURCHASE_ORDER_PARTIES  = <%- _partiesJson %>;
    window.PURCHASE_ORDER_LEDGERS  = <%- _ledgersJson %>;
    // Edit mode: existing header + line items for purchase-order.js.
    window.PURCHASE_ORDER_EDIT = <%- _edit ? JSON.stringify({ id: _edit.id, supplier_id: _edit.supplier_id, supplier_name: _edit.supplier || _edit.supplier_name || '', ledger_name: _edit.ledger_name || '', order_no: _edit.order_no || '', items: _editItems }) : 'null' %>;
</script>

<style>
    /* Searchable item picker for purchase-order rows (same widget/markup as
       the sales-order/quotation/invoice line-item picker) — kept local to
       this page like sales-orders/create.ejs does, rather than growing
       theme.css. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    /* position: FIXED (not absolute) so the menu escapes the table's
       overflow-x:auto clip (which also clips overflow-y). purchase-order.js
       sets top/left/width from the search input's viewport rect. */
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #E9EDF3); border-radius: 12px;
        box-shadow: 0 8px 24px rgba(16,24,40,.10); padding: 4px;
    }
    .li-prod-item { padding: 9px 12px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 8px; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #EAF1FE; color: #1560E0; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }


    /* Party/Ledger clear (×) button — only shown once a value is picked;
       sits inside the combobox cell, to the left of the dropdown's own
       scrollbar gutter. */
    .li-prod-clear {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; border: 0; border-radius: 50%;
        background: transparent; color: #9ca3af; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
    }
    .li-prod-clear:hover { background: #f3f4f6; color: #374151; }
    .li-prod-cell:has(.li-prod-clear:not([hidden])) .li-product-search { padding-right: 26px; }

    /* Row sub-value (balance/parent) right-aligned opposite the label
       (ledger rows use getSubLabel for the parent). */
    /* An option is two lines: the name, then what you check before picking it
       (HSN / stock for an item, the group and tax treatment for a ledger).
       Side by side in one row they fought for the same narrow width and both
       ended up clipped — "In sto…" told nobody anything. */
    .li-prod-item { display: block; white-space: normal; line-height: 1.35; }
    .li-prod-item > span:first-child { display: block; font-weight: 500; }
    /* The pinned "create new" row is still one line: icon beside label. */
    .li-prod-item.li-prod-create { display: flex; align-items: center; }
    .li-prod-item .li-prod-sub { display: block; text-align: left; margin-top: 1px; }
</style>
