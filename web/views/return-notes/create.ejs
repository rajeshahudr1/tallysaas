<%
/* ─────────────────────────────────────────────────────────────
 * views/return-notes/create.ejs — TRANSACTIONS · Create Credit Note / Debit
 * Note Voucher. Routes: GET /credit-notes/create, GET /debit-notes/create.
 *
 * ONE view handles BOTH kinds — header title, party label/create-modal and
 * hrefs all switch on the `kind` local so the two paths cannot silently
 * drift apart. Own copy of views/delivery-notes/create.ejs's layout, with a
 * `cn-` DOM-hook prefix and a second header row of Date + Against Bill
 * (optional, searchable — sales invoices for Credit, purchase invoices for
 * Debit). /js/return-note.js binds to these ids/classes verbatim.
 *
 * Credit Note's party IS a customer, so it keeps the "Create New Customer"
 * modal (like sales-invoice/quotation). Debit Note's party is a supplier —
 * NO create-new-supplier modal, the same decision Purchase Order made for
 * its own supplier field (reported, not re-litigated here).
 *
 * Expected locals (routes/web.js → res.render):
 *   kind                'credit' | 'debit'
 *   partyOptions        [{id,name}]      — customers (credit) or suppliers (debit)
 *   ledgerOptions       [{id,name,parent}]
 *   returnNoteProducts  [{id,name,hsn,unit,rate,gst,stock}]
 *   billOptions         [{id,invoice_no,party}] — original bills for Against Bill
 *   ledgerGroupOptions / gstRegistrationTypes    — Create New Customer modal (credit only)
 * ─────────────────────────────────────────────────────────── */

var _kind     = (typeof kind !== 'undefined' && kind) ? kind : 'credit';
var _isCredit = _kind === 'credit';
var _parties  = (typeof partyOptions !== 'undefined' && partyOptions) ? partyOptions : [];
var _products = (typeof returnNoteProducts !== 'undefined' && returnNoteProducts) ? returnNoteProducts : [];
var _ledgers  = (typeof ledgerOptions !== 'undefined' && ledgerOptions) ? ledgerOptions : [];
var _bills    = (typeof billOptions !== 'undefined' && billOptions) ? billOptions : [];
var _ncLedgerGroups = (typeof ledgerGroupOptions !== 'undefined' && ledgerGroupOptions) ? ledgerGroupOptions : [];
var _ncGstRegTypes  = (typeof gstRegistrationTypes !== 'undefined' && gstRegistrationTypes) ? gstRegistrationTypes : [];

var _basePath   = _isCredit ? '/credit-notes' : '/debit-notes';
var _partyLabel = _isCredit ? 'Customer Name' : 'Supplier Name';
var _pageLabel  = _isCredit ? 'Credit Note' : 'Debit Note';

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : 0) };
}));
var _partiesJson = JSON.stringify(_parties.map(function (c) { return { id: c.id, name: c.name }; }));
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) { return { id: l.id, name: l.name, parent: l.parent || '' }; }));
var _billsJson   = JSON.stringify(_bills.map(function (b) { return { id: b.id, invoice_no: b.invoice_no, party: b.party || '' }; }));

var _today = new Date().toISOString().slice(0, 10);
%>

<form id="return-note-form" method="post" action="<%= _basePath %>" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/return-note.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

        <div class="voucher-head">
            <a class="q-back" href="<%= _basePath %>" title="Back to <%= _pageLabel.toLowerCase() %>s" aria-label="Back to <%= _pageLabel.toLowerCase() %>s">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <span>Create <%= _pageLabel %> Voucher</span>
            <a class="q-list-btn" href="<%= _basePath %>">
                <i class="fa-solid fa-list-ul me-1"></i>View <%= _pageLabel %>s
            </a>
        </div>

        <div class="inv-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="cn-party"><%= _partyLabel %><span class="req">*</span></label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="cn-party"
                               placeholder="Search <%= _isCredit ? 'customer' : 'supplier' %>…" autocomplete="off" required>
                        <input type="hidden" name="<%= _isCredit ? 'customer_id' : 'supplier_id' %>" id="cn-party-id">
                        <button type="button" class="li-prod-clear" id="cn-party-clear" title="Clear <%= _isCredit ? 'customer' : 'supplier' %>" aria-label="Clear <%= _isCredit ? 'customer' : 'supplier' %>" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="li-prod-menu" id="cn-party-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="cn-ledger">Ledger Type</label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="cn-ledger" name="ledger_name"
                               placeholder="<%= _ledgers.length ? 'Search ledger…' : 'No ledgers synced yet' %>"
                               autocomplete="off" disabled>
                        <div class="li-prod-menu" id="cn-ledger-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="cn-no">Note No</label>
                    <div class="q-no-wrap">
                        <input type="text" class="form-control" id="cn-no" name="note_no"
                               value="" placeholder="Auto-generated on save" readonly>
                        <button type="button" class="q-no-edit" id="cn-no-edit" title="Edit note no" aria-label="Edit note no">
                            <i class="fa-solid fa-pen"></i>
                        </button>

                        <!-- ── Default/Custom note-no popup — same registerPopup()/
                             closeAllPopups() gate as every other dropdown on this page
                             (outside click / Esc close it too). -->
                        <div class="q-no-popup" id="cn-no-popup" hidden>
                            <div class="q-no-popup-radios">
                                <label class="q-no-radio">
                                    <input type="radio" name="cn-no-mode" id="cn-no-mode-default" value="default" checked>
                                    <span>Default</span>
                                </label>
                                <label class="q-no-radio">
                                    <input type="radio" name="cn-no-mode" id="cn-no-mode-custom" value="custom">
                                    <span>Custom</span>
                                </label>
                            </div>
                            <div class="q-no-popup-fields" id="cn-no-popup-fields" hidden>
                                <div class="q-no-field">
                                    <label for="cn-no-prefix">Prefix</label>
                                    <input type="text" class="form-control" id="cn-no-prefix" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="cn-no-number">Voucher no</label>
                                    <input type="text" class="form-control" id="cn-no-number" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="cn-no-suffix">Suffix</label>
                                    <input type="text" class="form-control" id="cn-no-suffix" maxlength="20" autocomplete="off">
                                </div>
                            </div>
                            <div class="q-no-popup-actions">
                                <button type="button" class="btn btn-light btn-sm" id="cn-no-cancel">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm" id="cn-no-save">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="cn-date">Date<span class="req">*</span></label>
                    <input type="date" class="form-control" id="cn-date" name="invoice_date" value="<%= _today %>" required disabled>
                </div>

                <div class="form-group">
                    <label class="form-label" for="cn-against">Against Bill</label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="cn-against"
                               placeholder="Search <%= _isCredit ? 'sales' : 'purchase' %> invoice…" autocomplete="off" disabled>
                        <input type="hidden" name="against_invoice_id" id="cn-against-id">
                        <button type="button" class="li-prod-clear" id="cn-against-clear" title="Clear bill" aria-label="Clear bill" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="li-prod-menu" id="cn-against-menu" hidden></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Items table ════ -->
        <div class="li-table-wrap">
            <table class="q-table">
                <thead>
                    <tr>
                        <th>Items</th>
                        <th class="num">Qty</th>
                        <th class="num">Rate</th>
                        <th>Units</th>
                        <th class="num">Disc %</th>
                        <th>HSN Code</th>
                        <th>Godown</th>
                        <th>Description</th>
                        <th class="num">Amount</th>
                        <th class="center">Tax Incl.</th>
                        <th class="center">
                            <button type="button" class="q-add-btn" id="cn-add-row" title="Add row" aria-label="Add row" disabled>
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <!-- Rows are injected by /js/return-note.js from the template below. -->
                <tbody id="cn-body"></tbody>
            </table>
        </div>

        <!-- ════ Collapsible strips ════ -->
        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#cn-narration" aria-expanded="false">
                <span>Narration</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="cn-narration">
                <div class="q-collapse-body">
                    <textarea class="form-control" id="cn-notes" name="notes" rows="3"
                              maxlength="2000" placeholder="Narration for this <%= _pageLabel.toLowerCase() %>…"></textarea>
                </div>
            </div>
        </div>

        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#cn-advanced" aria-expanded="false">
                <span>Advanced Settings</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="cn-advanced">
                <div class="q-collapse-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="cn-supplier-bill-no"><%= _isCredit ? 'Reference' : 'Supplier Bill No' %></label>
                            <input type="text" class="form-control" id="cn-supplier-bill-no" name="supplier_bill_no" maxlength="100">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Footer — right-hand totals panel + Create Voucher ════ -->
        <div class="inv-foot q-foot">
            <div></div>

            <div class="q-totals">
                <div class="q-total-row">
                    <span class="lbl">Sub Total</span><span class="val" id="cn-subtotal">₹0.00</span>
                </div>
                <div class="q-total-row">
                    <span class="lbl">Taxes</span><span class="val" id="cn-taxes">₹0.00</span>
                </div>
                <div class="q-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="cn-grand">₹0.00</span>
                </div>
            </div>
        </div>

        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="<%= _basePath %>">Cancel</a>
            <button type="submit" class="btn btn-primary" id="cn-submit">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Create Voucher
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/return-note.js) ─────────── -->
<template id="cn-row-tpl">
    <tr class="cn-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search cn-item-search" placeholder="Search item…" autocomplete="off" disabled>
            <input type="hidden" class="cn-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="number" class="cn-qty li-num" min="0" step="1" value="1" disabled></td>
        <td><input type="number" class="cn-rate li-num" min="0" step="0.01" value="0" disabled></td>
        <td><input type="text" class="cn-unit" readonly placeholder="—"></td>
        <td><input type="number" class="cn-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><input type="text" class="cn-hsn" readonly placeholder="—"></td>
        <td><input type="text" class="cn-godown" placeholder="Godown"></td>
        <td><input type="text" class="cn-desc" placeholder="Description"></td>
        <td><span class="cn-amount li-cell-calc">₹0.00</span></td>
        <td class="center"><input type="checkbox" class="cn-taxincl" title="Tax inclusive"></td>
        <td class="center">
            <button type="button" class="cn-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<% if (_isCredit) { %>
<!-- ── "Create New Customer" modal — Credit Note only (its party IS a
     customer); Debit Note's party is a supplier and gets none, same
     decision Purchase Order made for its own supplier field. -->
<div class="modal fade" id="cn-new-customer-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="q-nc-error alert alert-danger py-2 px-3" id="cn-nc-error" hidden></div>
                <fieldset class="q-nc-section">
                    <legend class="q-nc-section-title">Basic Details</legend>
                    <div class="form-grid form-grid--3col">
                        <div class="form-group">
                            <label class="form-label" for="cn-nc-name">Ledger Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="cn-nc-name" maxlength="191" required>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="cn-nc-save">
                    <i class="fa-solid fa-check me-1"></i>Save Customer
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<%# Products / parties / ledgers / bills for the searchable comboboxes. %>
<script>
    window.RETURN_NOTE_KIND     = <%- JSON.stringify(_kind) %>;
    window.RETURN_NOTE_PRODUCTS = <%- _productsJson %>;
    window.RETURN_NOTE_PARTIES  = <%- _partiesJson %>;
    window.RETURN_NOTE_LEDGERS  = <%- _ledgersJson %>;
    window.RETURN_NOTE_BILLS    = <%- _billsJson %>;
    window.RETURN_NOTE_QUICK_CUSTOMER_URL = '<%= _basePath %>/create/quick-customer';
</script>

<style>
    /* Searchable item picker for return-note rows (same widget/markup as the
       delivery-note/invoice/quotation line-item picker) — kept local to this
       page rather than growing theme.css. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #d1d5db); border-radius: 6px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }
    .li-prod-item { padding: 7px 10px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #eef2ff; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }

    .q-back {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 6px; margin-right: 10px;
        color: #fff; background: rgba(255,255,255,.15); vertical-align: middle;
    }
    .q-back:hover { background: rgba(255,255,255,.28); color: #fff; }

    .q-voucher { overflow: visible; }
    .voucher-head {
        display: flex; align-items: center;
        margin: -24px -28px 16px;
        border-radius: 0;
    }
    .voucher-head span { flex: 0 0 auto; }
    @media (max-width: 767.98px) {
        .voucher-head { margin: -20px -16px 16px; }
    }

    .q-list-btn {
        margin-left: auto;
        display: inline-flex; align-items: center;
        padding: 6px 14px; border-radius: 6px;
        font-size: 12.5px; font-weight: 600;
        color: #fff; background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
    }
    .q-list-btn:hover { background: rgba(255,255,255,.28); color: #fff; }

    .li-prod-clear {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; border: 0; border-radius: 50%;
        background: transparent; color: #9ca3af; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
    }
    .li-prod-clear:hover { background: #f3f4f6; color: #374151; }
    .li-prod-cell:has(.li-prod-clear:not([hidden])) .li-product-search { padding-right: 26px; }

    .li-prod-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .li-prod-item .li-prod-sub { flex: 0 0 auto; text-align: right; }

    .li-prod-item.li-prod-create {
        color: var(--primary); font-weight: 600; gap: 6px;
        border-bottom: 1px solid var(--border, #e5e7eb);
    }
    .li-prod-item.li-prod-create:hover { background: #eef2ff; }
</style>
