<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= (typeof brand !== 'undefined' && brand) ? brand.name : 'Teloora' %></title>
<%#
  THE AGENT'S WINDOW, SERVED FROM HERE.

  The desktop app is a shell around a WebView pointed at this page, so the whole
  interface — sign-in, sync status, settings, logs — changes when this file
  changes. No exe is rebuilt, nothing is re-downloaded by the customer.

  Two things this page talks to, and the split matters:
    - THE API (apiBase) - sign-in. Ordinary HTTPS calls.
    - THE BRIDGE (127.0.0.1:PORT) - anything about THIS computer: is it signed
      in, what is syncing, the log tail, "sync now", "sign out". No cloud
      endpoint can answer those.

  The bridge port and its per-run token arrive in the URL FRAGMENT, which the
  browser never sends to a server. Without them this page still renders, but
  says the app is not connected — which is what a customer would see if they
  opened this URL in a normal browser tab, and is the correct answer there.

  Design is the "Ledger" system the desktop build uses: ink-green chrome, warm
  paper, hairline rules, and every figure monospaced and flush right so a wrong
  number is visible without being read.
-%>
<style>
  :root{
    --ink:#12312C; --ink-deep:#0B211E; --paper:#F3F2ED; --sheet:#FFF;
    --rule:#DAD7CC; --text:#1C1F1D; --muted:#6B7169;
    --stamp:#B4762A; --posted:#2F6B4E; --variance:#9E3B2C;
    --stamp-dim:#F0E6D4; --posted-dim:#E2ECE5; --variance-dim:#F2E2DF;
    --ui:"Segoe UI",system-ui,sans-serif; --data:Consolas,"Cascadia Mono",monospace;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--text);font:14px/1.5 var(--ui)}
  /* No radius anywhere: ruled paper has square corners, and it keeps the
     desktop and web builds looking like one product. */
  button,input,select{border-radius:0;font-family:inherit;font-size:inherit}

  header{background:var(--ink);color:#F3F2ED;padding:18px 24px}
  header h1{margin:0;font-size:17px;font-weight:700;letter-spacing:-.2px}
  header p{margin:3px 0 0;font-size:12.5px;color:#9DB3AC}
  .accent{height:3px;background:var(--stamp)}

  main{max-width:820px;margin:0 auto;padding:24px}
  .eyebrow{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.18em;
           text-transform:uppercase;margin:0 0 8px}
  .rule{height:1px;background:var(--rule)}
  .rule--ink{height:1px;background:var(--ink)}
  .sheet{background:var(--sheet)}

  .row{display:flex;align-items:center;gap:16px;padding:11px 16px}
  .row .name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .fig{font-family:var(--data);text-align:right;min-width:104px;font-variant-numeric:tabular-nums}
  .chip{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
        padding:4px 9px;white-space:nowrap;min-width:84px;text-align:center}
  .chip.synced,.chip.ok{background:var(--posted-dim);color:var(--posted)}
  .chip.syncing,.chip.pending{background:var(--stamp-dim);color:var(--stamp)}
  .chip.failed,.chip.error{background:var(--variance-dim);color:var(--variance)}

  /* The progress bar is a rule that fills — the same hairline vocabulary,
     not a separate widget with its own look. */
  .bar{height:4px;background:var(--rule);margin:14px 0 6px}
  .bar>i{display:block;height:100%;background:var(--ink);width:0;transition:width .35s}
  .bar.is-error>i{background:var(--variance)}
  .pct{font-family:var(--data);font-size:26px;font-weight:700;color:var(--ink);
       font-variant-numeric:tabular-nums}

  button{border:1px solid var(--rule);background:var(--sheet);color:var(--text);
         padding:9px 14px;cursor:pointer}
  button:hover:not(:disabled){border-color:var(--ink);color:var(--ink)}
  button:disabled{opacity:.5;cursor:default}
  button.primary{background:var(--ink);color:#F3F2ED;border-color:var(--ink);font-weight:700;padding:10px 18px}
  button.primary:hover:not(:disabled){background:var(--ink-deep);color:#fff}
  button.danger{background:var(--variance);color:#fff;border-color:var(--variance);font-weight:700}
  button.quiet{border:0;background:transparent;color:var(--muted);padding:8px 4px}
  button.quiet:hover{color:var(--ink);text-decoration:underline}
  :focus-visible{outline:2px solid var(--stamp);outline-offset:2px}

  label{display:block;font-size:12.5px;color:var(--muted);margin:0 0 4px}
  input[type=text],input[type=email],input[type=password],input[type=number]{
    width:100%;padding:9px 10px;border:1px solid var(--rule);background:var(--sheet);color:var(--text)}
  input:focus{outline:0;border-color:var(--ink)}
  .field{margin-bottom:14px}
  .code{font-family:var(--data);font-size:22px;font-weight:700;letter-spacing:.34em;
        text-align:center;width:190px}

  .msg{padding:10px 12px;margin:0 0 14px;font-size:13px;border-left:3px solid}
  .msg.err{background:var(--variance-dim);border-color:var(--variance);color:var(--variance)}
  .msg.ok{background:var(--posted-dim);border-color:var(--posted);color:var(--posted)}
  .msg.info{background:var(--stamp-dim);border-color:var(--stamp);color:var(--stamp)}

  pre.log{background:#0F172A;color:#CBD5E1;font-family:var(--data);font-size:12px;
          padding:12px;margin:0;height:210px;overflow:auto;white-space:pre-wrap}
  .actions{display:flex;gap:10px;align-items:center;margin-top:22px;flex-wrap:wrap}
  .spacer{flex:1}
  .hide{display:none!important}
  .muted{color:var(--muted);font-size:12.5px}
  @media (max-width:520px){ .fig{min-width:74px} main{padding:16px} }
</style>
</head>
<body>

<header>
  <h1><%= (typeof brand !== 'undefined' && brand) ? brand.name : 'Teloora' %></h1>
  <p id="subtitle">Starting…</p>
</header>
<div class="accent"></div>

<main>
  <div id="msg" class="msg hide" role="status" aria-live="polite"></div>

  <!-- ── Not connected to the desktop app ───────────────────── -->
  <section id="screen-detached" class="hide">
    <p class="eyebrow">Not connected</p>
    <div class="rule"></div>
    <p style="margin:14px 0 0">
      This page is the <%= (typeof brand !== 'undefined' && brand) ? brand.name : 'Teloora' %> window. Open the app on the computer
      that runs Tally — this address on its own cannot reach it.
    </p>
  </section>

  <!-- ── Sign in ────────────────────────────────────────────── -->
  <section id="screen-signin" class="hide">
    <p class="eyebrow">Sign in</p>
    <div class="rule"></div>
    <form id="form-signin" style="margin-top:16px" autocomplete="on">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password">
      </div>
      <div class="actions">
        <button type="submit" class="primary" id="btn-signin">Continue</button>
        <span class="muted">We'll email a 6-digit code to confirm this computer.</span>
      </div>
    </form>
  </section>

  <!-- ── Code ───────────────────────────────────────────────── -->
  <section id="screen-code" class="hide">
    <p class="eyebrow">Check your email</p>
    <div class="rule"></div>
    <p style="margin:14px 0 4px">We sent a 6-digit code to <b id="masked"></b>.</p>
    <p class="muted" style="margin:0 0 14px">It expires in 10 minutes.</p>
    <form id="form-code" autocomplete="off">
      <input id="code" class="code" inputmode="numeric" maxlength="6"
             aria-label="6-digit code">
      <div class="actions">
        <button type="submit" class="primary" id="btn-verify">Verify &amp; connect</button>
        <button type="button" id="btn-resend">Resend code</button>
        <button type="button" class="quiet" id="btn-back">Back</button>
      </div>
    </form>
  </section>

  <!-- ── Dashboard ──────────────────────────────────────────── -->
  <section id="screen-dash" class="hide">
    <p class="eyebrow">This cycle</p>
    <div class="rule"></div>
    <div style="display:flex;align-items:baseline;gap:12px;margin-top:12px">
      <span class="pct" id="pct">—</span>
      <span class="muted" id="phase">idle</span>
    </div>
    <div class="bar" id="bar"><i></i></div>

    <div class="sheet" id="modules" style="margin-top:18px"></div>
    <div class="rule--ink"></div>
    <div class="row" style="padding-left:0;padding-right:0">
      <span class="eyebrow" style="margin:0;flex:1">Total records</span>
      <span class="fig" id="total">—</span>
      <span style="min-width:84px"></span>
    </div>

    <div class="actions">
      <button class="primary" id="btn-sync">Sync now</button>
      <button id="btn-settings">Settings</button>
      <span class="spacer"></span>
      <button class="quiet" id="btn-signout">Sign out this computer</button>
    </div>

    <p class="eyebrow" style="margin-top:26px">Activity</p>
    <div class="rule"></div>
    <pre class="log" id="log" tabindex="0">…</pre>
  </section>

  <!-- ── Settings ───────────────────────────────────────────── -->
  <section id="screen-settings" class="hide">
    <p class="eyebrow">Settings</p>
    <div class="rule"></div>
    <form id="form-settings" style="margin-top:16px">
      <div class="field">
        <label for="tally_url">Tally address</label>
        <input id="tally_url" type="text" placeholder="http://localhost:9000">
      </div>
      <div class="field">
        <label for="sync_interval">Sync every (seconds)</label>
        <input id="sync_interval" type="number" min="10" step="10">
      </div>
      <div class="field">
        <label><input type="checkbox" id="auto_update" style="width:auto;margin-right:8px">Keep the agent up to date automatically</label>
      </div>
      <div class="actions">
        <button type="submit" class="primary">Save</button>
        <button type="button" class="quiet" id="btn-settings-back">Back</button>
      </div>
    </form>
  </section>
</main>

<script>
(function () {
  'use strict';

  var API = <%- JSON.stringify(apiBase) %>;

  // Bridge coordinates arrive in the fragment. Read once, then WIPE it from the
  // address bar: the token should not sit in a URL the customer might copy,
  // screenshot, or leave in browser history.
  var frag = new URLSearchParams(location.hash.replace(/^#/, ''));
  var PORT = frag.get('port');
  var TOKEN = frag.get('token');
  if (PORT && TOKEN && history.replaceState) {
    history.replaceState(null, '', location.pathname + location.search);
  }
  var BRIDGE = PORT ? 'http://127.0.0.1:' + PORT + '/' : null;

  var el = function (id) { return document.getElementById(id); };
  var screens = ['detached', 'signin', 'code', 'dash', 'settings'];
  var state = { challenge: null, machine: null, polling: null };

  function show(name) {
    screens.forEach(function (s) {
      el('screen-' + s).classList.toggle('hide', s !== name);
    });
    // Polling only matters on the dashboard; leaving it running behind the
    // settings form would fight the customer's typing on every tick.
    if (name !== 'dash') stopPolling();
  }

  function say(text, kind) {
    var box = el('msg');
    if (!text) { box.classList.add('hide'); return; }
    box.textContent = text;
    box.className = 'msg ' + (kind || 'info');
  }

  // -- transports ------------------------------------------------------- //
  async function api(path, body) {
    var resp;
    try {
      resp = await fetch(API + '/' + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {}),
      });
    } catch (e) {
      // No server was reached, so there is no server message to show. This one
      // string is ours; everything else below is the server's, verbatim.
      throw new Error('Cannot reach the server. Check the internet connection.');
    }
    var data = await resp.json().catch(function () { return {}; });
    if (data.status !== 200) throw new Error(data.msg || 'Something went wrong.');
    return data.data || {};
  }

  async function bridge(path, body) {
    if (!BRIDGE) throw new Error('The app is not connected.');
    var resp = await fetch(BRIDGE + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + TOKEN },
      body: JSON.stringify(body || {}),
    });
    var data = await resp.json().catch(function () { return {}; });
    if (!resp.ok) throw new Error(data.error || 'The app did not respond.');
    return data.data;
  }

  // -- sign in ---------------------------------------------------------- //
  // NOTHING is validated here. Whatever is typed goes to the server and the
  // server's message is shown as-is, so the rules live in one place.
  el('form-signin').addEventListener('submit', async function (ev) {
    ev.preventDefault();
    var btn = el('btn-signin');
    btn.disabled = true; say('');
    try {
      var out = await api('agent/login', {
        email: el('email').value,
        password: el('password').value,
        machine_id: state.machine.machine_id,
        machine_name: state.machine.machine_name,
        agent_version: state.machine.agent_version,
      });
      state.challenge = out.challenge_id;
      el('masked').textContent = out.email_masked || 'your address';
      show('code');
      el('code').focus();
    } catch (e) {
      // The form keeps what was typed: re-entering an email because a password
      // was wrong is its own small insult.
      say(e.message, 'err');
    } finally { btn.disabled = false; }
  });

  el('form-code').addEventListener('submit', async function (ev) {
    ev.preventDefault();
    var btn = el('btn-verify');
    btn.disabled = true; say('');
    try {
      var out = await api('agent/verify', {
        challenge_id: state.challenge,
        code: el('code').value,
        machine_id: state.machine.machine_id,
        machine_name: state.machine.machine_name,
        agent_version: state.machine.agent_version,
      });
      // The token is handed to the AGENT, which stores it encrypted and
      // machine-bound. It is never put in localStorage — a browser store would
      // survive sign-out and be readable by anything sharing the origin.
      await bridge('save-token', { agent_token: out.agent_token, agent_id: out.agent_id });
      say('This computer is connected.', 'ok');
      await enterDashboard();
    } catch (e) {
      say(e.message, 'err');
    } finally { btn.disabled = false; }
  });

  el('btn-resend').addEventListener('click', async function () {
    var btn = el('btn-resend');
    btn.disabled = true;
    try {
      await api('agent/otp/resend', { challenge_id: state.challenge });
      say('A new code is on its way.', 'ok');
    } catch (e) { say(e.message, 'err'); }
    // The cooldown is the SERVER's rule. Re-enabling after a fixed delay here
    // would only guess at it, so the button comes back and the server refuses
    // if it is still too early.
    setTimeout(function () { btn.disabled = false; }, 3000);
  });

  el('btn-back').addEventListener('click', function () { say(''); show('signin'); });

  // -- dashboard -------------------------------------------------------- //
  function renderStatus(s) {
    el('subtitle').textContent = s.company
      ? s.company + ' · ' + (s.last_sync || 'not synced yet')
      : (s.last_sync || 'Waiting for the first sync');

    var pct = Number(s.percent);
    el('pct').textContent = isFinite(pct) ? Math.round(pct) + '%' : '—';
    el('phase').textContent = s.phase || 'idle';
    el('bar').classList.toggle('is-error', s.state === 'failed');
    el('bar').firstElementChild.style.width = (isFinite(pct) ? Math.max(0, Math.min(100, pct)) : 0) + '%';

    var box = el('modules');
    box.textContent = '';
    (s.modules || []).forEach(function (m, i) {
      var row = document.createElement('div');
      row.className = 'row';

      var name = document.createElement('span');
      name.className = 'name';
      name.textContent = m.label;

      var fig = document.createElement('span');
      fig.className = 'fig';
      fig.textContent = (m.count == null) ? '—' : Number(m.count).toLocaleString('en-IN');

      var chip = document.createElement('span');
      chip.className = 'chip ' + (m.state || 'pending');
      chip.textContent = m.state || 'pending';

      row.append(name, fig, chip);
      box.append(row);
      if (i < s.modules.length - 1) {
        var hr = document.createElement('div');
        hr.className = 'rule';
        box.append(hr);
      }
    });

    el('total').textContent = (s.total == null) ? '—' : Number(s.total).toLocaleString('en-IN');
    if (typeof s.log === 'string') {
      var log = el('log');
      // Only auto-scroll when the customer is already at the bottom; yanking
      // the view while they are reading further up is infuriating.
      var atBottom = log.scrollTop + log.clientHeight >= log.scrollHeight - 24;
      log.textContent = s.log;
      if (atBottom) log.scrollTop = log.scrollHeight;
    }
  }

  async function poll() {
    try {
      renderStatus(await bridge('status') || {});
      say('');
    } catch (e) {
      say(e.message, 'err');
    }
  }

  function startPolling() { stopPolling(); poll(); state.polling = setInterval(poll, 2000); }
  function stopPolling() { if (state.polling) { clearInterval(state.polling); state.polling = null; } }
  // A hidden window does not need to poll; this is a background service and the
  // customer is not looking at it most of the time.
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopPolling();
    else if (!el('screen-dash').classList.contains('hide')) startPolling();
  });

  async function enterDashboard() { show('dash'); startPolling(); }

  el('btn-sync').addEventListener('click', async function () {
    var btn = el('btn-sync');
    btn.disabled = true;
    try { await bridge('sync-now'); say('Sync started.', 'ok'); poll(); }
    catch (e) { say(e.message, 'err'); }
    finally { btn.disabled = false; }
  });

  el('btn-signout').addEventListener('click', async function () {
    if (!confirm('Sign this computer out?\n\nSyncing stops until you sign in again.')) return;
    try {
      await bridge('sign-out');
      say('Signed out.', 'ok');
      show('signin');
    } catch (e) { say(e.message, 'err'); }
  });

  // -- settings --------------------------------------------------------- //
  el('btn-settings').addEventListener('click', async function () {
    try {
      var s = await bridge('get-settings') || {};
      el('tally_url').value = s.tally_url || '';
      el('sync_interval').value = s.sync_interval || 60;
      el('auto_update').checked = !!s.auto_update;
      say(''); show('settings');
    } catch (e) { say(e.message, 'err'); }
  });

  el('btn-settings-back').addEventListener('click', function () { say(''); enterDashboard(); });

  el('form-settings').addEventListener('submit', async function (ev) {
    ev.preventDefault();
    try {
      await bridge('save-settings', {
        tally_url: el('tally_url').value,
        sync_interval: el('sync_interval').value,
        auto_update: el('auto_update').checked,
      });
      say('Saved.', 'ok');
      enterDashboard();
    } catch (e) { say(e.message, 'err'); }
  });

  // -- boot ------------------------------------------------------------- //
  (async function boot() {
    if (!BRIDGE) { show('detached'); el('subtitle').textContent = 'Not connected'; return; }
    try {
      // The agent is the authority on whether this machine is signed in. Asking
      // it (rather than remembering in the page) means a sign-out performed
      // elsewhere is reflected the next time this window opens.
      state.machine = await bridge('machine') || {};
      if (state.machine.signed_in) await enterDashboard();
      else { el('subtitle').textContent = 'Connect this computer'; show('signin'); }
    } catch (e) {
      show('detached');
      el('subtitle').textContent = 'Not connected';
      say(e.message, 'err');
    }
  })();
})();
</script>
</body>
</html>
