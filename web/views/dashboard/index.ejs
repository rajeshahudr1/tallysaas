<%
/* ─────────────────────────────────────────────────────────────
 * dashboard/index.ejs — PAGE 3: Dashboard (spec §6).
 *
 * Composes the dashboard screen entirely from theme.css component
 * classes + the shared partials, driven by the locals the route
 * (routes/web.js → GET /) injects from data/mock.js:
 *
 *   title, activeMenu, breadcrumb   (header/sidebar — via _layout)
 *   summaryPanel   { title, tone, control, tiles[] }  — Summary panel
 *   attentionPanel { title, tone, control, tiles[] }  — Need Attention panel
 *   stats          [{ label, value, icon, tone }]     — customer portal only
 *   salesChart     { labels[], data[] }              — line chart
 *   syncChart      { labels[], data[] }              — doughnut
 *   recentInvoices [{ invoice, customer, amount, status, date }]
 *   recentSync     [{ module, record, status, time }]
 *
 * Layout, top → bottom:
 *   1. page-head (title + breadcrumb + a visual date-range pill)
 *   2. .kpi-row      — Summary + Need Attention panels (kpi-panel partial)
 *                      (customer portal keeps the classic .stat-grid)
 *   3. .chart-row    — Sales Overview (line) + Tally Sync Status (doughnut)
 *   4. .recent-row   — Recent Invoices (Table component) + Recent Sync Activity
 *
 * Charts: each chart fragment carries its own JSON island, read by
 * /js/dashboard.js (Chart.js init), so the canvases stay declarative
 * here and a fragment swap brings its numbers along. dashboard.js is
 * pulled in via the layout's `pageScript` slot (defined at the bottom
 * of this file) so it only loads on this page.
 *
 * Only classes that already exist in public/css/theme.css are used.
 * The small <style> block below adds one cosmetic helper the spec
 * implies (a status dot for the sync list) that was not present in
 * theme.css — kept intentionally minimal.
 * ─────────────────────────────────────────────────────────── */

// Guard every optional local so a missing-locals render never crashes.
// welcomeOnly → a signed-in user whose role has NO Dashboard module: show a
// friendly welcome instead of the KPI cards/charts (which they can't load).
var _welcomeOnly = (typeof welcomeOnly !== 'undefined' && welcomeOnly);
// statsOnly → stat cards only (no charts / recent sections) — the customer
// portal's simple dashboard (My Categories / My Products / My Invoices).
var _statsOnly = (typeof statsOnly !== 'undefined' && statsOnly);
var _welcomeName = (typeof welcomeName !== 'undefined' && welcomeName) ? welcomeName : 'there';
var _stats          = (typeof stats !== 'undefined' && stats) ? stats : [];
var _salesChart     = (typeof salesChart !== 'undefined' && salesChart) ? salesChart : { labels: [], data: [] };
var _syncChart      = (typeof syncChart !== 'undefined' && syncChart) ? syncChart : { labels: [], data: [] };
var _recentInvoices = (typeof recentInvoices !== 'undefined' && recentInvoices) ? recentInvoices : [];
var _recentSync     = (typeof recentSync !== 'undefined' && recentSync) ? recentSync : [];
var _summaryPanel   = (typeof summaryPanel   !== 'undefined' && summaryPanel)   ? summaryPanel   : null;
var _attentionPanel = (typeof attentionPanel !== 'undefined' && attentionPanel) ? attentionPanel : null;
// Row 2 — Sales & Receipt + Receivables. Both arrive pre-formatted from the
// route (currency strings, delta captions, legend colours) so this template
// stays presentational.
var _sr = (typeof salesReceipt !== 'undefined' && salesReceipt) ? salesReceipt : {
    total_sales: '₹0', total_receipt: '₹0',
    sales_this_month: '₹0', receipt_this_month: '₹0',
    sales_delta: null, receipt_delta: null,
};
var _recv = (typeof receivables !== 'undefined' && receivables) ? receivables : {
    total: '₹0', overdue: '₹0', projection_15: '₹0', projection_60: '₹0', buckets: [],
};
// The Summary panel's range <select>, reused verbatim in the Sales & Receipt
// header so both dropdowns drive the same ?range= param.
var _rangeControl = (_summaryPanel && _summaryPanel.control) ? _summaryPanel.control : '';
// Row 3 — Top 10 tabs + Day Book, both pre-formatted by the route.
var _top10 = (typeof top10Tabs !== 'undefined' && Array.isArray(top10Tabs)) ? top10Tabs : [];
var _dayBook = (typeof dayBook !== 'undefined' && dayBook) ? dayBook : {
    date: '', today: '', yesterday: '', active: 'today', rows: [],
};

// Recent Invoices renders as a compact table (same markup as the Day Book
// panel) rather than through the shared table partial — the dashboard wants
// a dense read-only list, not the full list-page chrome.
// Status → the shared pill modifier, mirroring the table partial's mapping.
function _statusPill(v) {
    var s = String(v || '').toLowerCase();
    if (s.indexOf('fail') !== -1)    return 'pill-status--danger';
    if (s.indexOf('pending') !== -1) return 'pill-status--warning';
    if (s.indexOf('creat') !== -1 || s.indexOf('sync') !== -1) return 'pill-status--success';
    return 'pill-status--muted';
}

// Trend caption for a stat card — built ONLY from a real `delta` the caller
// attached to that stat ({ dir, pct, caption }). No delta → no trend, ever;
// there is no hard-coded fallback table here any more (that was the bug).
function _trendText(delta) {
    if (!delta) return '';
    if (delta.pct == null) return delta.caption || '';
    var sign = delta.dir === 'down' ? '-' : '+';
    return sign + delta.pct + '%' + (delta.caption ? ' ' + delta.caption : '');
}

// Map a sync-row status → an existing pill-status modifier class
// (Synced→green, Pending→amber, Failed→red) — same vocabulary the
// table component uses, reused here for the compact activity list.
function _syncPillClass(v) {
    var s = String(v || '').toLowerCase();
    if (s === 'synced')  return 'pill-status--success';
    if (s === 'failed')  return 'pill-status--danger';
    if (s === 'pending') return 'pill-status--warning';
    return 'pill-status--muted';
}

// No sparkline helper here any more: it only ever drew a fabricated
// 7-point series (no stat currently carries a real history array), and a
// fake line is worse than no line. If a real series becomes available for a
// stat, re-add a renderer that draws THAT data — not before.
%>

<!-- The date range lives in the Summary / Sales & Receipt panel headers
     (?range=this_year etc). Ledger balances are point-in-time and ignore it. -->

<!-- ─────────────────────────────────────────────────────────────
     One cosmetic helper not present in theme.css:
       .sync-status-dot — small coloured status dot for the activity
                          list (mirrors the pill colours).
     Everything else uses existing theme.css classes.
     ───────────────────────────────────────────────────────────── -->
<style>
    .sync-status-dot {
        width: 8px; height: 8px; border-radius: 50%;
        display: inline-block; flex: 0 0 auto;
    }
    .sync-status-dot--success { background: var(--success); }
    .sync-status-dot--danger  { background: var(--danger); }
    .sync-status-dot--warning { background: var(--warning); }
    .sync-status-dot--muted   { background: var(--text-muted); }
    .sync-list-status {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 12px; font-weight: 600;
    }
</style>

<!-- ── 1. Page head ──────────────────────────────────────────────
     Intentionally OMITTED on the dashboard: the "Dashboard / Dashboard"
     title + breadcrumb only repeated the sidebar's active item, so the
     content starts straight at the KPI row. Every other page still uses
     partials/page-head. -->

<% if (_welcomeOnly) { %>
<!-- ── Welcome (role has no Dashboard module) ─────────────────── -->
<section class="card welcome-card">
    <div class="welcome-icon"><i class="fa-solid fa-hand-sparkles"></i></div>
    <h2 class="welcome-title">Welcome, <%= _welcomeName %>! 👋</h2>
    <p class="welcome-text">
        You're signed in. Use the menu on the left to open the sections you have access to.
    </p>
    <p class="welcome-sub">
        The KPI dashboard isn't part of your role — if you need it, ask your administrator to grant the Dashboard permission.
    </p>
</section>
<style>
    .welcome-card { text-align:center; padding:48px 24px; max-width:640px; margin:24px auto; }
    .welcome-icon { font-size:44px; color:#2563eb; margin-bottom:14px; }
    .welcome-title { font-size:22px; font-weight:800; color:#1f2937; margin:0 0 10px; }
    .welcome-text { font-size:15px; color:#374151; margin:0 0 8px; }
    .welcome-sub { font-size:13px; color:#6b7280; margin:0; }
</style>
<% } else { %>
<!-- ── 2. KPI panels — Summary + Need Attention ───────────────── -->
<% if (_statsOnly) { %>
    <!-- Customer portal keeps the classic stat cards (My Categories /
         My Products / My Invoices) — only the main dashboard uses panels. -->
    <section class="stat-grid">
        <% _stats.forEach(function (s) { %>
            <% var d = s.delta; var trendText = _trendText(d); %>
            <% if (s.href) { %><a href="<%= s.href %>" class="stat-card-link"><% } %>
            <article class="stat-card stat-card--<%= s.tone %> <%= s.href ? 'stat-card--clickable' : '' %>">
                <div class="stat-card-top">
                    <span class="stat-icon"><i class="fa-solid <%= s.icon %>"></i></span>
                    <% if (d && trendText) { %>
                        <span class="stat-trend <%= d.dir === 'down' ? 'is-down' : '' %>">
                            <i class="fa-solid <%= d.dir === 'down' ? 'fa-arrow-trend-down' : 'fa-arrow-trend-up' %>"></i>
                            <%= trendText %>
                        </span>
                    <% } %>
                </div>
                <div>
                    <div class="stat-label"><%= s.label %></div>
                    <div class="stat-value"><%= s.value %></div>
                </div>
            </article>
            <% if (s.href) { %></a><% } %>
        <% }); %>
    </section>
    <style>
        .stat-card-link { text-decoration: none; color: inherit; display: block; }
        .stat-card--clickable { cursor: pointer; transition: transform .12s ease, box-shadow .12s ease; }
        .stat-card--clickable:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.08); }
    </style>
<% } else { %>
    <%- include('_summary') %>
<% } %>

<% if (!_statsOnly) { %>
<!-- ── 3. Sales & Receipt + Receivables ───────────────────────── -->
<section class="chart-row">
    <%- include('_sales-receipt') %>
    <%- include('_receivables') %>
</section>

<!-- ── 4. Top 10 + Day Book ───────────────────────────────────── -->
<section class="recent-row">
    <%- include('_top10') %>
    <%- include('_daybook') %>
</section>

<!-- ── 5. KPI stat cards — Today's Sales / Total Customers / Total
     Products / Total Companies / Invoice Amount / Payment Received.
     Below the six LiveKeeping panels (Task 2); each trend comes ONLY
     from a real `delta` the route attached to that stat (Task 1's
     _trendText rule) — no delta, no trend, ever. ── -->
<% if (_stats.length) { %>
<section class="stat-grid">
    <% _stats.forEach(function (s) { %>
        <% var d = s.delta; var trendText = _trendText(d); %>
        <% if (s.href) { %><a href="<%= s.href %>" class="stat-card-link"><% } %>
        <article class="stat-card stat-card--<%= s.tone %> <%= s.href ? 'stat-card--clickable' : '' %>">
            <div class="stat-card-top">
                <span class="stat-icon"><i class="fa-solid <%= s.icon %>"></i></span>
                <% if (d && trendText) { %>
                    <span class="stat-trend <%= d.dir === 'down' ? 'is-down' : '' %>">
                        <i class="fa-solid <%= d.dir === 'down' ? 'fa-arrow-trend-down' : 'fa-arrow-trend-up' %>"></i>
                        <%= trendText %>
                    </span>
                <% } %>
            </div>
            <div>
                <div class="stat-label"><%= s.label %></div>
                <div class="stat-value"><%= s.value %></div>
            </div>
        </article>
        <% if (s.href) { %></a><% } %>
    <% }); %>
</section>
<% } %>

<!-- ── 6. Recent row (Recent Invoices + Recent Sync Activity) ── -->
<section class="recent-row">

    <!-- Recent Invoices — rendered through the shared Table component -->
    <div class="card recent-card">
        <div class="recent-card-head">
            <h2 class="recent-card-title">Recent Invoices</h2>
            <a href="/sales-invoices" class="recent-card-link">View all</a>
        </div>
        <% if (!_recentInvoices.length) { %>
            <p class="daybook-empty">No data available</p>
        <% } else { %>
            <div class="daybook-scroll">
                <table class="daybook-table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="is-num">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% _recentInvoices.forEach(function (r) { %>
                            <tr>
                                <td>
                                    <% if (r.href) { %>
                                        <a class="daybook-voucher" href="<%= r.href %>"><%= r.invoice %></a>
                                    <% } else { %><%= r.invoice %><% } %>
                                </td>
                                <td><%= r.customer %></td>
                                <td><span class="pill-status <%= _statusPill(r.status) %>"><%= r.status %></span></td>
                                <td><%= r.date %></td>
                                <td class="is-num"><%= r.amount %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Recent Sync Activity — compact list (Module · Record · Status · Time) -->
    <div class="card recent-card">
        <div class="recent-card-head">
            <h2 class="recent-card-title">Recent Sync Activity</h2>
            <a href="/sync-logs" class="recent-card-link">View logs</a>
        </div>
        <ul class="sync-list">
            <% _recentSync.forEach(function (row) { %>
                <% var cls = _syncPillClass(row.status); %>
                <% var dot = cls.replace('pill-status--', 'sync-status-dot--'); %>
                <li>
                    <% var tag = row.href ? 'a' : 'div'; %>
                    <<%= tag %> class="sync-list-item"<% if (row.href) { %> href="<%= row.href %>"<% } %>>
                        <span class="sync-list-icon"><i class="fa-solid fa-rotate"></i></span>
                        <div class="sync-list-main">
                            <div class="sync-list-module"><%= row.module %></div>
                            <div class="sync-list-record"><%= row.record %></div>
                        </div>
                        <div class="sync-list-meta">
                            <span class="sync-list-status">
                                <span class="sync-status-dot <%= dot %>"></span>
                                <span class="pill-status <%= cls %>"><%= row.status %></span>
                            </span>
                            <div class="sync-list-time"><%= row.time %></div>
                        </div>
                    </<%= tag %>>
                </li>
            <% }); %>
        </ul>
    </div>
</section>

<!-- Chart data now lives INSIDE each chart fragment (data-chart="…"), so an
     AJAX panel swap carries its own numbers with it. /js/dashboard.js is
     injected via the layout's `pageScript` slot (a render local from
     routes/web.js), which renders AFTER the Chart.js CDN tag. It must NOT be
     set from inside this template: express-ejs-layouts rebuilds the layout's
     locals from the render options, so a template assignment never lands. -->
<% } /* end !_statsOnly */ %>
<% } %>
