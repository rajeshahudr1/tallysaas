<%
/* ─────────────────────────────────────────────────────────────
 * views/sales-orders/create.ejs — TRANSACTIONS · Create Sales Order Voucher.
 * Route: GET /sales-orders/create  ·  activeMenu: 'sales-orders'.
 *
 * Own copy of views/quotations/create.ejs — same layout/behaviour (full-bleed
 * header, Party/Ledger/No row, Date row, items grid, two collapsible strips,
 * right-hand totals panel) with an `so-` DOM-hook prefix instead of `q-`, and
 * a second header row of Date + Due On (Sales Order has no "Valid Till").
 * Task 4's /js/sales-order.js binds to these ids/classes verbatim.
 *
 * Expected locals (routes/web.js → res.render):
 *   customerOptions / locationOptions / salesPersonOptions — header selects
 *   invoiceProducts [{id,name,hsn,unit,rate,gst,stock}]    — line-item picker
 *   salesLedgerOptions / ledgerGroupOptions / gstRegistrationTypes
 *   nextSalesOrderNo string                                  — read-only no.
 * ─────────────────────────────────────────────────────────── */

var _custs    = (typeof customerOptions !== 'undefined' && customerOptions) ? customerOptions : [];
var _locs     = (typeof locationOptions !== 'undefined' && locationOptions) ? locationOptions : [];
var _sps      = (typeof salesPersonOptions !== 'undefined' && salesPersonOptions) ? salesPersonOptions : [];
var _products = (typeof invoiceProducts !== 'undefined' && invoiceProducts) ? invoiceProducts : [];
var _ledgers  = (typeof salesLedgerOptions !== 'undefined' && salesLedgerOptions) ? salesLedgerOptions : [];
var _soNo     = (typeof nextSalesOrderNo !== 'undefined' && nextSalesOrderNo) ? nextSalesOrderNo : '';
var _ncLedgerGroups = (typeof ledgerGroupOptions !== 'undefined' && ledgerGroupOptions) ? ledgerGroupOptions : [];
var _ncGstRegTypes  = (typeof gstRegistrationTypes !== 'undefined' && gstRegistrationTypes) ? gstRegistrationTypes : [];

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* Products as a JS array for the searchable line-item picker. */
var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : 0) };
}));

/* Party + sales-ledger options for the header comboboxes (auto-advance flow). */
var _partiesJson = JSON.stringify(_custs.map(function (c) { return { id: c.id, name: c.name }; }));
var _ledgersJson = JSON.stringify(_ledgers.map(function (l) { return { id: l.id, name: l.name, parent: l.parent || '' }; }));

var _today = new Date().toISOString().slice(0, 10);
%>

<form id="sales-order-form" method="post" action="/sales-orders" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/sales-order.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

        <div class="voucher-head">
            <a class="q-back" href="/sales-orders" title="Back to sales orders" aria-label="Back to sales orders">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <span>Create Sales Order Voucher</span>
            <a class="q-list-btn" href="/sales-orders">
                <i class="fa-solid fa-list-ul me-1"></i>View Sales Orders
            </a>
        </div>

        <div class="inv-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="so-party">Customer Name<span class="req">*</span></label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="so-party"
                               placeholder="Search customer…" autocomplete="off" required>
                        <input type="hidden" name="customer_id" id="so-party-id">
                        <button type="button" class="li-prod-clear" id="so-party-clear" title="Clear customer" aria-label="Clear customer" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="li-prod-menu" id="so-party-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="so-ledger">Ledger Type</label>
                    <div class="li-prod-cell">
                        <input type="text" class="form-control li-product-search" id="so-ledger" name="ledger_name"
                               placeholder="<%= _ledgers.length ? 'Search ledger…' : 'No ledgers synced yet' %>"
                               autocomplete="off" disabled>
                        <div class="li-prod-menu" id="so-ledger-menu" hidden></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="so-no">Order No</label>
                    <div class="q-no-wrap">
                        <input type="text" class="form-control" id="so-no" name="order_no"
                               value="" placeholder="<%= _esc(_soNo || 'Auto-generated on save') %>" readonly>
                        <button type="button" class="q-no-edit" id="so-no-edit" title="Edit order no" aria-label="Edit order no">
                            <i class="fa-solid fa-pen"></i>
                        </button>

                        <!-- ── Default/Custom order-no popup — same registerPopup()/
                             closeAllPopups() gate as every other dropdown on this page
                             (outside click / Esc close it too). -->
                        <div class="q-no-popup" id="so-no-popup" hidden>
                            <div class="q-no-popup-radios">
                                <label class="q-no-radio">
                                    <input type="radio" name="so-no-mode" id="so-no-mode-default" value="default" checked>
                                    <span>Default</span>
                                </label>
                                <label class="q-no-radio">
                                    <input type="radio" name="so-no-mode" id="so-no-mode-custom" value="custom">
                                    <span>Custom</span>
                                </label>
                            </div>
                            <div class="q-no-popup-fields" id="so-no-popup-fields" hidden>
                                <div class="q-no-field">
                                    <label for="so-no-prefix">Prefix</label>
                                    <input type="text" class="form-control" id="so-no-prefix" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="so-no-number">Voucher no</label>
                                    <input type="text" class="form-control" id="so-no-number" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="so-no-suffix">Suffix</label>
                                    <input type="text" class="form-control" id="so-no-suffix" maxlength="20" autocomplete="off">
                                </div>
                            </div>
                            <div class="q-no-popup-actions">
                                <button type="button" class="btn btn-light btn-sm" id="so-no-cancel">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm" id="so-no-save">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="so-date">Date<span class="req">*</span></label>
                    <input type="date" class="form-control" id="so-date" name="order_date" value="<%= _today %>" required disabled>
                </div>

                <div class="form-group">
                    <label class="form-label" for="so-due-on">Due On</label>
                    <input type="date" class="form-control" id="so-due-on" name="due_on">
                </div>
            </div>
        </div>

        <!-- ════ Items table ════ -->
        <div class="li-table-wrap">
            <table class="q-table">
                <thead>
                    <tr>
                        <th>Items</th>
                        <th class="num">Qty</th>
                        <th class="num">Rate</th>
                        <th>Units</th>
                        <th class="num">Disc %</th>
                        <th>HSN Code</th>
                        <th>Godown</th>
                        <th>Description</th>
                        <th class="num">Amount</th>
                        <th class="center">Tax Incl.</th>
                        <th class="center">
                            <button type="button" class="q-add-btn" id="so-add-row" title="Add row" aria-label="Add row" disabled>
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <!-- Rows are injected by /js/sales-order.js from the template below. -->
                <tbody id="so-body"></tbody>
            </table>
        </div>

        <!-- ════ Collapsible strips ════ -->
        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#so-narration" aria-expanded="false">
                <span>Narration</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="so-narration">
                <div class="q-collapse-body">
                    <textarea class="form-control" id="so-notes" name="notes" rows="3"
                              maxlength="2000" placeholder="Narration for this sales order…"></textarea>
                </div>
            </div>
        </div>

        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#so-advanced" aria-expanded="false">
                <span>Advanced Settings</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="so-advanced">
                <div class="q-collapse-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="so-location">Location</label>
                            <select class="form-select" id="so-location" name="location_id">
                                <option value="" selected>Select location</option>
                                <% _locs.forEach(function (o) { %>
                                    <option value="<%= o.id %>"><%= _esc(o.name) %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-sp">Sales Person</label>
                            <select class="form-select" id="so-sp" name="sales_person_id">
                                <option value="" selected>Select sales person</option>
                                <% _sps.forEach(function (o) { %>
                                    <option value="<%= o.id %>"><%= _esc(o.name) %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Footer — right-hand totals panel + Create Voucher ════ -->
        <div class="inv-foot q-foot">
            <div></div>

            <div class="q-totals">
                <div class="q-total-row">
                    <span class="lbl">Sub Total</span><span class="val" id="so-subtotal">₹0.00</span>
                </div>
                <div class="q-total-row">
                    <span class="lbl">Taxes</span><span class="val" id="so-taxes">₹0.00</span>
                </div>
                <div class="q-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="so-grand">₹0.00</span>
                </div>
            </div>
        </div>

        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="/sales-orders">Cancel</a>
            <button type="submit" class="btn btn-primary" id="so-submit">
                <i class="fa-solid fa-cloud-arrow-up me-1"></i>Create Voucher
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/sales-order.js) ─────────── -->
<template id="so-row-tpl">
    <tr class="so-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search so-item-search" placeholder="Search item…" autocomplete="off" disabled>
            <input type="hidden" class="so-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="number" class="so-qty li-num" min="0" step="1" value="1" disabled></td>
        <td><input type="number" class="so-rate li-num" min="0" step="0.01" value="0" disabled></td>
        <td><input type="text" class="so-unit" readonly placeholder="—"></td>
        <td><input type="number" class="so-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><input type="text" class="so-hsn" readonly placeholder="—"></td>
        <td><input type="text" class="so-godown" placeholder="Godown"></td>
        <td><input type="text" class="so-desc" placeholder="Description"></td>
        <td><span class="so-amount li-cell-calc">₹0.00</span></td>
        <td class="center"><input type="checkbox" class="so-taxincl" title="Tax inclusive"></td>
        <td class="center">
            <button type="button" class="so-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<!-- ── "Create New Customer" modal — pinned row atop the Party list.
     Fields mirror what POST /sales-orders/create/quick-customer forwards to
     the real customers API: name (required) + the obviously-useful optionals. -->
<div class="modal fade" id="so-new-customer-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="q-nc-error alert alert-danger py-2 px-3" id="so-nc-error" hidden></div>

                <fieldset class="q-nc-section">
                    <legend class="q-nc-section-title">Basic Details</legend>
                    <div class="form-grid form-grid--3col">
                        <div class="form-group">
                            <label class="form-label" for="so-nc-gst">GST Number</label>
                            <input type="text" class="form-control text-uppercase" id="so-nc-gst" maxlength="30"
                                   data-gst-autofill data-gst-state="#so-nc-state" data-gst-country="#so-nc-country">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-name">Ledger Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="so-nc-name" maxlength="191" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-ledger-group">Ledger Group</label>
                            <% if (_ncLedgerGroups.length) { %>
                            <input type="text" class="form-control" id="so-nc-ledger-group" list="so-nc-ledger-group-options" placeholder="Search a Tally group" maxlength="191" autocomplete="off">
                            <datalist id="so-nc-ledger-group-options">
                                <% _ncLedgerGroups.forEach(function (g) { %><option value="<%= g %>"><% }); %>
                            </datalist>
                            <% } else { %>
                            <input type="text" class="form-control" id="so-nc-ledger-group" placeholder="e.g. Sundry Debtors" maxlength="191">
                            <% } %>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-mobile">Mobile</label>
                            <input type="text" class="form-control" id="so-nc-mobile" maxlength="30">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-email">Email</label>
                            <input type="email" class="form-control" id="so-nc-email" maxlength="191">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-opening-balance">Opening Balance</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" class="form-control" id="so-nc-opening-balance" placeholder="0" min="0" step="1">
                                <select class="form-select" id="so-nc-opening-balance-type" style="max-width:90px;flex:0 0 auto;">
                                    <option value="Cr" selected>Cr</option>
                                    <option value="Dr">Dr</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="q-nc-section">
                    <legend class="q-nc-section-title">Other Details</legend>
                    <div class="form-grid form-grid--3col">
                        <div class="form-group">
                            <label class="form-label" for="so-nc-country">Country</label>
                            <select class="form-select" id="so-nc-country" name="country"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-state">State</label>
                            <select class="form-select" id="so-nc-state" name="state" disabled>
                                <option value="" selected>Select country first</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-city">City</label>
                            <select class="form-select" id="so-nc-city" name="city" disabled>
                                <option value="" selected>Select state first</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-address">Postal Address</label>
                            <textarea class="form-control" id="so-nc-address" rows="2" maxlength="2000"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-pincode">Postal Code</label>
                            <input type="text" class="form-control" id="so-nc-pincode" maxlength="12">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="so-nc-gst-reg-type">GST Registration Type</label>
                            <select class="form-select" id="so-nc-gst-reg-type">
                                <option value="" selected>Select registration type</option>
                                <% _ncGstRegTypes.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }); %>
                            </select>
                        </div>
                        <div class="form-group form-grid-span-3">
                            <label class="form-label" for="so-nc-narration">Narration</label>
                            <textarea class="form-control" id="so-nc-narration" rows="2" maxlength="2000"></textarea>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="so-nc-save">
                    <i class="fa-solid fa-check me-1"></i>Save Customer
                </button>
            </div>
        </div>
    </div>
</div>

<%# Products / parties / sales-ledgers for the searchable comboboxes. %>
<script>
    window.SALES_ORDER_PRODUCTS = <%- _productsJson %>;
    window.SALES_ORDER_PARTIES  = <%- _partiesJson %>;
    window.SALES_ORDER_LEDGERS  = <%- _ledgersJson %>;
    window.SALES_ORDER_QUICK_CUSTOMER_URL = '/sales-orders/create/quick-customer';
</script>

<style>
    /* Searchable item picker for sales-order rows (same widget as the
       quotation/invoice line-item picker) — kept local to this page like
       quotations/create.ejs does, rather than growing theme.css. */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-product-search:disabled, input:disabled, button:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    /* position: FIXED (not absolute) so the menu escapes the table's
       overflow-x:auto clip (which also clips overflow-y). sales-order.js sets
       top/left/width from the search input's viewport rect. */
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #d1d5db); border-radius: 6px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
    }
    .li-prod-item { padding: 7px 10px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #eef2ff; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
    .li-prod-item .li-prod-sub { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }

    /* Single header bar — replaces the stacked page-head + voucher-head pair;
       a compact Back arrow instead of a second title. */
    .q-back {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; border-radius: 6px; margin-right: 10px;
        color: #fff; background: rgba(255,255,255,.15); vertical-align: middle;
    }
    .q-back:hover { background: rgba(255,255,255,.28); color: #fff; }

    /* Full-bleed header bar — LiveKeeping's header spans the ENTIRE content
       area, flush against the sidebar and the right edge, with nothing else
       above it. <main class="page"> pads 24px 28px (see theme.css), so pull
       the bar out by that exact amount and square its top corners; the rest
       of the card (below the bar) stays inset as normal. */
    .q-voucher { overflow: visible; }
    .voucher-head {
        display: flex; align-items: center;
        margin: -24px -28px 16px;
        border-radius: 0;
    }
    .voucher-head span { flex: 0 0 auto; }
    @media (max-width: 767.98px) {
        .voucher-head { margin: -20px -16px 16px; }
    }

    /* "View Sales Orders" header button — sits after the title, pushed to
       the far right of the full-bleed bar. */
    .q-list-btn {
        margin-left: auto;
        display: inline-flex; align-items: center;
        padding: 6px 14px; border-radius: 6px;
        font-size: 12.5px; font-weight: 600;
        color: #fff; background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
    }
    .q-list-btn:hover { background: rgba(255,255,255,.28); color: #fff; }

    /* Party/Ledger clear (×) button — only shown once a value is picked;
       sits inside the combobox cell, to the left of the dropdown's own
       scrollbar gutter. */
    .li-prod-clear {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        width: 18px; height: 18px; border: 0; border-radius: 50%;
        background: transparent; color: #9ca3af; font-size: 11px;
        display: flex; align-items: center; justify-content: center;
    }
    .li-prod-clear:hover { background: #f3f4f6; color: #374151; }
    .li-prod-cell:has(.li-prod-clear:not([hidden])) .li-product-search { padding-right: 26px; }

    /* Row sub-value (balance/parent) right-aligned opposite the label
       (party rows show outstanding balance on the right when available;
       ledger rows already used getSubLabel for the parent). */
    .li-prod-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .li-prod-item .li-prod-sub { flex: 0 0 auto; text-align: right; }

    /* "Create New Customer" pinned row. */
    .li-prod-item.li-prod-create {
        color: var(--primary); font-weight: 600; gap: 6px;
        border-bottom: 1px solid var(--border, #e5e7eb);
    }
    .li-prod-item.li-prod-create:hover { background: #eef2ff; }
</style>
