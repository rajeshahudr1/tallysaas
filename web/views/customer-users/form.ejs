<%
/* ─────────────────────────────────────────────────────────────
 * views/customer-users/form.ejs — SETTINGS · Configure Customer User.
 * Route: GET /customer-users/:id/edit → POST /customer-users/:id.
 *
 * Two cards:
 *   1. Login Access — email / password / role / status (opt-in: saved only
 *      when an email is present; password required only on first create).
 *   2. Assigned Catalog — tick categories (Select All / Unselect All in the
 *      header); per category set Discount % and Addition %; the Products
 *      button opens a MODAL with that category's products (Select All /
 *      Unselect All + per-product ticks). Done applies the ticks; the main
 *      Save submits everything.
 *
 * Field-name note: disc/add/prod keys are "c<catId>" (NOT the bare id) —
 * the extended qs body parser turns a bare numeric key into a SPARSE ARRAY
 * INDEX and compacts it, losing which category the value belonged to.
 *
 * Expected locals: record (customer), roleOptions [{id,name,slug}],
 *   categoryRows [{id,name}], productsByCategory {catId:[{id,name,sku,price}]},
 *   assignments { user, categories:[{category_id,discount_pct,addition_pct,product_ids}] }
 * ─────────────────────────────────────────────────────────── */

var _rec   = (typeof record !== 'undefined' && record) ? record : {};
var _roles = (typeof roleOptions !== 'undefined' && roleOptions) ? roleOptions : [];
var _cats  = (typeof categoryRows !== 'undefined' && categoryRows) ? categoryRows : [];
var _prods = (typeof productsByCategory !== 'undefined' && productsByCategory) ? productsByCategory : {};
var _asg   = (typeof assignments !== 'undefined' && assignments) ? assignments : { user: null, categories: [] };

var _byCat = {};
(_asg.categories || []).forEach(function (c) { _byCat[String(c.category_id)] = c; });
var _user = _asg.user || null;
%>

<%- include('../partials/page-head', {
    title: 'Configure Customer User', infoKey: 'customers',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'Customer Users', href: '/customer-users' },
        { label: _rec.name || 'Configure' },
    ],
    actions: [],
}) %>

<form method="post" action="/customer-users/<%= _rec.id %>" autocomplete="off">

    <!-- ── Customer summary ─────────────────────────────────── -->
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <div>
                <div class="fw-bold fs-5"><%= _rec.name %></div>
                <div class="text-muted small">
                    <%= _rec.mobile || '' %><%= _rec.email ? (' · ' + _rec.email) : '' %>
                    <%= _rec.customer_group ? (' · ' + _rec.customer_group) : '' %>
                </div>
            </div>
            <div class="ms-auto">
                <span class="badge <%= _user ? 'bg-success' : 'bg-secondary' %>">
                    <%= _user ? ('Login: ' + _user.email) : 'No login yet' %>
                </span>
            </div>
        </div>
    </div>

    <!-- ── 1. Login Access ──────────────────────────────────── -->
    <div class="card mb-3">
        <div class="card-header"><i class="fa-solid fa-right-to-bracket me-2"></i>Login Access</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Login Email</label>
                    <input type="email" class="form-control" name="login_email"
                           value="<%= _user ? _user.email : (_rec.email || '') %>"
                           placeholder="customer@example.com">
                    <div class="form-text">Leave blank to skip saving the login.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Password <%= _user ? '(blank = unchanged)' : '(required for new login)' %></label>
                    <input type="password" class="form-control" name="password" minlength="8"
                           placeholder="<%= _user ? '••••••••' : 'Min 8 characters' %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Role</label>
                    <select class="form-select" name="role_id">
                        <% _roles.forEach(function (r) { %>
                            <option value="<%= r.id %>" <%= (_user && Number(_user.role_id) === Number(r.id)) ? 'selected' : '' %>><%= r.name %></option>
                        <% }); %>
                    </select>
                    <div class="form-text">The role must include sales-invoices view + create.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Login Status</label>
                    <select class="form-select" name="login_status">
                        <% ['Active', 'Inactive', 'Blocked'].forEach(function (s) { %>
                            <option value="<%= s %>" <%= (_user && _user.status === s) ? 'selected' : '' %>><%= s %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ── 2. Assigned Catalog (categories × pricing × products) ── -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <span><i class="fa-solid fa-tags me-2"></i>Assigned Catalog</span>
            <span class="text-muted small">Final rate = sales price − Discount % + Addition %</span>
            <span class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" id="cu-cat-select-all">
                    <i class="fa-solid fa-check-double me-1"></i>Select All
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="cu-cat-unselect-all">
                    <i class="fa-solid fa-xmark me-1"></i>Unselect All
                </button>
            </span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:44px"></th>
                        <th>Category</th>
                        <th style="width:140px">Discount %</th>
                        <th style="width:140px">Addition %</th>
                        <th style="width:220px">Products</th>
                    </tr>
                </thead>
                <tbody>
                <% _cats.forEach(function (c) {
                    var saved   = _byCat[String(c.id)] || null;
                    var checked = !!saved;
                    var plist   = _prods[String(c.id)] || [];
                    var savedProds = {};
                    (saved && saved.product_ids || []).forEach(function (pid) { savedProds[String(pid)] = true; });
                    var narrowedCount = (saved && saved.product_ids) ? saved.product_ids.length : 0;
                %>
                    <tr>
                        <td>
                            <input class="form-check-input cu-cat-check" type="checkbox"
                                   name="cat_ids[]" value="<%= c.id %>" data-cat="<%= c.id %>"
                                   <%= checked ? 'checked' : '' %>>
                        </td>
                        <td class="fw-semibold"><%= c.name %></td>
                        <td>
                            <input type="number" class="form-control form-control-sm" name="disc[c<%= c.id %>]"
                                   min="0" max="100" step="0.01" value="<%= saved ? saved.discount_pct : 0 %>"
                                   <%= checked ? '' : 'disabled' %>>
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm" name="add[c<%= c.id %>]"
                                   min="0" step="0.01" value="<%= saved ? saved.addition_pct : 0 %>"
                                   <%= checked ? '' : 'disabled' %>>
                        </td>
                        <td>
                            <% if (plist.length) { %>
                                <button class="btn btn-sm btn-outline-secondary cu-prod-btn" type="button"
                                        id="cu-prod-btn-<%= c.id %>" data-cat="<%= c.id %>" data-total="<%= plist.length %>"
                                        data-bs-toggle="modal" data-bs-target="#cu-prod-modal-<%= c.id %>"
                                        <%= checked ? '' : 'disabled' %>>
                                    <i class="fa-solid fa-box-open me-1"></i>
                                    <span class="cu-prod-btn-label"><%= narrowedCount ? (narrowedCount + ' of ' + plist.length + ' selected') : ('All (' + plist.length + ')') %></span>
                                </button>
                            <% } else { %>
                                <span class="text-muted small">No products</span>
                            <% } %>
                            <!-- Ticked product ids live here (inside the form) so the
                                 modal is purely a picker UI. Empty value keeps the key
                                 present so unticking everything clears the narrowing. -->
                            <span id="cu-prod-inputs-<%= c.id %>">
                                <input type="hidden" name="prod[c<%= c.id %>][]" value="">
                                <% Object.keys(savedProds).forEach(function (pid) { %>
                                    <input type="hidden" name="prod[c<%= c.id %>][]" value="<%= pid %>">
                                <% }); %>
                            </span>
                        </td>
                    </tr>
                <% }); %>
                <% if (!_cats.length) { %>
                    <tr><td colspan="5" class="text-center text-muted py-4">No categories yet — create categories first.</td></tr>
                <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
        <a href="/customer-users" class="btn btn-light">Cancel</a>
    </div>
</form>

<!-- ── Product picker modals (one per category; OUTSIDE the form — the ticks
     are copied into the form's hidden inputs on Done) ─────────────────────── -->
<% _cats.forEach(function (c) {
    var plist = _prods[String(c.id)] || [];
    if (!plist.length) return;
    var saved = _byCat[String(c.id)] || null;
    var savedProds = {};
    (saved && saved.product_ids || []).forEach(function (pid) { savedProds[String(pid)] = true; });
%>
<div class="modal fade" id="cu-prod-modal-<%= c.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-box-open me-2"></i><%= c.name %> — Select Products</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <div class="input-group input-group-sm" style="max-width:280px">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control cu-prod-search" data-cat="<%= c.id %>"
                               placeholder="Search products...">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary cu-prod-select-all" data-cat="<%= c.id %>">
                        <i class="fa-solid fa-check-double me-1"></i>Select All
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary cu-prod-unselect-all" data-cat="<%= c.id %>">
                        <i class="fa-solid fa-xmark me-1"></i>Unselect All
                    </button>
                    <span class="ms-auto text-muted small align-self-center">
                        No selection = ALL products of this category are allowed.
                    </span>
                </div>
                <div class="row row-cols-1 row-cols-md-2 g-2">
                    <% plist.forEach(function (p) { %>
                        <div class="col cu-prod-item-<%= c.id %>" data-search="<%= (p.name + ' ' + (p.sku || '')).toLowerCase() %>">
                            <label class="form-check border rounded p-2 w-100 m-0 d-flex align-items-center gap-2">
                                <input class="form-check-input cu-prod-tick-<%= c.id %> ms-1 mt-0" type="checkbox"
                                       value="<%= p.id %>" <%= savedProds[String(p.id)] ? 'checked' : '' %>>
                                <span class="form-check-label flex-grow-1">
                                    <%= p.name %><%= p.sku ? (' (' + p.sku + ')') : '' %>
                                </span>
                                <span class="text-muted small">₹<%= p.sales_price %></span>
                            </label>
                        </div>
                    <% }); %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary cu-prod-done" data-cat="<%= c.id %>" data-bs-dismiss="modal">
                    <i class="fa-solid fa-check me-1"></i>Done
                </button>
            </div>
        </div>
    </div>
</div>
<% }); %>

<script>
(function () {
    // Enable/disable a category row's controls with its checkbox.
    function setRowState(cat, on) {
        document.querySelectorAll('[name="disc[c' + cat + ']"], [name="add[c' + cat + ']"]').forEach(function (el) { el.disabled = !on; });
        var btn = document.getElementById('cu-prod-btn-' + cat);
        if (btn) btn.disabled = !on;
    }
    document.querySelectorAll('.cu-cat-check').forEach(function (cb) {
        cb.addEventListener('change', function () { setRowState(cb.getAttribute('data-cat'), cb.checked); });
    });

    // EITHER Discount % OR Addition % per category — typing a value in one
    // zeroes + locks the other (mirrors the API rule; unlocks when cleared).
    function pairRule(cat) {
        var disc = document.querySelector('[name="disc[c' + cat + ']"]');
        var add  = document.querySelector('[name="add[c' + cat + ']"]');
        if (!disc || !add) return;
        function sync(src, other) {
            var v = Number(src.value) || 0;
            if (v > 0) { other.value = 0; other.readOnly = true; other.classList.add('bg-light'); }
            else { other.readOnly = false; other.classList.remove('bg-light'); }
        }
        disc.addEventListener('input', function () { sync(disc, add); });
        add.addEventListener('input',  function () { sync(add, disc); });
        // Initial state from saved values.
        if ((Number(disc.value) || 0) > 0) { add.readOnly = true; add.classList.add('bg-light'); }
        if ((Number(add.value)  || 0) > 0) { disc.readOnly = true; disc.classList.add('bg-light'); }
    }
    document.querySelectorAll('.cu-cat-check').forEach(function (cb) { pairRule(cb.getAttribute('data-cat')); });

    // Category header: Select All / Unselect All.
    function setAllCats(on) {
        document.querySelectorAll('.cu-cat-check').forEach(function (cb) {
            cb.checked = on;
            setRowState(cb.getAttribute('data-cat'), on);
        });
    }
    document.getElementById('cu-cat-select-all').addEventListener('click', function () { setAllCats(true); });
    document.getElementById('cu-cat-unselect-all').addEventListener('click', function () { setAllCats(false); });

    // Product modal: search filter (name/sku, case-insensitive, live).
    document.querySelectorAll('.cu-prod-search').forEach(function (inp) {
        inp.addEventListener('input', function () {
            var q = inp.value.trim().toLowerCase();
            document.querySelectorAll('.cu-prod-item-' + inp.getAttribute('data-cat')).forEach(function (item) {
                item.style.display = (!q || item.getAttribute('data-search').indexOf(q) !== -1) ? '' : 'none';
            });
        });
    });

    // Product modal: Select All / Unselect All — applies to the VISIBLE
    // (search-filtered) items only, so "search + Select All" works as expected.
    function setVisibleTicks(cat, on) {
        document.querySelectorAll('.cu-prod-item-' + cat).forEach(function (item) {
            if (item.style.display === 'none') return;
            var t = item.querySelector('input[type="checkbox"]');
            if (t) t.checked = on;
        });
    }
    document.querySelectorAll('.cu-prod-select-all').forEach(function (btn) {
        btn.addEventListener('click', function () { setVisibleTicks(btn.getAttribute('data-cat'), true); });
    });
    document.querySelectorAll('.cu-prod-unselect-all').forEach(function (btn) {
        btn.addEventListener('click', function () { setVisibleTicks(btn.getAttribute('data-cat'), false); });
    });

    // Done: copy the modal ticks into the form's hidden inputs + update the label.
    document.querySelectorAll('.cu-prod-done').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var cat = btn.getAttribute('data-cat');
            var ticked = Array.prototype.filter.call(
                document.querySelectorAll('.cu-prod-tick-' + cat), function (t) { return t.checked; }
            ).map(function (t) { return t.value; });

            var holder = document.getElementById('cu-prod-inputs-' + cat);
            holder.innerHTML = '<input type="hidden" name="prod[c' + cat + '][]" value="">'
                + ticked.map(function (id) { return '<input type="hidden" name="prod[c' + cat + '][]" value="' + id + '">'; }).join('');

            var btnEl = document.getElementById('cu-prod-btn-' + cat);
            var total = btnEl ? btnEl.getAttribute('data-total') : '';
            var label = btnEl ? btnEl.querySelector('.cu-prod-btn-label') : null;
            if (label) label.textContent = ticked.length ? (ticked.length + ' of ' + total + ' selected') : ('All (' + total + ')');
        });
    });
})();
</script>
