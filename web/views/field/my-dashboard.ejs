<%
/* views/field/my-dashboard.ejs — SFA · the logged-in salesman's field home.
 * Shows their assigned locations (beats) + per-location tallies + an approval
 * summary. Data from GET /field/my-dashboard. Phase 2 adds GPS visit/coverage. */
var f  = (typeof field !== 'undefined' && field) ? field : { is_salesman: false, locations: [], stats: {} };
var st = f.stats || {};
var locs = Array.isArray(f.locations) ? f.locations : [];
function inr(n) { return '₹' + Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }); }
function n0(n)  { return Number(n || 0).toLocaleString('en-IN'); }
%>
<%- include('../partials/page-head', {
    title: 'My Field',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'My Field' },
    ],
    actions: [
        { label: 'New Invoice', icon: 'fa-plus', gradient: true, href: '/sales-invoices/create' },
    ],
}) %>

<% if (!f.is_salesman) { %>
    <div class="card"><div class="mf-empty">
        <i class="fa-solid fa-circle-info"></i>
        <div>This page is for field salesmen. Your account is not linked to a salesman profile.</div>
    </div></div>
<% } else { %>

<!-- Approval summary — each card links to its detail page -->
<section class="mf-stats">
    <a href="/my-locations" class="mf-stat mf-stat--blue">
        <span class="mf-stat-ico"><i class="fa-solid fa-location-dot"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.locations) %></div><div class="mf-stat-lbl">My Locations</div></div>
    </a>
    <a href="/my-customers" class="mf-stat mf-stat--indigo">
        <span class="mf-stat-ico"><i class="fa-solid fa-user-group"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.customers) %></div><div class="mf-stat-lbl">My Customers</div></div>
    </a>
    <a href="/my-approvals?status=draft" class="mf-stat mf-stat--slate">
        <span class="mf-stat-ico"><i class="fa-solid fa-pen-ruler"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.draft) %></div><div class="mf-stat-lbl">Drafts</div></div>
    </a>
    <a href="/my-approvals?status=pending" class="mf-stat mf-stat--amber">
        <span class="mf-stat-ico"><i class="fa-solid fa-hourglass-half"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.pending) %></div><div class="mf-stat-lbl">Pending Approval</div></div>
    </a>
    <a href="/my-approvals?status=approved" class="mf-stat mf-stat--green">
        <span class="mf-stat-ico"><i class="fa-solid fa-circle-check"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.approved) %></div><div class="mf-stat-lbl">Approved</div></div>
    </a>
    <a href="/my-approvals?status=rejected" class="mf-stat mf-stat--red">
        <span class="mf-stat-ico"><i class="fa-solid fa-circle-xmark"></i></span>
        <div><div class="mf-stat-val"><%= n0(st.rejected) %></div><div class="mf-stat-lbl">Rejected</div></div>
    </a>
</section>

<% var att = f.attendance || {}; var covPct = Math.min(100, Number(st.coverage_pct) || 0); %>
<div class="card mf-cov-card">
    <div class="mf-cov-head">
        <span class="mf-cov-title"><i class="fa-solid fa-route me-2 text-primary"></i>Today's Coverage</span>
        <span class="mf-cov-pct"><%= n0(st.coverage_pct || 0) %>% · <%= n0(st.today_visited || 0) %>/<%= n0(st.customers) %> outlets</span>
    </div>
    <div class="mf-cov-track"><span class="mf-cov-fill<%= covPct >= 100 ? ' is-done' : '' %>" style="width:<%= covPct %>%"></span></div>
    <div class="mf-cov-foot">
        <span class="mf-cov-att mf-cov-att--<%= att.started ? (att.ended ? 'off' : 'on') : 'none' %>">
            <i class="fa-solid fa-circle"></i>
            <%= att.started ? (att.ended ? 'Day ended' : 'Day in progress') : 'Day not started' %>
        </span>
        <a href="/field-tracking" class="mf-cov-link">View visit log <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>
</div>

<div class="card mf-value-card">
    <span class="mf-value-lbl"><i class="fa-solid fa-indian-rupee-sign me-2 text-success"></i>Approved sales value</span>
    <span class="mf-value-amt"><%= inr(st.approved_value) %></span>
</div>
<style>
  .mf-cov-card{padding:16px 18px;margin-bottom:14px;}
  .mf-cov-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .mf-cov-title{font-size:14px;font-weight:700;color:#0f172a;}
  .mf-cov-pct{font-size:13px;font-weight:700;color:var(--primary);}
  .mf-cov-track{height:10px;border-radius:999px;background:#e2e8f0;overflow:hidden;}
  .mf-cov-fill{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--primary),#3b82f6);transition:width .5s ease;}
  .mf-cov-fill.is-done{background:linear-gradient(90deg,#16a34a,#22c55e);}
  .mf-cov-foot{display:flex;align-items:center;justify-content:space-between;margin-top:10px;font-size:12.5px;}
  .mf-cov-att{display:inline-flex;align-items:center;gap:6px;font-weight:600;}
  .mf-cov-att i{font-size:8px;}
  .mf-cov-att--on{color:#16a34a;} .mf-cov-att--off{color:#64748b;} .mf-cov-att--none{color:#b45309;}
  .mf-cov-link{color:var(--primary);text-decoration:none;font-weight:600;}
</style>

<!-- Assigned locations -->
<div class="card">
    <div class="inv-section-head">
        <h2 class="inv-section-title"><i class="fa-solid fa-map-location-dot me-2 text-primary"></i>My Locations</h2>
    </div>
    <% if (!locs.length) { %>
        <div class="mf-empty"><i class="fa-solid fa-map-pin"></i><div>No locations are assigned to you yet. Ask your admin to assign your beats.</div></div>
    <% } else { %>
    <div class="mf-loc-grid">
        <% locs.forEach(function (l) { %>
            <div class="mf-loc">
                <div class="mf-loc-head">
                    <span class="mf-loc-name"><%= l.name %></span>
                    <span class="mf-loc-badge <%= String(l.status).toLowerCase() === 'active' ? 'is-on' : 'is-off' %>"><%= l.status || '—' %></span>
                </div>
                <div class="mf-loc-sub"><%= [l.city, l.state].filter(Boolean).join(', ') || '—' %></div>
                <div class="mf-loc-metrics">
                    <div><b><%= n0(l.customers) %></b><span>Customers</span></div>
                    <div><b><%= n0(l.invoices) %></b><span>My Invoices</span></div>
                    <div><b><%= inr(l.sales_value) %></b><span>Sales</span></div>
                </div>
            </div>
        <% }); %>
    </div>
    <% } %>
</div>

<% } %>

<style>
    .mf-empty { padding:36px 16px; text-align:center; color:#64748b; }
    .mf-empty i { font-size:30px; display:block; margin-bottom:10px; color:#94a3b8; }
    .mf-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:14px; }
    .mf-stat { display:flex; align-items:center; gap:12px; padding:14px 16px; background:#fff;
        border:1px solid #e2e8f0; border-radius:14px; text-decoration:none; color:inherit;
        transition:border-color .15s, box-shadow .15s, transform .1s; }
    a.mf-stat:hover { border-color:#D6E2FA; box-shadow:0 4px 14px rgba(20,25,40,.08); transform:translateY(-1px); }
    .mf-stat-ico { width:40px; height:40px; border-radius:11px; display:inline-flex; align-items:center;
        justify-content:center; font-size:17px; flex:0 0 auto; }
    .mf-stat-val { font-size:20px; font-weight:800; color:#0f172a; line-height:1.1; }
    .mf-stat-lbl { font-size:11.5px; color:#64748b; font-weight:600; margin-top:2px; }
    .mf-stat--blue   .mf-stat-ico { background:#dbeafe; color:var(--primary); }
    .mf-stat--indigo .mf-stat-ico { background:#e0e7ff; color:var(--primary); }
    .mf-stat--slate  .mf-stat-ico { background:#f1f5f9; color:#475569; }
    .mf-stat--amber  .mf-stat-ico { background:#fef3c7; color:#b45309; }
    .mf-stat--green  .mf-stat-ico { background:#dcfce7; color:#16a34a; }
    .mf-stat--red    .mf-stat-ico { background:#fee2e2; color:#dc2626; }
    .mf-value-card { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; margin-bottom:14px; }
    .mf-value-lbl { font-size:14px; font-weight:600; color:#334155; }
    .mf-value-amt { font-size:22px; font-weight:800; color:#16a34a; }
    .mf-loc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:12px; padding:4px; }
    .mf-loc { border:1px solid #e2e8f0; border-radius:12px; padding:14px; background:#fff; }
    .mf-loc-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
    .mf-loc-name { font-weight:700; color:#0f172a; }
    .mf-loc-badge { font-size:10.5px; font-weight:700; padding:1px 8px; border-radius:999px; }
    .mf-loc-badge.is-on  { color:#166534; background:#dcfce7; }
    .mf-loc-badge.is-off { color:#6b7280; background:#f3f4f6; }
    .mf-loc-sub { font-size:12px; color:#64748b; margin-top:2px; }
    .mf-loc-metrics { display:flex; justify-content:space-between; gap:8px; margin-top:12px; padding-top:10px; border-top:1px solid #f1f5f9; }
    .mf-loc-metrics div { display:flex; flex-direction:column; }
    .mf-loc-metrics b { font-size:15px; color:#0f172a; }
    .mf-loc-metrics span { font-size:10.5px; color:#94a3b8; font-weight:600; }
</style>
