<%
/* ─────────────────────────────────────────────────────────────
 * views/sales-invoices/create.ejs — TRANSACTIONS · Create Invoice.
 * Route: GET /sales-invoices/create  ·  activeMenu: 'sales-inv'.
 *
 * Three stacked cards inside one <form id="invoice-form">:
 *   1. Invoice Details  — customer / no / date / location / sales person.
 *   2. Line Items       — a <template>-driven editable grid; /js/invoice.js
 *                         clones rows, auto-fills HSN/Unit/Rate/GST from the
 *                         picked product, and live-computes Taxable/GST/Amount.
 *   3. Footer           — notes (left) + the Totals panel (right) + actions.
 *
 * The page-head Save buttons sit OUTSIDE the cards but submit the form via
 * form="invoice-form". Visual only in Phase 1 (no real submit).
 *
 * Expected locals (routes/web.js → res.render):
 *   customerNames / locationNames / salesPersons — header selects
 *   invoiceProducts [{name,hsn,unit,rate,gst}]   — line-item picker
 *   nextInvoiceNo   string                        — read-only invoice no.
 * ─────────────────────────────────────────────────────────── */

/* FK option sources are now [{id,name}] from the api (selects submit
 * real foreign keys); products carry id + line-item defaults. */
var _custs    = (typeof customerOptions !== 'undefined' && customerOptions) ? customerOptions : [];
var _locs     = (typeof locationOptions !== 'undefined' && locationOptions) ? locationOptions : [];
var _sps      = (typeof salesPersonOptions !== 'undefined' && salesPersonOptions) ? salesPersonOptions : [];
var _products = (typeof invoiceProducts !== 'undefined' && invoiceProducts) ? invoiceProducts : [];
var _invNo    = (typeof nextInvoiceNo !== 'undefined' && nextInvoiceNo) ? nextInvoiceNo : '';
/* A salesman login IS the sales person; their role can't list sales_persons, so
 * the route passes their own {id,name} to pre-fill (read-only) the field. */
var _mySP     = (typeof mySalesPerson !== 'undefined' && mySalesPerson) ? mySalesPerson : null;
var _isSalesman = (typeof isSalesman !== 'undefined' && isSalesman) ? true : false;
// Customer-portal login: the invoice is always THEIR OWN — customer is pinned
// in the background (hidden input; the API forces it anyway), and Location /
// Sales Person don't apply. Only Invoice No / Invoice Date / Due Date show.
var _isCustomerUser = (typeof isCustomerUser !== 'undefined' && isCustomerUser) ? true : false;
// The /customers list is API-scoped to ONLY their own row for a customer login.
var _myCust = _isCustomerUser && _custs.length ? _custs[0] : null;

/* EDIT mode — an existing invoice is being edited (draft/pending/rejected). The
 * header + line items pre-fill and the form PUTs to /:id/update (re-submits). */
var _edit      = (typeof editInvoice !== 'undefined' && editInvoice) ? editInvoice : null;
var _editItems = (typeof editItems !== 'undefined' && Array.isArray(editItems)) ? editItems : [];
var _formAction = _edit ? ('/sales-invoices/' + _edit.id + '/update') : '/sales-invoices';
function _isSel(a, b) { return (a != null && String(a) === String(b)) ? ' selected' : ''; }
/* Date value (YYYY-MM-DD) for a native date input; blank → today (create). */
function _dv(v, fallbackToday) {
    if (v) { var s = String(v); return s.length >= 10 ? s.slice(0, 10) : s; }
    return fallbackToday ? new Date().toISOString().slice(0, 10) : '';
}
var _pageTitle = _edit ? 'Edit Invoice' : 'Create Invoice';

/* Tiny HTML-attr escaper so a customer/product name with a quote can't break
 * the data-* attributes we emit. */
function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* FK <select> options — value = id; `sel` (optional) pre-selects a value (edit). */
function _selOpts(placeholder, list, sel) {
    var chosen = sel != null && sel !== '';
    var html = '<option value=""' + (chosen ? '' : ' selected') + ' disabled hidden>' + placeholder + '</option>';
    (list || []).forEach(function (o) { html += '<option value="' + o.id + '"' + _isSel(sel, o.id) + '>' + _esc(o.name) + '</option>'; });
    return html;
}

/* Customer <option>s carry the customer's location (id + label) so selecting a
 * customer AUTO-fills the Location field (see the inline script below). `sel`
 * pre-selects (edit mode). */
function _customerOpts(list, sel) {
    var chosen = sel != null && sel !== '';
    var html = '<option value=""' + (chosen ? '' : ' selected') + ' disabled hidden>Select customer</option>';
    (list || []).forEach(function (o) {
        html += '<option value="' + o.id + '"' + _isSel(sel, o.id)
             + ' data-location-id="' + _esc(o.location_id) + '"'
             + ' data-location="' + _esc(o.location) + '">' + _esc(o.name) + '</option>';
    });
    return html;
}

/* Products as a JS array for the searchable line-item picker (autocomplete). */
var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, hsn: p.hsn || '', unit: p.unit || '', rate: p.rate || 0, gst: p.gst || 0, stock: (p.stock != null ? p.stock : null) };
}));

// SFA — EVERY non-admin submits for approval (can't send straight to Tally); the
// "Save as Draft" buttons carry save_as_draft=1 so the api keeps it editable.
// Only a company-admin (needsApproval=false) saves straight through to Tally.
var _needsApproval = (typeof needsApproval !== 'undefined') ? !!needsApproval : false;
var _primaryLabel = _edit
    ? '<i class="fa-solid fa-paper-plane me-1"></i>Update &amp; Re-submit'
    : (_needsApproval
        ? '<i class="fa-solid fa-paper-plane me-1"></i>Submit for Approval'
        : '<i class="fa-solid fa-cloud-arrow-up me-1"></i>Save &amp; Send to Tally');
var _backHref = _isSalesman ? '/my-approvals' : '/sales-invoices';
var headActions =
    '<a class="btn btn-light" href="' + _backHref + '">' +
        '<i class="fa-solid fa-arrow-left me-1"></i>Back' +
    '</a>' +
    '<div class="btn-group">' +
        '<button type="submit" form="invoice-form" class="btn btn-primary">' +
            _primaryLabel +
        '</button>' +
        '<button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" ' +
                'data-bs-toggle="dropdown" aria-expanded="false">' +
            '<span class="visually-hidden">Toggle save options</span>' +
        '</button>' +
        '<ul class="dropdown-menu dropdown-menu-end">' +
            '<li><button type="submit" form="invoice-form" name="save_as_draft" value="1" class="dropdown-item">' +
                '<i class="fa-regular fa-floppy-disk me-2 text-muted"></i>Save as Draft</button></li>' +
            '<li><button type="submit" form="invoice-form" class="dropdown-item">' +
                '<i class="fa-solid fa-print me-2 text-muted"></i>Save &amp; Print</button></li>' +
        '</ul>' +
    '</div>';
%>

<%- include('../partials/page-head', {
    title: _pageTitle,
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'Sales Invoices', href: _isSalesman ? '/my-approvals' : '/sales-invoices' },
        { label: _pageTitle },
    ],
    actions: headActions,
}) %>

<form id="invoice-form" method="post" action="<%= _formAction %>" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/invoice.js on submit. -->
    <input type="hidden" name="items_json" id="items-json">

    <!-- ════ CARD 1 — Invoice Details ════ -->
    <div class="card mb-3">
        <div class="inv-section-head">
            <h2 class="inv-section-title"><i class="fa-solid fa-file-invoice me-2 text-primary"></i>Invoice Details</h2>
            <span class="pill-status pill-status--warning">Pending Tally</span>
        </div>
        <div class="inv-body">
            <div class="form-grid">

                <% if (_isCustomerUser) { %>
                    <%# Customer login: the party is THEMSELVES — pinned via a hidden
                        input (the API forces their customer_id server-side too). %>
                    <input type="hidden" id="inv-customer" name="customer_id"
                           value="<%= _myCust ? _myCust.id : ((_edit && _edit.customer_id) || '') %>">
                <% } else { %>
                <div class="form-group">
                    <label class="form-label" for="inv-customer">Customer<span class="req">*</span></label>
                    <select class="form-select" id="inv-customer" name="customer_id" required>
                        <%- _customerOpts(_custs, _edit && _edit.customer_id) %>
                    </select>
                </div>
                <% } %>

                <div class="form-group">
                    <label class="form-label" for="inv-no">Invoice No</label>
                    <input type="text" class="form-control" id="inv-no" name="invoice_no"
                           value="<%= _invNo %>" readonly>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inv-date">Invoice Date<span class="req">*</span></label>
                    <input type="date" class="form-control" id="inv-date" name="invoice_date" value="<%= _dv(_edit && _edit.invoice_date, true) %>" required>
                </div>

                <% if (!_isCustomerUser) { %>
                <div class="form-group">
                    <label class="form-label" for="inv-location">Location</label>
                    <% if (_isSalesman) { %>
                        <%# A salesman can't list locations (403) — the field is read-only and
                            AUTO-fills from the picked customer's location. %>
                        <input type="text" class="form-control" id="inv-location-label"
                               placeholder="Auto from customer" value="<%= _esc((_edit && _edit.location) || '') %>" readonly>
                        <input type="hidden" id="inv-location" name="location_id" value="<%= (_edit && _edit.location_id) || '' %>">
                    <% } else { %>
                        <select class="form-select" id="inv-location" name="location_id">
                            <%- _selOpts('Select location', _locs, _edit && _edit.location_id) %>
                        </select>
                    <% } %>
                </div>

                <div class="form-group">
                    <label class="form-label" for="inv-sp">Sales Person</label>
                    <% if (_isSalesman && _mySP) { %>
                        <%# Login IS the sales person — read-only self, submitted via the hidden id. %>
                        <input type="text" class="form-control" value="<%= _mySP.name %>" readonly>
                        <input type="hidden" id="inv-sp" name="sales_person_id" value="<%= _mySP.id %>">
                    <% } else { %>
                        <select class="form-select" id="inv-sp" name="sales_person_id">
                            <%- _selOpts('Select sales person', _sps, _edit && _edit.sales_person_id) %>
                        </select>
                    <% } %>
                </div>
                <% } /* end !_isCustomerUser (Location + Sales Person hidden) */ %>

                <div class="form-group">
                    <label class="form-label" for="inv-due">Due Date</label>
                    <input type="date" class="form-control" id="inv-due" name="due_date" value="<%= _dv(_edit && _edit.due_date, false) %>">
                </div>

            </div>
        </div>
    </div>

    <!-- ════ CARD 2 — Line Items ════ -->
    <div class="card mb-3">
        <div class="inv-section-head">
            <h2 class="inv-section-title"><i class="fa-solid fa-list me-2 text-primary"></i>Line Items</h2>
            <span class="form-hint mb-0" id="inv-itemcount">0 item(s)</span>
        </div>

        <div class="li-table-wrap">
            <table class="li-table">
                <thead>
                    <tr>
                        <th class="li-idx">#</th>
                        <th>Product</th>
                        <th>HSN</th>
                        <th class="num">Qty</th>
                        <th>Unit</th>
                        <th class="num">Rate (₹)</th>
                        <th class="num">Disc %</th>
                        <th class="num">Taxable (₹)</th>
                        <th class="num">GST %</th>
                        <th class="num">GST Amt (₹)</th>
                        <th class="num">Amount (₹)</th>
                        <th class="center"></th>
                    </tr>
                </thead>
                <!-- Rows are injected by /js/invoice.js from the template below. -->
                <tbody id="li-body"></tbody>
            </table>
        </div>

        <div class="inv-body pt-0">
            <button type="button" class="li-addrow" id="li-add-row">
                <i class="fa-solid fa-plus"></i> Add Row
            </button>
        </div>

        <!-- ════ Footer — Notes (left) + Totals (right) ════ -->
        <div class="inv-foot">
            <div>
                <label class="form-label" for="inv-notes">Notes / Terms</label>
                <textarea class="form-control" id="inv-notes" name="notes" rows="5"
                          maxlength="500" placeholder="Payment terms, delivery notes, bank details…"><%= (_edit && _edit.notes) || '' %></textarea>
            </div>

            <div class="inv-totals">
                <div class="inv-total-row">
                    <span class="lbl">Subtotal</span><span class="val" id="inv-subtotal">₹0.00</span>
                </div>
                <div class="inv-total-row">
                    <span class="lbl">Discount</span><span class="val" id="inv-discount">− ₹0.00</span>
                </div>
                <div class="inv-total-row">
                    <span class="lbl">Taxable Value</span><span class="val" id="inv-taxable">₹0.00</span>
                </div>
                <div class="inv-total-row">
                    <span class="lbl">CGST</span><span class="val" id="inv-cgst">₹0.00</span>
                </div>
                <div class="inv-total-row">
                    <span class="lbl">SGST</span><span class="val" id="inv-sgst">₹0.00</span>
                </div>
                <div class="inv-total-row">
                    <span class="lbl">Round Off</span><span class="val" id="inv-roundoff">+ ₹0.00</span>
                </div>
                <div class="inv-total-row grand">
                    <span class="lbl">Grand Total</span><span class="val" id="inv-grand">₹0.00</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ════ Footer actions ════ -->
    <div class="card">
        <div class="form-card-footer" style="border-top:0; background:#fff;">
            <a class="btn btn-light" href="/sales-invoices">Cancel</a>
            <button type="submit" name="save_as_draft" value="1" class="btn btn-light">
                <i class="fa-regular fa-floppy-disk me-1"></i>Save as Draft
            </button>
            <button type="submit" class="btn btn-primary">
                <% if (typeof isSalesman !== 'undefined' && isSalesman) { %>
                    <i class="fa-solid fa-paper-plane me-1"></i>Submit for Approval
                <% } else { %>
                    <i class="fa-solid fa-cloud-arrow-up me-1"></i>Save &amp; Send to Tally
                <% } %>
            </button>
        </div>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/invoice.js) ─────────── -->
<template id="li-row-tpl">
    <tr class="li-row">
        <td class="li-idx"></td>
        <td class="li-prod-cell">
            <input type="text" class="li-product-search" placeholder="Search product…" autocomplete="off">
            <input type="hidden" class="li-product">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="text" class="li-hsn" readonly placeholder="—"></td>
        <td><input type="number" class="li-qty li-num" min="0" step="1" value="1"></td>
        <td><input type="text" class="li-unit" readonly placeholder="—"></td>
        <td><input type="number" class="li-rate li-num" min="0" step="0.01" value="0"></td>
        <td><input type="number" class="li-disc li-num" min="0" max="100" step="0.01" value="0"></td>
        <td><span class="li-taxable li-cell-calc">₹0.00</span></td>
        <td><input type="number" class="li-gst li-num" min="0" step="0.01" value="0"></td>
        <td><span class="li-gstamt li-cell-calc">₹0.00</span></td>
        <td><span class="li-amount li-cell-calc">₹0.00</span></td>
        <td class="center">
            <button type="button" class="li-remove" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<%# Products for the searchable line-item picker + customer→location auto-fill. %>
<script>
    window.INVOICE_PRODUCTS = <%- _productsJson %>;
    // EDIT mode: existing line items so invoice.js seeds the rows (else one empty row).
    window.INVOICE_EDIT_ITEMS = <%- JSON.stringify(_editItems.map(function (it) {
        return {
            product_id: it.product_id != null ? it.product_id : null,
            hsn: it.hsn || it.hsn_code || '',
            quantity: Number(it.quantity != null ? it.quantity : (it.qty || 0)) || 0,
            unit: it.unit || '',
            rate: Number(it.rate || 0) || 0,
            discount_pct: Number(it.discount_pct != null ? it.discount_pct : (it.disc_pct || 0)) || 0,
            gst_rate: Number(it.gst_rate != null ? it.gst_rate : (it.gst || 0)) || 0,
        };
    })) %>;
</script>
<script>
(function () {
    // Customer → Location auto-fill. Picking a customer sets the Location field to
    // that customer's location. For a salesman the Location is a read-only pair
    // (#inv-location-label + hidden #inv-location); for an admin it's a <select>
    // — we add the option if it isn't already there, then select it.
    // Customer-portal login: the rate is LOCKED (server recomputes it from the
    // assigned catalog anyway) and per-line Disc % doesn't apply (pricing lives
    // in the category %). Lock the inputs as rows appear so the on-screen totals
    // match what the API will actually save.
    <% if (_isCustomerUser) { %>
    document.addEventListener('DOMContentLoaded', function () {
        var body = document.getElementById('li-body');
        if (!body) return;
        function lockRows() {
            body.querySelectorAll('.li-rate, .li-disc').forEach(function (inp) {
                inp.readOnly = true;
                inp.classList.add('bg-light');
                inp.title = 'Rate is fixed by your price list';
            });
        }
        lockRows();
        new MutationObserver(lockRows).observe(body, { childList: true });
    });
    <% } %>
    document.addEventListener('DOMContentLoaded', function () {
        var cust = document.getElementById('inv-customer');
        if (!cust) return;
        cust.addEventListener('change', function () {
            var opt = cust.options[cust.selectedIndex];
            if (!opt) return;
            var locId   = opt.getAttribute('data-location-id') || '';
            var locName = opt.getAttribute('data-location') || '';
            var label   = document.getElementById('inv-location-label'); // salesman (readonly)
            var hidden  = document.getElementById('inv-location');
            if (label && hidden && hidden.tagName === 'INPUT' && hidden.type === 'hidden') {
                label.value = locName || '';
                hidden.value = locId || '';
                return;
            }
            var sel = document.getElementById('inv-location'); // admin (<select>)
            if (sel && sel.tagName === 'SELECT') {
                if (!locId) { sel.value = ''; return; }
                var has = Array.prototype.some.call(sel.options, function (o) { return String(o.value) === String(locId); });
                if (!has) {
                    var o = document.createElement('option');
                    o.value = locId; o.textContent = locName || ('Location ' + locId);
                    sel.appendChild(o);
                }
                sel.value = String(locId);
            }
        });
    });
})();
</script>

<style>
    /* Searchable product picker for line items (replaces the native <select>). */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(99,102,241,.15); }
    /* position: FIXED (not absolute) so the menu escapes the invoice table's
       overflow-x:auto clip (which also clips overflow-y). JS sets top/left/width
       from the search input's viewport rect. */
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #E9EDF3); border-radius: 12px;
        box-shadow: 0 8px 24px rgba(16,24,40,.10); padding: 4px;
    }
    .li-prod-item { padding: 9px 12px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 8px; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #EAF1FE; color: #1560E0; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }
</style>
