<%
/* ─────────────────────────────────────────────────────────────
 * views/auth/forgot.ejs — standalone forgot/reset page (layout:false).
 * Driven by `step`: 'email' → 'code' → 'done'.
 *   email → POST /forgot-password   (api emails a 6-digit code)
 *   code  → POST /reset-password    (verify code + set new password)
 * Locals: step, error, info, email.
 * ─────────────────────────────────────────────────────────── */
var _step  = (typeof step  !== 'undefined') ? step  : 'email';
var _err   = (typeof error !== 'undefined') ? error : null;
var _info  = (typeof info  !== 'undefined') ? info  : null;
var _email = (typeof email !== 'undefined' && email) ? email : '';
%><!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot password · Tally Cloud Sync</title>
    <meta name="theme-color" content="#2563EB">
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" referrerpolicy="no-referrer">
    <style>
        body { font-family: Inter, system-ui, sans-serif; min-height: 100vh; margin: 0;
            display: grid; place-items: center; padding: 24px;
            background: linear-gradient(135deg, #2563EB 0%, #6D28D9 100%); }
        .login-card { width: 100%; max-width: 410px; background: #fff; border-radius: 18px;
            box-shadow: 0 20px 60px rgba(16,24,40,.25); padding: 34px 32px; }
        .login-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 22px; }
        .login-logo { width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center;
            background: linear-gradient(135deg, #2563EB, #6D28D9); color: #fff; font-size: 19px; }
        .login-brand-text { font-weight: 700; font-size: 18px; color: #111827; }
        .login-title { font-size: 21px; font-weight: 700; color: #111827; margin: 0 0 4px; }
        .login-sub { color: #6B7280; font-size: 13.5px; margin: 0 0 22px; }
        .login-card .form-label { font-weight: 600; font-size: 13px; color: #374151; }
        .login-card .form-control { padding: 11px 13px; border-radius: 10px; border-color: #E5E7EB; }
        .login-card .form-control:focus { border-color: #2563EB; box-shadow: 0 0 0 3px rgba(37,99,235,.14); }
        .login-btn { width: 100%; padding: 12px; border: 0; border-radius: 10px; color: #fff; font-weight: 600;
            background: linear-gradient(135deg, #2563EB, #6D28D9); }
        .login-err { background: #FEE2E2; color: #B91C1C; border: 1px solid #FECACA; border-radius: 10px;
            padding: 10px 13px; font-size: 13px; margin-bottom: 16px; display: flex; gap: 8px; align-items: center; }
        .login-info { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; border-radius: 10px;
            padding: 10px 13px; font-size: 13px; margin-bottom: 16px; display: flex; gap: 8px; align-items: center; }
        .login-link { display: block; text-align: center; margin-top: 16px; font-size: 13px; color: #2563EB; text-decoration: none; }
        .login-link:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <span class="login-logo"><i class="fa-solid fa-cloud"></i></span>
            <span class="login-brand-text">Tally Cloud Sync</span>
        </div>

        <% if (_err) { %><div class="login-err"><i class="fa-solid fa-circle-exclamation"></i><span><%= _err %></span></div><% } %>
        <% if (_info) { %><div class="login-info"><i class="fa-solid fa-circle-check"></i><span><%= _info %></span></div><% } %>

        <% if (_step === 'done') { %>
            <h1 class="login-title">Password reset</h1>
            <p class="login-sub">Your password has been updated. You can sign in now.</p>
            <a class="login-btn" href="/login" style="display:block;text-align:center;text-decoration:none;line-height:1.6;">
                <i class="fa-solid fa-right-to-bracket me-1"></i> Go to sign in
            </a>

        <% } else if (_step === 'code') { %>
            <h1 class="login-title">Enter code</h1>
            <p class="login-sub">Enter the 6-digit code we emailed and choose a new password.</p>
            <form method="post" action="/reset-password" autocomplete="off">
                <input type="hidden" name="email" value="<%= _email %>">
                <div class="mb-3">
                    <label class="form-label" for="code">6-digit code</label>
                    <input type="text" inputmode="numeric" pattern="\d{6}" maxlength="6" class="form-control"
                           id="code" name="code" placeholder="123456" required autofocus>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">New password</label>
                    <input type="password" class="form-control" id="password" name="password"
                           placeholder="••••••••" minlength="6" required>
                </div>
                <button type="submit" class="login-btn"><i class="fa-solid fa-key me-1"></i> Reset password</button>
            </form>
            <a class="login-link" href="/forgot-password">Use a different email</a>

        <% } else { %>
            <h1 class="login-title">Forgot password</h1>
            <p class="login-sub">Enter your account email and we'll send you a reset code.</p>
            <form method="post" action="/forgot-password" autocomplete="on">
                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email"
                           value="<%= _email %>" placeholder="you@company.com" required autofocus>
                </div>
                <button type="submit" class="login-btn"><i class="fa-solid fa-paper-plane me-1"></i> Send code</button>
            </form>
        <% } %>

        <a class="login-link" href="/login"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
    </div>
</body>
</html>
