<%
/* ─────────────────────────────────────────────────────────────
 * views/physical-stock/create.ejs — TRANSACTIONS · Create Physical Stock Voucher.
 * Route: GET /physical-stock/create  ·  activeMenu: 'new-phys-stock'.
 *
 * A GOODS voucher — NO ledger, NO GST, NO money totals (layout borrowed from
 * delivery-notes/create.ejs). Physical Stock SETS each counted product's
 * stock to the counted quantity — Current Qty is shown read-only right next
 * to the counted field so the difference being booked is obvious before
 * submit. Godown is a single header field (applies to every counted line —
 * PhysicalStockController.create writes it into each line's `notes`).
 *
 * Expected locals (routes/web.js → res.render):
 *   stockProducts [{id,name,hsn,unit,rate,gst,stock}] — line-item picker;
 *   `stock` is the CURRENT qty on hand shown per line once an item is picked.
 * ─────────────────────────────────────────────────────────── */

var _products = (typeof stockProducts !== 'undefined' && stockProducts) ? stockProducts : [];

function _esc(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

var _productsJson = JSON.stringify(_products.map(function (p) {
    return { id: p.id, name: p.name, unit: p.unit || '', stock: (p.stock != null ? p.stock : null) };
}));

var _today = new Date().toISOString().slice(0, 10);

/* RECOUNT — a previous sheet, loaded to save time. The form still posts to
   CREATE: this records a NEW count, it does not rewrite the old one. The
   voucher no is deliberately left blank so the server auto-numbers it. */
var _recountFrom  = (typeof recountFrom !== 'undefined' && recountFrom) ? recountFrom : '';
var _recountItems = (typeof recountItems !== 'undefined' && recountItems) ? recountItems : [];
%>

<% if (_recountFrom) { %>
    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i>
        <div>Counting again from <strong><%= _recountFrom %></strong>. Saving records a
            <strong>new</strong> sheet — <%= _recountFrom %> stays as it was.</div>
    </div>
<% } %>
<%# The SAME header every other create screen uses (partials/page-head),
    not a voucher-only bar. The buttons sit outside the <form> and reach it by
    the form="…" attribute, exactly as sales-invoices/create.ejs does. %>
<%- include('../partials/page-head', {
    title: 'Create Physical Stock Voucher',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: "Physical Stock", href: '/physical-stock' },
        { label: 'Create Physical Stock' },
    ],
    actions:
        '<a class="btn btn-light" href="' + '/physical-stock' + '"><i class="fa-solid fa-list-ul me-2"></i>' + 'View Physical Stock' + '</a>' +
        '<button type="submit" form="physical-stock-form" id="sv-submit" class="btn btn-gradient"' + '' + '>' +
            '<i class="fa-solid fa-cloud-arrow-up me-2"></i>' + (_recountFrom ? 'Save New Count' : 'Create Voucher') +
        '</button>',
}) %>

<form id="physical-stock-form" method="post" action="/physical-stock" autocomplete="off" novalidate>

    <!-- Line items are serialised to JSON here by /js/stock-voucher.js on submit. -->
    <input type="hidden" name="items_json" id="items_json">

    <div class="card mb-3 q-voucher">

        <div class="inv-body">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="sv-date">Date<span class="req">*</span></label>
                    <input type="date" class="form-control" id="sv-date" name="count_date" value="<%= _today %>" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="sv-no">Voucher No</label>
                    <div class="q-no-wrap">
                        <input type="text" class="form-control" id="sv-no" name="voucher_no"
                               value="" placeholder="Auto-generated on save" readonly>
                        <button type="button" class="q-no-edit" id="sv-no-edit" title="Edit voucher no" aria-label="Edit voucher no">
                            <i class="fa-solid fa-pen"></i>
                        </button>

                        <!-- ── Default/Custom voucher-no popup — same registerPopup()/
                             closeAllPopups() gate as every other dropdown on this page. -->
                        <div class="q-no-popup" id="sv-no-popup" hidden>
                            <div class="q-no-popup-radios">
                                <label class="q-no-radio">
                                    <input type="radio" name="sv-no-mode" id="sv-no-mode-default" value="default" checked>
                                    <span>Default</span>
                                </label>
                                <label class="q-no-radio">
                                    <input type="radio" name="sv-no-mode" id="sv-no-mode-custom" value="custom">
                                    <span>Custom</span>
                                </label>
                            </div>
                            <div class="q-no-popup-fields" id="sv-no-popup-fields" hidden>
                                <div class="q-no-field">
                                    <label for="sv-no-prefix">Prefix</label>
                                    <input type="text" class="form-control" id="sv-no-prefix" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="sv-no-number">Voucher no</label>
                                    <input type="text" class="form-control" id="sv-no-number" maxlength="20" autocomplete="off">
                                </div>
                                <div class="q-no-field">
                                    <label for="sv-no-suffix">Suffix</label>
                                    <input type="text" class="form-control" id="sv-no-suffix" maxlength="20" autocomplete="off">
                                </div>
                            </div>
                            <div class="q-no-popup-actions">
                                <button type="button" class="btn btn-light btn-sm" id="sv-no-cancel">Cancel</button>
                                <button type="button" class="btn btn-primary btn-sm" id="sv-no-save">Save</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="sv-godown">Godown</label>
                    <input type="text" class="form-control sv-godown" id="sv-godown" placeholder="Godown for this count">
                </div>
            </div>
        </div>

        <!-- ════ Items table ════ -->
        <div class="li-table-wrap">
            <table class="q-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="num">Current Qty</th>
                        <th class="num">Counted Qty</th>
                        <th class="center">
                            <button type="button" class="q-add-btn" id="sv-add-row" title="Add row" aria-label="Add row">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <!-- Rows are injected by /js/stock-voucher.js from the template below. -->
                <tbody id="sv-body"></tbody>
            </table>
        </div>

        <!-- ════ Collapsible strip ════ -->
        <div class="q-collapse">
            <button type="button" class="q-collapse-head" data-bs-toggle="collapse" data-bs-target="#sv-narration" aria-expanded="false">
                <span>Narration</span>
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="collapse" id="sv-narration">
                <div class="q-collapse-body">
                    <textarea class="form-control" id="sv-notes" name="notes" rows="3"
                              maxlength="2000" placeholder="Narration for this physical count…"></textarea>
                </div>
            </div>
        </div>

        <!-- ════ Footer — Total Counted Qty + Create Voucher ════ -->
        <div class="inv-foot q-foot">
            <div></div>

            <div class="q-totals">
                <div class="q-total-row grand">
                    <span class="lbl">Total Counted Qty</span><span class="val" id="sv-counted-qty">0</span>
                </div>
            </div>
        </div>

        <%# No footer button bar: the primary action lives in the page
            head now (same id), and two identical primary buttons on one screen
            is a worse answer than one in a predictable place. %>
    </div>

</form>

<!-- ── Line-item row template (cloned by /js/stock-voucher.js) ─────────── -->
<template id="sv-row-tpl">
    <tr class="sv-row">
        <td class="li-prod-cell">
            <input type="text" class="li-product-search sv-item-search" placeholder="Search item…" autocomplete="off">
            <input type="hidden" class="sv-item">
            <div class="li-prod-menu" hidden></div>
        </td>
        <td><input type="text" class="sv-current-qty" readonly tabindex="-1" placeholder="—"></td>
        <td><input type="number" class="sv-qty li-num" min="0" step="1" value="0"></td>
        <td class="center">
            <button type="button" class="sv-del" title="Remove row" aria-label="Remove row">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </td>
    </tr>
</template>

<%# Products for the searchable item picker; `stock` = current qty on hand. %>
<script>
    window.PHYSICAL_STOCK_PRODUCTS = <%- _productsJson %>;
    // Recount: last sheet's lines, for stock-voucher.js to seed the table with.
    window.PHYSICAL_STOCK_RECOUNT = <%- _recountItems.length ? JSON.stringify(_recountItems.map(function (it) {
        return { product_id: it.product_id, product_name: it.product_name || it.product || '',
                 godown: it.godown || '', counted_qty: it.after_qty != null ? it.after_qty : it.quantity };
    })) : 'null' %>;
</script>

<style>
    /* Searchable item picker — same widget/markup as delivery-notes/create.ejs
     * (kept local to this page rather than growing theme.css). */
    .li-prod-cell { position: relative; min-width: 200px; }
    .li-product-search {
        width: 100%; padding: 6px 8px; border: 1px solid var(--border, #d1d5db);
        border-radius: 6px; font-size: 13px; background: #fff;
    }
    .li-product-search:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }
    .li-prod-menu {
        position: fixed; z-index: 1080;
        max-height: 240px; overflow-y: auto; background: #fff;
        border: 1px solid var(--border, #E9EDF3); border-radius: 12px;
        box-shadow: 0 8px 24px rgba(16,24,40,.10); padding: 4px;
    }
    .li-prod-item { padding: 9px 12px; font-size: 13px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 8px; }
    .li-prod-item:hover, .li-prod-item.is-active { background: #EAF1FE; color: #1560E0; }
    .li-prod-empty { padding: 8px 10px; font-size: 12px; color: #9ca3af; }

    .sv-current-qty { background: #f3f4f6; color: #374151; font-weight: 600; }


    .q-voucher { overflow: visible; }
</style>
