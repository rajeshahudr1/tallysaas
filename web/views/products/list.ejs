<%
/* ─────────────────────────────────────────────────────────────
 * views/products/list.ejs — MASTERS · Products listing.
 * Route: GET /products  ·  activeMenu: 'products'.
 *
 * Tally Stock Items. Pure composition of the reusable partials.
 *
 * Expected locals (routes/web.js → res.render):
 *   productRows    [ rows ]   — table body
 *   productsTotal  number     — pagination total (542)
 *   page, perPage  numbers
 *   categoryNames  [ … ]      — Category filter options
 *   gstRates       [ … ]      — GST Rate filter options
 * ─────────────────────────────────────────────────────────── */

var _rows     = (typeof productRows !== 'undefined' && productRows) ? productRows : [];
var _total    = (typeof productsTotal !== 'undefined') ? productsTotal : _rows.length;
var _page     = (typeof page !== 'undefined' && page) ? page : 1;
var _perPage  = (typeof perPage !== 'undefined' && perPage) ? perPage : 10;
var _cats     = (typeof categoryNames !== 'undefined' && categoryNames) ? categoryNames : [];
var _gstRates = (typeof gstRates !== 'undefined' && gstRates) ? gstRates : [];

function _opts(all, list) {
    var out = [{ value: '', label: all }];
    (list || []).forEach(function (v) { out.push({ value: v, label: v }); });
    return out;
}

/* ── FilterCard config (5 fields) ───────────────────────────── */
var filterFields = [
    { type: 'text',   name: 'search',   label: 'Search',   placeholder: 'Search by name, SKU, HSN...', colClass: 'filter-col-fifth' },
    { type: 'select', name: 'category', label: 'Category', options: _opts('All Categories', _cats),    colClass: 'filter-col-fifth' },
    { type: 'select', name: 'gst_rate', label: 'GST Rate', options: _opts('All Rates', _gstRates),     colClass: 'filter-col-fifth' },
    { type: 'select', name: 'stock',    label: 'Stock',    options: _opts('All', ['In Stock', 'Low Stock', 'Out of Stock']), colClass: 'filter-col-fifth' },
    { type: 'select', name: 'status',   label: 'Status',   options: _opts('All Status', ['Active', 'Inactive', 'Blocked']), colClass: 'filter-col-fifth' },
];

/* ── Table config ───────────────────────────────────────────── */
var tableColumns = [
    { key: 'image_url',      label: '',              sortable: false, type: 'thumb', align: 'center' },
    { key: 'name',           label: 'Product Name',  sortable: true, type: 'text' },
    { key: 'category',       label: 'Category',      sortable: true, type: 'text' },
    { key: 'hsn',            label: 'HSN',           sortable: true, type: 'text' },
    { key: 'gst_rate',       label: 'GST',           sortable: true, type: 'badge', align: 'center' },
    { key: 'purchase_price', label: 'Purchase Price', sortable: true, type: 'currency' },
    { key: 'sales_price',    label: 'Sales Price',   sortable: true, type: 'currency' },
    { key: 'stock',          label: 'Stock',         sortable: true, type: 'text', align: 'center' },
    { key: 'status',         label: 'Status',        sortable: true, type: 'status' },
    { key: 'created_at',     label: 'Created At',    sortable: true, type: 'date' },
];

var sortOptions = ['Created At', 'Product Name', 'Category', 'Sales Price', 'Stock', 'Status'];
%>

<%- include('../partials/page-head', {
    title: 'Products',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'Products' },
    ],
    actions: [
        { label: 'Export',      icon: 'fa-upload', variant: 'light', href: '/products/export' },
        { label: 'Add Product', icon: 'fa-plus',   gradient: true, href: '/products/add' },
    ],
}) %>

<form id="product-filters-form" autocomplete="off" method="get" action="/products">
    <%- include('../partials/filter-card', {
        filterId: 'product-filters',
        title: 'Advanced Filters',
        fields: filterFields,
        collapsed: true,
    }) %>
</form>

<div class="card">

    <div class="table-toolbar">
        <label class="toolbar-show mb-0">
            <span>Show</span>
            <select class="form-select form-select-sm" aria-label="Rows per page">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>entries</span>
        </label>

        <!-- Sorting is done by clicking the table column headers. -->
    </div>

    <%- include('../partials/table', {
        tableId: 'products-table',
        basePath: '/products',
        editable: true,
        sortKeys: ['name', 'sku', 'category', 'hsn', 'gst_rate', 'purchase_price', 'sales_price', 'stock', 'status', 'created_at'],
        columns: tableColumns,
        rows: _rows,
        selectable: true,
        showIndex: true,
        actions: ['view', 'edit', 'delete'],
    }) %>

    <%- include('../partials/pagination', {
        page: _page,
        perPage: _perPage,
        total: _total,
    }) %>

</div>

<style>
    .data-table-thumb { width:40px; height:40px; border-radius:8px; object-fit:cover; border:1px solid #e5e7eb; background:#f9fafb; display:inline-block; vertical-align:middle; }
    .data-table-thumb--empty { display:inline-flex; align-items:center; justify-content:center; color:#cbd5e1; }
    .data-table-thumb-btn { border:none; background:none; padding:0; cursor:pointer; line-height:0; border-radius:8px; }
    .data-table-thumb-btn:hover .data-table-thumb { outline:2px solid #6366f1; }
    #imgGalleryModal .ig-main { width:100%; background:#0b0b0c; border-radius:10px; display:flex; align-items:center; justify-content:center; min-height:260px; max-height:60vh; overflow:hidden; }
    #imgGalleryModal .ig-main img { max-width:100%; max-height:60vh; object-fit:contain; display:block; }
    #imgGalleryModal .ig-thumbs { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
    #imgGalleryModal .ig-thumb { width:56px; height:56px; object-fit:cover; border-radius:8px; cursor:pointer; border:2px solid transparent; }
    #imgGalleryModal .ig-thumb.is-active { border-color:#6366f1; }
    @media (min-width: 992px) {
        .filter-grid > .filter-col-fifth { flex: 0 0 auto; width: 20%; }
    }
    @media (min-width: 768px) and (max-width: 991.98px) {
        .filter-grid > .filter-col-fifth { flex: 0 0 auto; width: 33.3333%; }
    }
    @media (min-width: 576px) and (max-width: 767.98px) {
        .filter-grid > .filter-col-fifth { flex: 0 0 auto; width: 50%; }
    }
    @media (max-width: 575.98px) {
        .filter-grid > .filter-col-fifth { flex: 0 0 auto; width: 100%; }
    }
</style>

<!-- Product image gallery lightbox — opened by clicking a list thumbnail -->
<div class="modal fade" id="imgGalleryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imgGalleryTitle">Product Images</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="ig-main"><img id="imgGalleryMain" src="" alt="Product image"></div>
                <div class="ig-thumbs" id="imgGalleryThumbs"></div>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var modalEl = document.getElementById('imgGalleryModal');
    if (!modalEl || !window.bootstrap) return;
    var modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
    var mainImg = document.getElementById('imgGalleryMain');
    var thumbs  = document.getElementById('imgGalleryThumbs');
    var titleEl = document.getElementById('imgGalleryTitle');

    function render(images, title) {
        titleEl.textContent = title || 'Product Images';
        mainImg.src = images[0] || '';
        thumbs.textContent = '';
        images.forEach(function (url, i) {
            var t = document.createElement('img');
            t.src = url;
            t.className = 'ig-thumb' + (i === 0 ? ' is-active' : '');
            t.addEventListener('click', function () {
                mainImg.src = url;
                thumbs.querySelectorAll('.ig-thumb').forEach(function (x) { x.classList.remove('is-active'); });
                t.classList.add('is-active');
            });
            thumbs.appendChild(t);
        });
        thumbs.style.display = images.length > 1 ? 'flex' : 'none';
    }

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-gallery]');
        if (!btn) return;
        e.preventDefault();
        var images = [];
        try { images = JSON.parse(btn.getAttribute('data-gallery-images') || '[]'); } catch (err) { images = []; }
        images = images.filter(Boolean);
        if (!images.length) return;
        render(images, btn.getAttribute('data-gallery-title'));
        modal.show();
    });
})();
</script>
