<%
/* ─────────────────────────────────────────────────────────────
 * views/products/form.ejs — Add / Edit Product (Tally Stock Item).
 * Routes: GET /products/add · GET /products/:id/edit.
 *
 * Every tab maps to a REAL editable column on the `products` table —
 * the old "coming next phase" placeholders are gone. Synced Tally values
 * pre-fill the inputs (SKU is cloud-only — Tally stock items have none).
 *
 * Expected locals (routes/web.js → res.render):
 *   categoryOptions [{id,name}] · units [..] · gstRates [..]
 *   record — the row being edited (edit mode)  — optional
 * ─────────────────────────────────────────────────────────── */

var _rec    = (typeof record !== 'undefined' && record) ? record : null;
var _isEdit = !!_rec;
function _v(k){ return (_rec && _rec[k] != null) ? _rec[k] : ''; }

var _catOptions = (typeof categoryOptions !== 'undefined' && categoryOptions) ? categoryOptions : [];
var _units    = (typeof units !== 'undefined' && units) ? units : [];
var _gstRates = (typeof gstRates !== 'undefined' && gstRates) ? gstRates : [];

var formTabs = [
    { id: 'basic',   label: 'Basic Information', icon: 'fa-id-card',          active: true },
    { id: 'pricing', label: 'Pricing & Tax',     icon: 'fa-percent'                        },
    { id: 'stock',   label: 'Stock & Inventory', icon: 'fa-warehouse'                      },
    { id: 'custom',  label: 'Custom Fields',      icon: 'fa-table-cells'                    },
];

function _selOpts(placeholder, list, current) {
    var hasCur = (current !== '' && current != null);
    var cur = String(current).replace('%', '').trim();
    var html = '<option value=""' + (hasCur ? '' : ' selected') + ' disabled hidden>' + placeholder + '</option>';
    (list || []).forEach(function (v) {
        var sel = (hasCur && cur === String(v).replace('%', '').trim()) ? ' selected' : '';
        html += '<option value="' + v + '"' + sel + '>' + v + '</option>';
    });
    return html;
}
function _fkOpts(placeholder, list, current) {
    var hasCur = (current !== '' && current != null);
    var html = '<option value=""' + (hasCur ? '' : ' selected') + ' disabled hidden>' + placeholder + '</option>';
    (list || []).forEach(function (o) {
        var sel = (hasCur && String(current) === String(o.id)) ? ' selected' : '';
        html += '<option value="' + o.id + '"' + sel + '>' + o.name + '</option>';
    });
    return html;
}

/* Custom Fields bag → key/value rows. */
var _cf = {};
try { var _raw = _rec ? _rec.custom_fields : null; _cf = (typeof _raw === 'string') ? JSON.parse(_raw || '{}') : (_raw || {}); } catch (e) { _cf = {}; }

var headActions =
    '<a class="btn btn-light" href="/products">' +
        '<i class="fa-solid fa-arrow-left me-1"></i>Back to Products' +
    '</a>' +
    '<button type="submit" form="product-form" class="btn btn-primary">' +
        '<i class="fa-solid fa-floppy-disk me-1"></i>' + (_isEdit ? 'Update' : 'Save') + ' Product' +
    '</button>';
%>

<%- include('../partials/page-head', {
    title: (_isEdit ? 'Edit' : 'Add') + ' Product',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'Products', href: '/products' },
        { label: (_isEdit ? 'Edit' : 'Add') + ' Product' },
    ],
    actions: headActions,
}) %>

<form id="product-form" class="card form-card" method="post" action="<%= _isEdit ? '/products/' + _rec.id : '/products' %>" autocomplete="off" novalidate>

    <%- include('../partials/form-card', { tabs: formTabs }) %>

    <div class="tab-content form-card-body">

        <!-- ════ Basic Information ════ -->
        <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="prd-name">Product Name<span class="req">*</span></label>
                    <input type="text" class="form-control" id="prd-name" name="name"
                           value="<%= _v('name') %>" placeholder="Enter product name" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-sku">SKU / Item Code</label>
                    <input type="text" class="form-control text-uppercase" id="prd-sku" name="sku"
                           value="<%= _v('sku') %>" placeholder="e.g. SKU-STL-012">
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-category">Category</label>
                    <select class="form-select" id="prd-category" name="category_id">
                        <%- _fkOpts('Select category', _catOptions, _v('category_id')) %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-unit">Unit</label>
                    <select class="form-select" id="prd-unit" name="unit">
                        <%- _selOpts('Select unit', _units, _v('unit')) %>
                    </select>
                </div>
            </div>

            <hr class="form-divider">

            <div class="row g-4 align-items-start">
                <div class="col-12 col-md-7">
                    <label class="form-label d-block">Status<span class="req">*</span></label>
                    <div class="status-radios">
                        <label class="status-radio is-active">
                            <input type="radio" name="status" value="Active" <%= _isEdit ? (String(_v('status')) === 'Active' ? 'checked' : '') : 'checked' %>>
                            <span>Active</span>
                        </label>
                        <label class="status-radio is-inactive">
                            <input type="radio" name="status" value="Inactive" <%= String(_v('status')) === 'Inactive' ? 'checked' : '' %>>
                            <span>Inactive</span>
                        </label>
                        <label class="status-radio is-blocked">
                            <input type="radio" name="status" value="Blocked" <%= String(_v('status')) === 'Blocked' ? 'checked' : '' %>>
                            <span>Blocked</span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label d-block">Is Tally Stock Item</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="prd-tally-item" name="is_tally_item" <%= _isEdit ? (_v('is_tally_item') ? 'checked' : '') : 'checked' %>>
                        <label class="form-check-label" for="prd-tally-item">Create as stock item</label>
                    </div>
                    <div class="form-hint">Syncs this product to Tally as a stock item.</div>
                </div>
            </div>

            <hr class="form-divider">

            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label" for="prd-desc">Product Description</label>
                    <textarea class="form-control" id="prd-desc" name="description"
                              rows="3" maxlength="5000" placeholder="Specifications, grade, brand, packaging…"><%= _v('description') %></textarea>
                </div>
            </div>
        </div><!-- /#basic -->

        <!-- ════ Pricing & Tax ════ -->
        <div class="tab-pane fade" id="pricing" role="tabpanel" aria-labelledby="pricing-tab">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="prd-hsn">HSN / SAC Code</label>
                    <input type="text" class="form-control" id="prd-hsn" name="hsn_code"
                           value="<%= _v('hsn_code') %>" placeholder="e.g. 7214" maxlength="20">
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-gst">GST Rate</label>
                    <select class="form-select" id="prd-gst" name="gst_rate">
                        <%- _selOpts('Select GST rate', _gstRates, _v('gst_rate')) %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-purchase">Purchase Price</label>
                    <div class="input-affix">
                        <input type="number" class="form-control has-suffix" id="prd-purchase" name="purchase_price"
                               value="<%= _v('purchase_price') %>" placeholder="0.00" min="0" step="0.01">
                        <span class="affix affix--suffix">₹</span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="prd-sales">Sales Price</label>
                    <div class="input-affix">
                        <input type="number" class="form-control has-suffix" id="prd-sales" name="sales_price"
                               value="<%= _v('sales_price') %>" placeholder="0.00" min="0" step="0.01">
                        <span class="affix affix--suffix">₹</span>
                    </div>
                </div>
            </div>
        </div><!-- /#pricing -->

        <!-- ════ Stock & Inventory ════ -->
        <div class="tab-pane fade" id="stock" role="tabpanel" aria-labelledby="stock-tab">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label" for="prd-opening-stock">Opening Stock</label>
                    <input type="number" class="form-control" id="prd-opening-stock" name="opening_stock"
                           value="<%= _v('opening_stock') %>" placeholder="0" min="0" step="1">
                    <div class="form-hint">Closing balance synced from Tally.</div>
                </div>
            </div>
        </div><!-- /#stock -->

        <!-- ════ Custom Fields (dynamic key/value editor) ════ -->
        <div class="tab-pane fade" id="custom" role="tabpanel" aria-labelledby="custom-tab">
            <%- include('../partials/custom-fields', { cf: _cf, noun: 'product' }) %>
        </div><!-- /#custom -->

    </div><!-- /.tab-content -->

    <div class="form-card-footer">
        <a class="btn btn-light" href="/products">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk me-1"></i><%= _isEdit ? 'Update' : 'Save' %> Product
        </button>
    </div>

</form>

<% if (_isEdit) { %>
<% var _imgs = (_rec && Array.isArray(_rec.images)) ? _rec.images : []; %>
<div class="card form-card product-images-card">
    <div class="pi-head">
        <div>
            <h2 class="pi-title"><i class="fa-solid fa-images me-2"></i>Product Images</h2>
            <p class="pi-sub">Up to 8 photos · JPG, PNG, WEBP or GIF · max 5MB each. Stored in your cloud — not synced to Tally.</p>
        </div>
        <span class="pi-count"><%= _imgs.length %> image<%= _imgs.length === 1 ? '' : 's' %></span>
    </div>

    <form class="pi-upload" method="post" action="/products/<%= _rec.id %>/images" enctype="multipart/form-data">
        <label class="pi-drop" for="pi-file">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span class="pi-drop-main">Choose images to upload</span>
            <span class="pi-drop-sub" id="pi-chosen">No files selected</span>
            <input type="file" id="pi-file" name="images" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden>
        </label>
        <button type="submit" class="btn btn-primary pi-upload-btn" id="pi-upload-btn" disabled>
            <i class="fa-solid fa-upload me-1"></i>Upload
        </button>
    </form>

    <% if (_imgs.length) { %>
    <div class="pi-gallery">
        <% _imgs.forEach(function (img) { %>
        <figure class="pi-item">
            <a href="<%= img.url %>" target="_blank" rel="noopener"><img src="<%= img.url %>" alt="Product image" loading="lazy"></a>
            <button type="button" class="pi-del-btn" title="Remove image"
                    data-row-delete data-delete-url="/products/<%= _rec.id %>/images/<%= img.id %>"
                    data-delete-label="this image">
                <i class="fa-solid fa-trash"></i>
            </button>
        </figure>
        <% }); %>
    </div>
    <% } else { %>
    <div class="pi-empty"><i class="fa-regular fa-image me-1"></i> No images yet — upload the first one above.</div>
    <% } %>
</div>

<style>
.product-images-card { padding: 24px; margin-top: 20px; }
.pi-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:18px; }
.pi-title { font-size:1.05rem; font-weight:600; margin:0 0 4px; }
.pi-sub { font-size:.82rem; color:#6b7280; margin:0; }
.pi-count { background:#eef2ff; color:#4338ca; font-size:.78rem; font-weight:600; padding:4px 12px; border-radius:999px; white-space:nowrap; }
.pi-upload { display:flex; gap:12px; align-items:stretch; margin-bottom:20px; flex-wrap:wrap; }
.pi-drop { flex:1; min-width:240px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; padding:22px; border:2px dashed #cbd5e1; border-radius:12px; cursor:pointer; text-align:center; transition:border-color .15s, background .15s; }
.pi-drop:hover { border-color:#6366f1; background:#f8faff; }
.pi-drop i { font-size:1.6rem; color:#6366f1; }
.pi-drop-main { font-weight:600; font-size:.9rem; }
.pi-drop-sub { font-size:.78rem; color:#6b7280; }
.pi-upload-btn { align-self:center; }
.pi-gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:14px; }
.pi-item { position:relative; margin:0; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden; aspect-ratio:1/1; background:#f9fafb; }
.pi-item img { width:100%; height:100%; object-fit:cover; display:block; }
.pi-del-btn { position:absolute; top:6px; right:6px; border:none; background:rgba(220,38,38,.92); color:#fff; width:30px; height:30px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.8rem; box-shadow:0 1px 4px rgba(0,0,0,.25); z-index:2; }
.pi-del-btn:hover { background:#b91c1c; }
.pi-empty { padding:26px; text-align:center; color:#6b7280; font-size:.88rem; border:1px dashed #e5e7eb; border-radius:12px; }
</style>
<script>
(function () {
    var f = document.getElementById('pi-file');
    if (!f) return;
    var chosen = document.getElementById('pi-chosen');
    var btn = document.getElementById('pi-upload-btn');
    f.addEventListener('change', function () {
        var n = f.files ? f.files.length : 0;
        chosen.textContent = n ? (n + ' file' + (n === 1 ? '' : 's') + ' selected') : 'No files selected';
        btn.disabled = n === 0;
    });
})();
</script>
<% } %>
