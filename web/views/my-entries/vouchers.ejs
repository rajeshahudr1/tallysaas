<%
/* ─────────────────────────────────────────────────────────────
 * views/my-entries/vouchers.ejs — My Entries · My Vouchers.
 * Route: GET /my/vouchers. activeMenu: 'my-vouchers'.
 *
 * A read-only roll-up of every voucher family the current user created
 * (api/Controllers/Tenant/MyEntriesController.js — GET /my/vouchers, a
 * UNION ALL across VOUCHER_SOURCES). No action buttons — this is a "see
 * what I made" screen, not a "manage" screen; row click opens that
 * voucher's real screen (routes/web.js decides the href from `kind`).
 *
 * Expected locals (routes/web.js → res.render):
 *   voucherRows    [ { kind, label, date, voucher_no, party, amount, status, href } ]
 *   vouchersTotal  number
 *   page, perPage  numbers
 * ─────────────────────────────────────────────────────────── */

var _rows    = (typeof voucherRows !== 'undefined' && voucherRows) ? voucherRows : [];
var _total   = (typeof vouchersTotal !== 'undefined') ? vouchersTotal : _rows.length;
var _page    = (typeof page !== 'undefined' && page) ? page : 1;
var _perPage = (typeof perPage !== 'undefined' && perPage) ? perPage : 20;

/* ── FilterCard config ──────────────────────────────────────── */
var filterFields = [
    { type: 'text', name: 'search', label: 'Search', placeholder: 'Voucher no / party...', colClass: 'filter-col-fifth' },
];

var KIND_PILL_CLASS = {
    quotation:        'pill-status--info',
    sales_order:      'pill-status--info',
    purchase_order:   'pill-status--warning',
    delivery_note:    'pill-status--info',
    receipt_note:     'pill-status--warning',
    sales_invoice:    'pill-status--success',
    purchase_invoice: 'pill-status--warning',
    receipt_voucher:  'pill-status--success',
    payment_voucher:  'pill-status--warning',
    journal:          'pill-status--muted',
};
function _kindPillClass(k) {
    return KIND_PILL_CLASS[k] || 'pill-status--muted';
}
function _inr(v) {
    var n = Number(v || 0);
    return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
%>

<%- include('../partials/page-head', {
    title: 'My Vouchers',
    infoKey: 'my-vouchers',
    breadcrumb: [
        { label: 'Dashboard', href: '/' },
        { label: 'My Vouchers' },
    ],
}) %>

<%# ── Status tabs + voucher-type filter. Each family words its own status
     differently (pending_tally / draft_cloud / open …), so these work on the
     api's collapsed pending / completed / failed. ── %>
<% var _stateTabs = (typeof stateTabs !== 'undefined' && stateTabs) ? stateTabs : [];
   var _kindOptions = (typeof kindOptions !== 'undefined' && kindOptions) ? kindOptions : []; %>
<div class="mye-bar">
    <div class="mye-tabs">
        <% _stateTabs.forEach(function (t) { %>
            <a href="<%= t.href %>" class="mye-tab <%= t.active ? 'is-active' : '' %>"><%= t.label %></a>
        <% }); %>
    </div>
    <% if (_kindOptions.length > 1) { %>
    <form method="get" action="/my/vouchers">
        <% _stateTabs.forEach(function (t) { if (t.active && t.k) { %>
            <input type="hidden" name="state" value="<%= t.k %>">
        <% } }); %>
        <select name="kind" class="mye-select" aria-label="Voucher type" onchange="this.form.submit()">
            <% _kindOptions.forEach(function (o) { %>
                <option value="<%= o.value %>" <%= o.selected ? 'selected' : '' %>><%= o.label %></option>
            <% }); %>
        </select>
    </form>
    <% } %>
</div>
<style>
    .mye-bar { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:14px; }
    .mye-tabs { display:inline-flex; gap:8px; flex-wrap:wrap; }
    .mye-tab { padding:7px 15px; border-radius:8px; border:1px solid #e2e8f0; background:#fff;
        color:#475569; font-size:12.5px; font-weight:600; text-decoration:none; }
    .mye-tab:hover { border-color:#cbd5e1; color:var(--primary); }
    .mye-tab.is-active { background:var(--primary); border-color:var(--primary); color:#fff; }
    .mye-select { padding:7px 10px; border:1px solid #e2e8f0; border-radius:8px; background:#fff; font-size:12.5px; color:#334155; }
</style>

<form id="my-vouchers-filters-form" autocomplete="off" method="get" action="/my/vouchers">
    <%- include('../partials/filter-card', {
        filterId: 'my-vouchers-filters',
        title: 'Advanced Filters',
        fields: filterFields,
        collapsed: true,
    }) %>
</form>

<div class="card">

    <div class="table-toolbar">
        <label class="toolbar-show mb-0">
            <span>Show</span>
            <select class="form-select form-select-sm" aria-label="Rows per page">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span>entries</span>
        </label>
    </div>

    <div class="table-responsive data-table-wrap">
        <table class="table data-table align-middle mb-0" id="my-vouchers-table">
            <thead>
                <tr>
                    <th class="data-table-idx">#</th>
                    <th>Type</th>
                    <th>Date</th>
                    <%# When the entry last changed — the column that tells you
                        whether a stuck voucher has moved at all. %>
                    <th>Modified Date</th>
                    <th>Voucher No</th>
                    <th>Party</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (!_rows.length) { %>
                    <tr>
                        <td class="data-table-empty text-center text-muted py-5" colspan="8">
                            <i class="fa-regular fa-folder-open d-block mb-2 fs-3"></i>
                            You haven't created any vouchers yet.
                        </td>
                    </tr>
                <% } %>
                <% _rows.forEach(function (r, i) { %>
                    <tr class="my-voucher-row" data-href="<%= r.href %>" style="cursor:pointer">
                        <td class="data-table-idx text-muted"><%= i + 1 %></td>
                        <td><a class="pill-status <%= _kindPillClass(r.kind) %>" href="<%= r.href %>"><%= r.label %></a></td>
                        <td><%= r.date %></td>
                        <td class="text-muted"><%= r.modified_at %></td>
                        <td><a href="<%= r.href %>"><%= r.voucher_no %></a></td>
                        <td><%= r.party %></td>
                        <td class="text-end"><span class="data-table-money"><%= _inr(r.amount) %></span></td>
                        <td><span class="pill-status pill-status--muted"><%= r.status %></span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <%- include('../partials/pagination', {
        page: _page,
        perPage: _perPage,
        total: _total,
    }) %>

</div>

<script>
document.querySelectorAll('#my-vouchers-table tbody tr.my-voucher-row').forEach(function (tr) {
    tr.addEventListener('click', function (e) {
        if (e.target.closest('a')) return; // let the inner links navigate normally
        var href = tr.getAttribute('data-href');
        if (href && href !== '#') window.location.href = href;
    });
});
</script>
