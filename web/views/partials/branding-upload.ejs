<%
/* ─────────────────────────────────────────────────────────────
 * partials/branding-upload.ejs — one company image (logo / signature).
 *
 * NO <form> ANYWHERE IN HERE, and that is the whole design. This partial is
 * included from INSIDE the Settings page's own <form>, and a nested form is not
 * merely ignored by the HTML parser — its </form> is what CLOSES THE OUTER ONE.
 * Everything after this include therefore fell outside the settings form,
 * including the Save Settings button at the bottom of the page. A submit button
 * with no form does nothing at all: no request, no error, no reload. Settings
 * could not be saved and the page gave no clue why.
 *
 * So the upload posts with fetch + FormData (multipart, which the settings
 * form's urlencoded post could not carry anyway) and reloads on success, which
 * shows the server's flash exactly as the old form post did.
 *
 * Locals:
 *   kind  'logo' | 'signature'
 *   url   absolute URL of the current image, or null
 *   hint  one line explaining where it gets printed
 * ─────────────────────────────────────────────────────────── */
var _kind = kind;
var _url  = (typeof url !== 'undefined' && url) ? url : null;
var _hint = (typeof hint !== 'undefined' && hint) ? hint : '';
%>

<div class="brand-up">
    <% if (_url) { %>
        <div class="brand-up-preview">
            <img src="<%= _url %>" alt="Current <%= _kind %>">
        </div>
    <% } %>

    <div class="brand-up-form">
        <input type="file" class="form-control form-control-sm" accept="image/*"
               data-brand-file="<%= _kind %>">
        <button type="button" class="brand-up-btn" data-brand-upload="<%= _kind %>">
            <%= _url ? 'Replace' : 'Upload' %>
        </button>
    </div>

    <% if (_url) { %>
        <%# Removing is destructive and one click away from Replace, so it
            confirms rather than trusting the aim. %>
        <button type="button" class="brand-up-link" data-brand-remove="<%= _kind %>">Remove</button>
    <% } %>

    <div class="form-hint"><%= _hint %> Max 5 MB.</div>
</div>

<style>
    .brand-up { display:flex; flex-direction:column; gap:8px; align-items:flex-start; }
    .brand-up-preview { padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; background:#fff; }
    .brand-up-preview img { max-height:52px; max-width:190px; display:block; }
    .brand-up-form { display:flex; gap:8px; align-items:center; width:100%; }
    .brand-up-btn { padding:7px 14px; border:none; border-radius:8px; font-size:.82rem; cursor:pointer;
                    color:#fff; white-space:nowrap;
                    background:linear-gradient(90deg, var(--brand-a, #2563eb), var(--brand-b, #16a34a)); }
    .brand-up-link { border:none; background:none; padding:0; font-size:.8rem; color:#dc2626; cursor:pointer; }
    .brand-up-link:hover { text-decoration:underline; }
</style>

<script>
/* Delegated on document, and wired ONCE: this partial is included more than
   once per page (logo + signature), so a per-include listener would fire twice
   and upload twice. */
(function () {
    if (window.__brandUpWired) return;
    window.__brandUpWired = true;

    function post(url, body, btn, label) {
        btn.disabled = true;
        btn.textContent = label;
        fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
            // Both routes redirect to /settings with a flash; reloading shows it
            // exactly as the old form post did.
            .then(function () { window.location.href = '/settings#branding'; })
            .catch(function () {
                btn.disabled = false;
                btn.textContent = 'Try again';
            });
    }

    document.addEventListener('click', function (ev) {
        var up = ev.target.closest('[data-brand-upload]');
        if (up) {
            var kind = up.getAttribute('data-brand-upload');
            var input = document.querySelector('[data-brand-file="' + kind + '"]');
            if (!input || !input.files || !input.files.length) {
                alert('Choose an image first.');
                return;
            }
            var fd = new FormData();
            fd.append('image', input.files[0]);      // the field name the route reads
            post('/settings/branding/' + kind, fd, up, 'Uploading...');
            return;
        }

        var rm = ev.target.closest('[data-brand-remove]');
        if (rm) {
            var k = rm.getAttribute('data-brand-remove');
            if (!confirm('Remove the current ' + k + '?')) return;
            post('/settings/branding/' + k + '/remove', new FormData(), rm, 'Removing...');
        }
    });
})();
</script>
