<%
/* ─────────────────────────────────────────────────────────────
 * partials/page-head.ejs — helper: page title + breadcrumb + actions
 * (spec §2 helper). Used by all 3 pages.
 *
 * Expected locals:
 *   title      string
 *   breadcrumb [{ label, href? }]
 *   actions?   EITHER a raw HTML string OR an array of
 *              { label, icon?, variant?, id?, href?, gradient?:bool, caret?:bool }
 *              variant maps to a Bootstrap btn-* (default 'light').
 *              gradient:true → the blue→purple gradient primary button.
 * ─────────────────────────────────────────────────────────── */
var _title      = (typeof title !== 'undefined' && title) ? title : '';
var _breadcrumb = (typeof breadcrumb !== 'undefined' && breadcrumb) ? breadcrumb : [];
var _actions    = (typeof actions !== 'undefined') ? actions : null;
// Optional one-line explanation under the title. Pages that don't pass one
// simply render the title alone, exactly as before.
var _subtitle   = (typeof subtitle !== 'undefined' && subtitle) ? subtitle : '';

/* RBAC: hide an "Add"/create button the role can't perform. A button is a
 * create action when its href ends in /add|/create|/new, its label starts with
 * "Add", or it carries requires:'<module>.create'. canPath() (index.js) resolves
 * the href → module → canDo. Non-create buttons (Export, custom) are untouched.
 * An action may set requires:false to opt out entirely. */
var _canPath3 = (typeof canPath === 'function') ? canPath : function () { return true; };
function _actionAllowed(a) {
    if (!a || typeof a !== 'object') return true;
    if (a.requires === false) return true;
    if (typeof a.requires === 'string' && a.requires.indexOf('.') > -1) {
        if (typeof canDo === 'function') {
            var rp = a.requires.split('.'); return canDo(rp[0], rp[1]);
        }
        return true;
    }
    var href  = a.href || '';
    var label = String(a.label || '');
    var isCreate = /\/(add|create|new)\/?$/.test(href) || /^add\b/i.test(label);
    if (isCreate && href) return _canPath3(href, 'create');
    return true;
}
if (Array.isArray(_actions)) _actions = _actions.filter(_actionAllowed);

function _btnClass(a) {
    if (a.gradient) return 'btn btn-gradient';
    return 'btn btn-' + (a.variant || 'light');
}
/* Optional ⓘ "how this module works" popup. Pass infoKey:'recurring' (etc.) to
 * the include; the blurb comes from res.locals.moduleInfo (config/moduleInfo.js). */
var _infoKey = (typeof infoKey !== 'undefined' && infoKey) ? String(infoKey) : '';
var _infoAll = (typeof moduleInfo !== 'undefined' && moduleInfo) ? moduleInfo : {};
var _info    = (_infoKey && _infoAll[_infoKey]) ? _infoAll[_infoKey] : null;
var _infoId  = 'modinfo-' + _infoKey.replace(/[^a-z0-9]/gi, '');
%>
<div class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">
            <%= _title %>
            <% if (_info) { %>
                <button type="button" class="modinfo-btn" data-bs-toggle="modal" data-bs-target="#<%= _infoId %>"
                        title="How this works" aria-label="How this works">
                    <i class="fa-solid fa-circle-info"></i>
                </button>
            <% } %>
        </h1>
        <% if (_subtitle) { %><p class="page-subtitle"><%= _subtitle %></p><% } %>
        <% if (_breadcrumb.length) { %>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb page-breadcrumb mb-0">
                    <% _breadcrumb.forEach(function (crumb, i) { %>
                        <li class="breadcrumb-item <%= i === _breadcrumb.length - 1 ? 'active' : '' %>"
                            <%= i === _breadcrumb.length - 1 ? 'aria-current="page"' : '' %>>
                            <% if (crumb.href && i !== _breadcrumb.length - 1) { %>
                                <a href="<%= crumb.href %>"><%= crumb.label %></a>
                            <% } else { %>
                                <%= crumb.label %>
                            <% } %>
                        </li>
                    <% }); %>
                </ol>
            </nav>
        <% } %>
    </div>

    <% if (_actions) { %>
        <div class="page-head-actions">
            <% if (typeof _actions === 'string') { %>
                <%- _actions %>
            <% } else if (Array.isArray(_actions)) { %>
                <% _actions.forEach(function (a) { %>
                    <% if (a.href) { %>
                        <a class="<%= _btnClass(a) %>" href="<%= a.href %>" <%- a.id ? ('id="' + a.id + '"') : '' %>>
                            <% if (a.icon) { %><i class="fa-solid <%= a.icon %> me-1"></i><% } %><%= a.label %>
                        </a>
                    <% } else { %>
                        <button class="<%= _btnClass(a) %>" type="button" <%- a.id ? ('id="' + a.id + '"') : '' %>
                                <%= (a.export || a.label === 'Export') ? 'data-export' : '' %>>
                            <% if (a.icon) { %><i class="fa-solid <%= a.icon %> me-1"></i><% } %><%= a.label %>
                            <% if (a.caret) { %><i class="fa-solid fa-chevron-down ms-2 page-head-caret"></i><% } %>
                        </button>
                    <% } %>
                <% }); %>
            <% } %>
        </div>
    <% } %>
</div>

<% if (_info) { %>
<!-- ⓘ "How this module works" modal -->
<div class="modal fade" id="<%= _infoId %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-circle-info me-2 text-primary"></i><%= _info.title %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="modinfo-intro"><%= _info.intro %></p>
                <ul class="modinfo-list">
                    <% (_info.points || []).forEach(function (p) { %>
                        <li><i class="fa-solid fa-check"></i><span><%= p %></span></li>
                    <% }); %>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>
<style>
    .modinfo-btn { border:0; background:transparent; color:#9ca3af; cursor:pointer; padding:0 0 0 8px; font-size:.7em; vertical-align:middle; line-height:1; }
    .modinfo-btn:hover { color:var(--primary); }
    .modinfo-intro { font-size:14px; color:#374151; margin-bottom:14px; }
    .modinfo-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
    .modinfo-list li { display:flex; gap:10px; font-size:13.5px; color:#334155; line-height:1.5; }
    .modinfo-list li i { color:#16a34a; margin-top:3px; flex:0 0 auto; }
</style>
<% } %>
