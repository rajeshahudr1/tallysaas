# ─────────────────────────────────────────────────────────────
# Tally Cloud Sync — .gitignore
# Keep secrets + heavy/generated artifacts OUT of the repo.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/

# Secrets / environment — NEVER commit (templates *.example are kept)
.env
**/.env
*.env
!**/*.env.example
!.env.example

# Agent runtime config (holds agent_token + machine fingerprint) + logs
agent/config.ini
**/logs/
*.log
# Agent single-instance runtime lock
**/tally_cloud_sync.lock

# Published/uploaded agent release binaries (runtime artifacts served to agents)
# Keep the folder (.gitkeep) but never commit the uploaded exe files.
api/agent-releases/*
!api/agent-releases/.gitkeep

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# PyInstaller build output
agent/build/
agent/dist/
*.spec

# Sessions / uploads / runtime
**/uploads/
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
api/db/scripts/reset_keep_superadmin.sql
# Generated screenshots + the scripts that capture/build them
api/scripts/shoot-web.js
api/scripts/seed-waytoweb-demo.js

# ── Browser-automation capture artifacts (Playwright MCP session dumps) ──
# 85 throwaway page snapshots + console logs from the Livekeeping capture.
# The findings live in doc/livekeeping/ — these raw dumps are noise.
.playwright-mcp/

# ── Documentation folders (reference material, kept local only) ──
doc/
docs/

# ── Server-tier tests (kept local only) ──
# api/ and web/ are the two folders uploaded to the live server. Their tests
# are dev-only, so they stay out of the repo to keep the upload clean.
# Run them locally with: cd api && npm test   |   cd web && npm test
# (app/test and agent/tests are still tracked — those folders never ship.)
api/tests/
web/tests/
/web/data
