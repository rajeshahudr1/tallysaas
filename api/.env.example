APP_ENV=development
PORT=4500
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tallysaas
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=change-me-to-a-48-char-random-base64url-string-aaaaaaaa
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*
WEB_ORIGIN=http://localhost:4600

# Agent auto-update (Requirement 1). AGENT_RELEASE_DIR is the folder that holds
# the published the agent exe files (default api/agent-releases/). A
# super-admin drops the freshly-built exe there, then publishes its version via
# POST /super-admin/agent-release. AGENT_LATEST_VERSION is only a fallback for
# GET /agent/version when nothing is published in the DB yet.
AGENT_RELEASE_DIR=
AGENT_LATEST_VERSION=

# License-key encryption (super-admin reveal/regenerate). AES-256-GCM key is
# derived as sha256(LICENSE_KEY_SECRET); the full license key is stored
# reversibly-encrypted (licenses.license_key_enc) so a super-admin can VIEW it.
# Use a FRESH 64-hex (32-byte) random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and stable — changing it makes previously-stored keys
# unrevealable (the detail page falls back to Regenerate). NEVER commit .env.
LICENSE_KEY_SECRET=replace-with-64-hex-secret

# Toggleable agent diagnostics — logs what each agent sent + what the cloud did with it.
AGENT_DEBUG=0

# ── Email (payment reminders · accountant invites · password resets) ──────────
# When MAIL_HOST is blank, emails are LOGGED to the console (dev) instead of sent.
# Port 465 = implicit TLS; anything else = STARTTLS.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Tally Cloud Sync

# ── WhatsApp Cloud API (Meta) — payment reminders ─────────────────────────────
# When WHATSAPP_TOKEN is blank, messages are LOGGED to the console (dev).
# Get these from Meta: a permanent access token + the sender phone-number id.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# Public web URL — used inside emails (e.g. the accountant-invite "Sign in" link).
WEB_URL=http://localhost:4600

# ── e-Invoice / e-Way Bill (GST IRN) — optional GSP ───────────────────────────
# When set, the app POSTs the IRP payload here to auto-mint IRNs (adjust the
# response field-mapping in Helpers/einvoice.js `callGsp` for your provider —
# ClearTax / Masters India / GSTZen / NIC IRP). Blank → e-invoices are recorded
# MANUALLY (paste IRN/QR/e-Way from the GST portal).
EINVOICE_GSP_URL=
EINVOICE_GSP_KEY=
