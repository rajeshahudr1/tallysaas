{
  "id": "2026-08-04.1",
  "notes": "Server-published Tally request envelopes. Adding a report here ships it to every agent on the next cycle - no new exe. NAMING: a report MUST be published as \"report:<slug>\" - that is the key the agent looks up (TallyConnector.envelope_key). A slug the agent already parses (balance_sheet, profit_loss, trial_balance, sales_register, purchase_register, stock_summary, group_summary) OVERRIDES that report's XML; any other slug is run by extra_reports() and its RAW XML is stored under that name for the cloud to parse. READ-ONLY ONLY: anything that could import, alter, cancel or delete is refused at publish time AND again in the agent (see Helpers/envelopeSigning.js and agent/envelope_store.py).",
  "envelopes": {
    "license_info": {
      "label": "Tally licence + version",
      "xml": "<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Collection</TYPE><ID>LicenseInfo</ID></HEADER><BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT><SVCURRENTCOMPANY/></STATICVARIABLES><TDL><TDLMESSAGE><OBJECT NAME='LicenseInfo'><LOCALFORMULA>SerialNumber: $$LicenseInfo:SerialNumber</LOCALFORMULA><LOCALFORMULA>IsEducationalMode:$$LicenseInfo:IsEducationalMode</LOCALFORMULA><LOCALFORMULA>TALLYVERSION:$$String:@@VersionReleaseString</LOCALFORMULA></OBJECT><COLLECTION NAME='LicenseInfo'><OBJECTS>LicenseInfo</OBJECTS></COLLECTION></TDLMESSAGE></TDL></DESC></BODY></ENVELOPE>"
    },
    "report:group_summary": {
      "label": "Group Summary",
      "period": true,
      "xml": "<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Data</TYPE><ID>Group Summary</ID></HEADER><BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES></DESC></BODY></ENVELOPE>"
    },
    "report:cash_flow": {
      "label": "Cash Flow",
      "period": true,
      "xml": "<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Data</TYPE><ID>Cash Flow</ID></HEADER><BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES></DESC></BODY></ENVELOPE>"
    },
    "report:ratio_analysis": {
      "label": "Ratio Analysis",
      "period": true,
      "xml": "<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Data</TYPE><ID>Ratio Analysis</ID></HEADER><BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES></DESC></BODY></ENVELOPE>"
    },
    "report:godown_summary": {
      "label": "Godown Summary",
      "period": true,
      "xml": "<ENVELOPE><HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Data</TYPE><ID>Godown Summary</ID></HEADER><BODY><DESC><STATICVARIABLES><SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT></STATICVARIABLES></DESC></BODY></ENVELOPE>"
    }
  }
}
